---
import Icon from './Icon.astro';
import { TEASER, SOURCES } from '../data/automation.ts';

/**
 * The homepage automation teaser.
 *
 * The first version of this was a full section — three question rows, a
 * platform panel and a boundary list, about 935px tall on desktop, repeating
 * material the dedicated page already carried. The visual audit's instruction
 * was to replace it with a 70–100 word visual bridge.
 *
 * So this is one heading, one explanation, a compact source graphic, one sample
 * question with its finding, a link, and a single qualification. The detailed
 * platform limits and the three switchable examples live on /automation, where
 * someone who wants them has gone looking.
 *
 * Copy lives in src/data/automation.ts alongside the page's, so the teaser and
 * the thing it teases cannot drift into disagreeing about what the service is.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="automation" class="section" data-section="automation" data-added="audit">
  <div class="wrap">
    <div class="tease">
      <div class="tease__copy">
        <p class="eyebrow eyebrow--amber">Automation</p>
        <h2 class="tease__h2">{TEASER.heading}</h2>
        <p class="tease__body">{TEASER.body}</p>

        <a href={`${base}/automation`} class="tease__link">
          {TEASER.link}
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="tease__demo">
        <ul class="tease__sources" aria-label="Connected sources">
          {
            SOURCES.map((s) => (
              <li class="tsrc">
                <span class="tsrc__dot" aria-hidden="true"></span>
                {s.name}
              </li>
            ))
          }
        </ul>

        <p class="tease__q">{TEASER.question}</p>
        <p class="tease__finding">{TEASER.finding}</p>

        <p class="tease__foot">
          <span class="tease__sample">Sample</span>
          <span>{TEASER.limit}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .tease {
    display: grid;
    gap: var(--s12);
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  @media (min-width: 900px) {
    .tease {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: var(--s16);
    }
  }

  /* Left-aligned, against a page of centred section heads. This section and the
     calculator are the two that carry a different treatment on purpose. */
  .tease__copy {
    max-width: 46ch;
  }

  .tease__h2 {
    margin-top: var(--s4);
    font-size: var(--t-h2-card);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2-card);
    color: var(--color-text);
    text-wrap: balance;
  }

  .tease__body {
    margin-top: var(--s8);
    font-size: var(--t-section-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .tease__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    margin-top: var(--s8);
    min-height: 44px;
    font-size: var(--t-card);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-decoration: none;
  }

  .tease__link:hover {
    color: var(--color-accent-hover);
  }

  /* --- the compact graphic ------------------------------------------------ */

  .tease__demo {
    padding: var(--s8);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--ring);
    min-width: 0;
  }

  .tease__sources {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--s6);
    border-bottom: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s6);
  }

  .tsrc {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-meta);
    color: var(--color-text-3);
  }

  .tsrc__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .tease__q {
    margin-top: var(--s6);
    font-family: var(--font-mono);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text);
  }

  .tease__finding {
    margin-top: var(--s4);
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .tease__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s3) var(--s4);
    margin-top: var(--s8);
    padding-top: var(--s4);
    border-top: 1px solid var(--color-line-soft);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-4);
  }

  .tease__sample {
    flex: none;
    padding: 2px 7px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-sunk);
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-chip);
    color: var(--color-text-3);
  }
</style>
