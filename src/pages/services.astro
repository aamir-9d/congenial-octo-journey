---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Problems from '../components/Problems.astro';
import Stack from '../components/Stack.astro';
import ServiceIndex from '../components/ServiceIndex.astro';

/**
 * Services.
 *
 * Both of these sections used to sit on the homepage, where together they were
 * 824 words and fifteen disclosures — a fifth of the page — read by a visitor
 * who had not yet been given a reason to care. They are reference material:
 * what goes wrong, and what we do about it. Someone who wants that detail comes
 * looking for it, and now there is somewhere to send them.
 *
 * Nothing was cut in the move. The homepage keeps a compressed problem
 * statement; the full argument and the ten capability bundles live here.
 */

const title = 'Mobile Attribution & App Growth Services — E2E Apps';
const description =
  'What breaks in mobile measurement, and the ten capability bundles that fix it: MMP attribution, SKAdNetwork, tracking plans, subscriptions, app ads and ASO.';
---

<Base title={title} description={description} path="/services">
  <div class="page">
    <Nav />
    <main id="main">
      <Breadcrumbs trail={[{ name: 'Services', path: '/services' }]} />
      <Problems lead />
      <ServiceIndex />
      <Stack />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }

</style>
