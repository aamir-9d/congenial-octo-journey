---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  updated?: string;
  noindex?: boolean;
}

const { title, description, path, heading, updated, noindex = false } = Astro.props;
---

<Base title={title} description={description} path={path} noindex={noindex}>
  <div class="page">
    <Nav />
    <main class="prose section">
      <div class="prose__inner">
        <h1 class="prose__h1">{heading}</h1>
        {updated && <div class="prose__updated">Last updated {updated}</div>}
        <div class="prose__body">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Base>

<style is:global>
  .page {
    min-height: 100vh;
    background: var(--c-paper);
    overflow-x: hidden;
  }

  .prose {
    /* Clear the fixed nav. */
    padding-top: calc(var(--space-2xl) + 48px);
  }

  .prose__inner {
    max-width: 68ch;
    margin: 0 auto;
  }

  .prose__h1 {
    font-size: var(--fs-h2);
    color: var(--c-ink);
  }

  .prose__updated {
    margin-top: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--ls-mono-md);
    color: var(--c-ink-soft);
  }

  .prose__body {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-md);
    font-size: var(--fs-body-md);
    color: var(--c-ink-muted);
  }

  .prose__body h2 {
    margin-top: var(--space-md);
    font-size: var(--fs-h-lg);
    color: var(--c-ink);
  }

  .prose__body h3 {
    font-size: var(--fs-h-xs);
    color: var(--c-ink);
  }

  .prose__body ul {
    margin: 0;
    padding-left: var(--space-md);
    display: grid;
    gap: var(--space-2xs);
  }

  .prose__body code {
    font-family: var(--font-mono);
    font-size: var(--fs-body-xs);
    background: var(--c-paper-alt);
    border-radius: var(--r-3);
    padding: 1px 5px;
  }

  .prose__body table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-body-xs);
  }

  .prose__body th,
  .prose__body td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-2xs) var(--space-xs) var(--space-2xs) 0;
    border-bottom: 1px solid var(--c-line);
  }

  .prose__body th {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-mono-md);
    color: var(--c-ink-soft);
    font-weight: 400;
  }

  /* Wide tables scroll inside their own box rather than the page. */
  .prose__scroll {
    overflow-x: auto;
  }
</style>
