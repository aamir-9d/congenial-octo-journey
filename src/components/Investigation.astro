---
import { EXAMPLES, SOURCES, ASSISTANTS } from '../data/automation.ts';

/**
 * The reporting demonstration.
 *
 * Revision 2 replaced the 40/60 split with a centred introduction above a
 * full-width demonstration: the short copy column used to end while the panel
 * beside it ran on for another 500px, leaving a large empty lower-left region
 * that made the opening read as unfinished.
 *
 * The composition is horizontal rows now, each doing one job — four equal
 * source tiles, the reporting line, three equal assistant options, four example
 * selectors, chart beside finding as equal columns, then source and period.
 *
 * ── Four chart kinds, not one ────────────────────────────────────────────
 *
 * `paired` `funnel` `trend` `periods`. The previous build drew the same bars
 * for every question, which is what made the demonstration feel templated — and
 * worse, a single-period bar chart cannot substantiate a week-on-week claim.
 * Each kind draws what its question needs, and every figure a finding quotes is
 * now visible on the chart it sits beside.
 *
 * ── On the platform marks ───────────────────────────────────────────────
 *
 * The brief asks for official marks and says to use text where a suitable asset
 * is unavailable. None of the seven are in this repository and each carries its
 * own usage terms, so all seven are text in equal containers. Equal is the part
 * that carries the meaning: no source and no assistant is the headline one.
 *
 * ── Without JavaScript ──────────────────────────────────────────────────
 *
 * All four panels render; the first is visible and the rest carry `hidden`,
 * with a companion `display: none` rule because an author `display` beats the
 * UA sheet's. That rule is not optional — without it every state renders at
 * once, which is exactly what shipped last time.
 */

interface Props {
  headingId?: string;
}

const { headingId = 'demo' } = Astro.props;

/** Drawing box. Bars are proportions, so it stretches horizontally. */
const W = 560;
const H = 150;
---

<div class="demo" data-investigation>
  <ul class="tiles" aria-label="Connected reporting sources">
    {
      SOURCES.map((s) => (
        <li class="tile">
          <span class="tile__name">{s.name}</span>
          <span class="tile__note">{s.note}</span>
        </li>
      ))
    }
  </ul>

  <div class="bridge">
    <span class="bridge__rule" aria-hidden="true"></span>
    <span class="bridge__label">Connected reporting</span>
    <span class="bridge__rule" aria-hidden="true"></span>
  </div>

  <ul class="assistants" aria-label="Assistant options">
    {
      ASSISTANTS.map((a) => (
        <li class="asst">{a.name}</li>
      ))
    }
  </ul>

  <div class="tabs" role="tablist" aria-label="Example investigations">
    {
      EXAMPLES.map((e, i) => (
        <button
          type="button"
          role="tab"
          id={`${headingId}-tab-${e.id}`}
          class="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`${headingId}-panel-${e.id}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={e.id}
        >
          {e.tab}
        </button>
      ))
    }
  </div>

  {
    EXAMPLES.map((e, i) => {
      const c = e.chart;
      const max = Math.max(...c.points.map((p) => Math.max(p.v, p.prev ?? 0)));
      const n = c.points.length;
      const money = (v: number) => `${c.prefix ?? ''}${v.toLocaleString('en-US')}`;

      const gap = 12;
      const bw = (W - gap * (n - 1)) / n;

      /* `trend` draws the two period averages the finding quotes, so the claim
         is readable off the chart instead of only asserted beside it. */
      const split = c.splitAfter ?? -1;
      const mean = (from: number, to: number) =>
        c.points.slice(from, to).reduce((s, p) => s + p.v, 0) / (to - from);
      const avgA = split >= 0 ? mean(0, split + 1) : 0;
      const avgB = split >= 0 ? mean(split + 1, n) : 0;

      return (
        <div
          role="tabpanel"
          id={`${headingId}-panel-${e.id}`}
          aria-labelledby={`${headingId}-tab-${e.id}`}
          class="panel"
          data-panel={e.id}
          hidden={i !== 0}
          tabindex="0"
        >
          <p class="panel__q">{e.question}</p>

          <div class="split">
            <figure class="ev">
              <figcaption class="ev__cap">
                <span>{c.caption}</span>
                <span class="ev__sample">Sample data</span>
              </figcaption>

              {c.kind === 'funnel' ? (
                <div class="funnel">
                  {c.points.map((p, bi) => (
                    <div class:list={['fstep', { 'fstep--focus': bi === c.focus }]}>
                      <span class="fstep__label">{p.label}</span>
                      <span class="fstep__track">
                        <span class="fstep__bar" style={`width:${((p.v / max) * 100).toFixed(1)}%`} />
                      </span>
                      <span class="fstep__v">{p.v.toLocaleString('en-US')}</span>
                    </div>
                  ))}
                </div>
              ) : (
                <>
                  <svg
                    viewBox={`0 0 ${W} ${H}`}
                    preserveAspectRatio="none"
                    role="img"
                    aria-label={`${c.caption}. ${c.points
                      .map(
                        (p) =>
                          `${p.label} ${money(p.v)}${p.prev !== undefined ? `, previously ${money(p.prev)}` : ''}`,
                      )
                      .join('. ')}.`}
                  >
                    {split >= 0 && (
                      <Fragment>
                        <line
                          x1="0"
                          y1={H - (avgA / max) * H}
                          x2={(split + 1) * (bw + gap) - gap}
                          y2={H - (avgA / max) * H}
                          stroke="var(--chart-rule)"
                          stroke-width="1"
                          stroke-dasharray="4 4"
                          vector-effect="non-scaling-stroke"
                        />
                        <line
                          x1={(split + 1) * (bw + gap)}
                          y1={H - (avgB / max) * H}
                          x2={W}
                          y2={H - (avgB / max) * H}
                          stroke="var(--color-accent)"
                          stroke-width="1"
                          stroke-dasharray="4 4"
                          vector-effect="non-scaling-stroke"
                        />
                      </Fragment>
                    )}

                    {c.points.map((p, bi) => {
                      const x = bi * (bw + gap);
                      const hv = (p.v / max) * H;
                      const on = bi === c.focus;

                      if (p.prev === undefined) {
                        return (
                          <rect
                            x={x}
                            y={H - hv}
                            width={bw}
                            height={hv}
                            rx="2"
                            fill={on ? 'var(--color-accent)' : 'var(--chart-bar-dim)'}
                          />
                        );
                      }

                      /* Both periods on screen, so a week-on-week claim can be
                         read off the chart rather than taken on trust. */
                      const hp = (p.prev / max) * H;
                      const half = (bw - 4) / 2;
                      return (
                        <Fragment>
                          <rect x={x} y={H - hp} width={half} height={hp} rx="2" fill="var(--chart-bar-dim)" />
                          <rect
                            x={x + half + 4}
                            y={H - hv}
                            width={half}
                            height={hv}
                            rx="2"
                            fill={on ? 'var(--color-accent)' : 'var(--chart-measured)'}
                          />
                        </Fragment>
                      );
                    })}
                  </svg>

                  {/* Labels are HTML. Inside the viewBox they scale with the
                      container and arrive at roughly 7px on a phone. */}
                  <ul class="ticks">
                    {c.points.map((p, bi) => (
                      <li class:list={['tick', { 'tick--focus': bi === c.focus }]}>
                        <span class="tick__v">{money(p.v)}</span>
                        <span class="tick__l">{p.label}</span>
                      </li>
                    ))}
                  </ul>

                  {c.points[0]?.prev !== undefined && (
                    <p class="legend">
                      <span class="legend__k legend__k--prev" aria-hidden="true" />
                      Previous week
                      <span class="legend__k legend__k--now" aria-hidden="true" />
                      This week
                    </p>
                  )}

                  {split >= 0 && (
                    <p class="legend">
                      <span class="legend__k legend__k--dash" aria-hidden="true" />
                      Period averages, {money(Math.round(avgA))} then {money(Math.round(avgB))}
                    </p>
                  )}
                </>
              )}
            </figure>

            <div class="read">
              <p class="read__finding">{e.findings[0]}</p>
              <p class="read__second">{e.findings[1]}</p>

              <p class="read__next">
                <span class="read__next-label">Next check</span>
                {e.next}
              </p>

              <details class="read__basis">
                <summary>How this is measured</summary>
                <p>{e.basis}</p>
                <p>{e.limit}</p>
              </details>
            </div>
          </div>

          <p class="panel__foot">
            <span>{e.source}</span>
            <span>{e.period}</span>
            <span class="panel__foot-tag">Example workflow</span>
          </p>
        </div>
      );
    })
  }
</div>

<script>
  import { initInvestigation } from '../scripts/investigation';
  initInvestigation();
</script>

<style>
  .demo {
    display: flex;
    flex-direction: column;
    gap: var(--s8);
    min-width: 0;
  }

  /* --- sources: four equal tiles, 2x2 on a phone -------------------------- */

  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 720px) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
    text-align: center;
    padding: var(--s4) var(--s3);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--ring);
    min-width: 0;
  }

  .tile__name {
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .tile__note {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-meta);
    color: var(--color-text-4);
  }

  /* --- the reporting line -------------------------------------------------- */

  .bridge {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .bridge__rule {
    flex: 1;
    height: 1px;
    background: var(--color-line-strong);
  }

  .bridge__label {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* --- assistants ---------------------------------------------------------- */

  /* Three columns at every width. The names are short enough to read at
     390px -- roughly 118px each -- and stacking them cost three rows of
     height in front of the evidence, which is the thing a visitor came for. */
  .assistants {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* Names only. Each provider's setup genuinely differs, but a three-way
     technical comparison beside the hero is the brief's explicit "no" -- the
     routes live in the Supported connections disclosure instead. */
  .asst {
    text-align: center;
    font-size: var(--t-card);
    font-weight: var(--fw-medium);
    color: var(--color-text-2);
    min-width: 0;
  }

  /* --- selectors: 2x2 on a phone, four across above 720 -------------------- */

  .tabs {
    display: grid;
    gap: var(--s3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-top: var(--s6);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 720px) {
    .tabs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tab {
    min-height: 44px;
    padding: 0 var(--s4);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    box-shadow: 0 0 0 1px var(--color-line-strong);
    font-family: var(--font-body);
    font-size: var(--t-card-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-3);
    cursor: pointer;
    transition:
      color 160ms var(--ease-out-soft),
      background 160ms var(--ease-out-soft);
  }

  .tab:hover {
    color: var(--color-text);
  }

  .tab[aria-selected='true'] {
    color: var(--color-accent);
    background: var(--color-accent-dim);
    box-shadow: var(--ring-accent);
  }

  /* --- one state ----------------------------------------------------------- */

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    min-width: 0;
  }

  /* An author `display` beats the UA sheet's `[hidden] { display: none }`.
     Without this, every state renders at once. */
  .panel[hidden] {
    display: none;
  }

  .panel:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .panel__q {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text);
  }

  /* Equal columns, top-aligned: balanced by content rather than clipped. */
  .split {
    display: grid;
    gap: var(--s8);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @media (min-width: 860px) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s12);
    }
  }

  /* --- evidence ------------------------------------------------------------ */

  .ev {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    min-width: 0;
  }

  .ev__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s3) var(--s4);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-meta);
    color: var(--color-text-4);
  }

  .ev__sample {
    padding: 2px 7px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-sunk);
    color: var(--color-text-3);
    letter-spacing: var(--ls-chip);
  }

  .ev svg {
    display: block;
    width: 100%;
    height: 150px;
  }

  .ticks {
    list-style: none;
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    align-items: start;
  }

  .tick {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-align: center;
  }

  .tick__v {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-3);
  }

  .tick__l {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    line-height: var(--lh-snug);
    color: var(--color-text-4);
    overflow-wrap: anywhere;
  }

  .tick--focus .tick__v,
  .tick--focus .tick__l {
    color: var(--color-accent);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    color: var(--color-text-4);
  }

  .legend__k {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    flex: none;
  }

  .legend__k--prev {
    background: var(--chart-bar-dim);
  }

  .legend__k--now {
    background: var(--color-accent);
    margin-left: var(--s4);
  }

  .legend__k--dash {
    height: 0;
    border-top: 1px dashed var(--color-accent);
    border-radius: 0;
  }

  /* --- funnel: horizontal, because the labels are event names -------------- */

  .funnel {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .fstep {
    display: grid;
    grid-template-columns: minmax(0, 9em) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4);
  }

  .fstep__label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    line-height: var(--lh-snug);
    color: var(--color-text-4);
    overflow-wrap: anywhere;
  }

  .fstep__track {
    display: block;
    min-width: 0;
  }

  .fstep__bar {
    display: block;
    height: 16px;
    border-radius: 2px;
    background: var(--chart-bar-dim);
  }

  .fstep--focus .fstep__bar {
    background: var(--color-accent);
  }

  .fstep--focus .fstep__label,
  .fstep--focus .fstep__v {
    color: var(--color-accent);
  }

  .fstep__v {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-3);
    white-space: nowrap;
  }

  /* --- reading ------------------------------------------------------------- */

  .read {
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    min-width: 0;
  }

  .read__finding {
    margin: 0;
    font-size: var(--t-section-lead);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-snug);
    color: var(--color-text);
    text-wrap: balance;
  }

  .read__second {
    margin: 0;
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-3);
  }

  .read__next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s4);
    margin: 0;
    padding-top: var(--s6);
    border-top: 1px solid var(--color-line-soft);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .read__next-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-accent);
    padding-top: 2px;
  }

  .read__basis summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-disclosure);
    color: var(--color-text-4);
    list-style: none;
  }

  .read__basis summary::-webkit-details-marker {
    display: none;
  }

  .read__basis summary::before {
    content: '+';
    width: 1.3em;
    color: var(--color-accent);
  }

  .read__basis[open] summary::before {
    content: '\2212';
  }

  .read__basis summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .read__basis p {
    margin: 0 0 var(--s4) 1.3em;
    font-size: var(--t-card-sm);
    line-height: var(--lh-body);
    color: var(--color-text-4);
  }

  .panel__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s6);
    margin: 0;
    padding-top: var(--s4);
    border-top: 1px solid var(--color-line-soft);
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--color-text-4);
  }

  .panel__foot-tag {
    color: var(--color-accent);
  }
</style>
