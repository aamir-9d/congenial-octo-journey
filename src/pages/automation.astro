---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Investigation from '../components/Investigation.astro';
import {
  MCP,
  MCP_HOST,
  SERVER_OPEN,
  ACCOUNTS_OPEN,
  HEADER,
  STEPS,
  PROMISES,
  PANEL,
  panelStatus,
  PLATFORMS,
  STATUS_LABEL,
  TOOLS,
  SECURITY,
  FAQS,
  DISCLOSURES,
  EXAMPLES,
} from '../data/automation.ts';

/**
 * /automation
 *
 * Board: the approved automation page with the E2E Apps MCP (desktop and
 * phone), November 2026. Structure and wording come from the board; the
 * interactive report in section 4 is the page's own and stays.
 *
 * NOTHING IS OPEN YET. Every statement about the server being usable reads
 * `MCP` in src/data/automation.ts. While `MCP.status` is 'coming' the header
 * shows the address marked "Opening soon" and one button to the contact form;
 * set it to 'live' and the header becomes the board's: the address, Copy,
 * Add to Claude, Add to ChatGPT. `MCP.accounts` does the same for everything
 * about connecting a platform. See the comment on `MCP`.
 *
 * Sequence:
 *   1  header: label, h1, lead, the address, the action, a sample chat
 *   2  three steps
 *   3  every platform through one connection, with the connections panel
 *   4  ask a business question: the live example report (Investigation.astro)
 *   5  what's inside: the method tools, and the account data
 *   6  security
 *   7  platforms: the status table
 *   8  done for you
 *   9  the detail: three disclosures
 *  10  common questions (FAQPage structured data from the same array)
 *  11  Cta
 *
 * Rows of equal cards (the steps, the security cards) are swipe rows below
 * 700px. Lists, the table and the questions stack.
 */

const title = 'AI Reporting for App Growth in Claude & ChatGPT — E2E Apps';
const description = SERVER_OPEN
  ? 'The E2E Apps MCP puts our audit method, and your GA4, AdMob, RevenueCat and Google Ads figures, inside Claude and ChatGPT. Free to use and read-only.'
  : 'The E2E Apps MCP puts our audit method, and next your GA4, AdMob, RevenueCat and Google Ads figures, inside Claude and ChatGPT. Read-only. Opening soon.';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* The page describes one service; this says so in structured data, using the
   page's own name and description. Provider is the business node that
   Schema.astro defines on the homepage. */
const home = new URL(`${base}/`, Astro.site).href;
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI reporting & automation for app growth',
  description,
  url: new URL(`${base}/automation`, Astro.site).href,
  serviceType: 'Marketing analytics and reporting automation',
  areaServed: 'Worldwide',
  provider: { '@type': 'ProfessionalService', '@id': `${home}#business`, name: 'E2E Apps', url: home },
};

/* The questions, as structured data, from the array the page prints. */
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* The sample chat in the header is the 'earnings' example, read from the same
   data the report in section 4 draws: its question, its finding, its next
   check, and the two daily averages either side of the step. */
const sample = EXAMPLES.find((e) => e.id === 'earnings')!;
const pts = sample.chart.points;
const split = sample.chart.splitAfter ?? 0;
const mean = (from: number, to: number) => pts.slice(from, to).reduce((s, p) => s + p.v, 0) / (to - from);
const before = mean(0, split + 1);
const after = mean(split + 1, pts.length);
const money = (v: number) => `${sample.chart.prefix ?? ''}${Math.round(v).toLocaleString('en-US')}`;
const bars = [
  { label: `${pts[0]!.label}–${pts[split]!.label}`, value: money(before), width: 100, focus: false },
  {
    label: `${pts[split + 1]!.label}–${pts[pts.length - 1]!.label}`,
    value: money(after),
    width: Math.round((after / before) * 100),
    focus: true,
  },
];

/* Where each card's glow sits, so a row does not repeat one corner. */
const GLOW = ['100%;--gy:0%', '100%;--gy:100%', '0%;--gy:0%', '0%;--gy:100%'];
const TAG = { available: 'tag--fix', coming: 'tag--review', next: 'tag--ok' } as const;

/* The Copy button, rendered only once the address is usable. */
const COPY_SCRIPT = `document.querySelectorAll('[data-copy]').forEach(function (b) {
  b.addEventListener('click', function () {
    if (!navigator.clipboard) return;
    navigator.clipboard.writeText(b.getAttribute('data-copy')).then(function () {
      b.textContent = 'Copied';
      setTimeout(function () { b.textContent = 'Copy'; }, 1600);
    });
  });
});`;

const security = ACCOUNTS_OPEN ? SECURITY.accounts : SECURITY.built;
const reads = PLATFORMS.filter((p) => p.reads);
---

<Base title={title} description={description} path="/automation">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(service)} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />
  <div class="page">
    <Nav />

    <main id="main">
      <Breadcrumbs trail={[{ name: 'Automation', path: '/automation' }]} />

      {/* ------------------------------------------------------ 1 · header */}
      <section class="phero" data-section="automation-intro">
        <div class="phero__grid" aria-hidden="true"></div>
        <div class="phero__inner hero2">
          <div class="hero2__copy">
            <p class="phero__label">{HEADER.label}</p>
            <h1 class="phero__title">{HEADER.title}</h1>
            <p class="phero__lead">{HEADER.lead}</p>

            <div class="addr" data-mcp-address={SERVER_OPEN ? 'live' : 'coming'}>
              <span class="addr__k">Address</span>
              <span class="addr__v">{MCP.address}</span>
              {
                SERVER_OPEN ? (
                  <button type="button" class="addr__copy" data-copy={MCP.address}>
                    Copy
                  </button>
                ) : (
                  <span class="tag tag--review addr__soon">{HEADER.soon}</span>
                )
              }
            </div>

            <div class="phero__actions">
              {
                SERVER_OPEN ? (
                  <Fragment>
                    <a href="#steps" class="btn-primary">
                      Add to Claude
                      <Icon name="arrow-right" size={16} />
                    </a>
                    <a href="#steps" class="btn-secondary">
                      Add to ChatGPT
                    </a>
                  </Fragment>
                ) : (
                  <a href={`${base}/#contact`} class="btn-primary">
                    Discuss your setup
                    <Icon name="arrow-right" size={16} />
                  </a>
                )
              }
            </div>
            <p class="phero__note">{HEADER.note}</p>
          </div>

          <div class="chat">
            <p class="chat__top">
              <span>In your assistant</span>
              <span>Sample data</span>
            </p>
            <p class="chat__q">{sample.question}</p>
            <p class="chat__tools">
              <span class="tag tag--review">E2E Apps · {sample.source} · read</span>
              <span class="tag tag--ok">E2E Apps · monetisation checks</span>
            </p>
            <div class="chat__a">
              <p class="chat__finding">{sample.finding}</p>
              <div class="chat__bars">
                {
                  bars.map((b) => (
                    <Fragment>
                      <span class:list={['chat__bar-label', { 'is-focus': b.focus }]}>{b.label}</span>
                      <span class="chat__track">
                        <span class:list={['chat__bar', { 'is-focus': b.focus }]} style={`width:${b.width}%`} />
                      </span>
                      <span class:list={['chat__bar-value', { 'is-focus': b.focus }]}>{b.value}</span>
                    </Fragment>
                  ))
                }
              </div>
              <p class="chat__next">
                <strong>Next check:</strong>
                {sample.next}
              </p>
              <p class="chat__meta">
                {sample.source} · {sample.period.toLowerCase()} · nothing was changed
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* --------------------------------------------------- 2 · three steps */}
      <section id="steps" class="section" data-section="automation-steps" data-added="automation-mcp-2026-11">
        <div class="wrap">
          <div class="shead" data-reveal="1">
            <p class="shead__label">How to start</p>
            <h2 class="shead__title">Three steps to start.</h2>
            <p class="shead__aside">
              {
                SERVER_OPEN
                  ? 'No code and no cloud project. If you can sign in to Google, you can set this up.'
                  : 'No code and no cloud project. If you can sign in to Google, you will be able to set this up.'
              }
            </p>
          </div>

          <div class="sbody">
            <ol class="ggrid ggrid--3 swipe steps" data-swipe data-swipe-label="Step">
              {
                STEPS.map((s, i) => (
                  <li
                    class:list={['gcard', { 'gcard--lead': i === 0 }]}
                    style={`--gx:${GLOW[i % GLOW.length]}`}
                    data-step={s.n}
                  >
                    <span class="step__top">
                      <span class="step__n">{s.n}</span>
                      {s.coming && <span class="tag tag--review">{STATUS_LABEL.coming}</span>}
                    </span>
                    <h3 class="gcard__title step__title">{s.title}</h3>
                    <p class="gcard__text">{s.body}</p>
                    <span class:list={['step__foot', { 'is-accent': i === 0 }]}>{s.foot}</span>
                  </li>
                ))
              }
            </ol>
            <div class="swipe__meta" data-swipe-meta aria-hidden="true">
              <span class="swipe__dots" data-swipe-dots>{STEPS.map(() => <i />)}</span>
              <span data-swipe-count>Step 1 of {STEPS.length}</span>
            </div>
          </div>
        </div>
      </section>

      {/* ------------------------------------------- 3 · one connection ---- */}
      <section class="section section--band" data-section="automation-connect" data-added="automation-mcp-2026-11">
        <div class="wrap row">
          <div class="one" data-reveal="1">
            <p class="shead__label">One sign-in, not five setups</p>
            <h2 class="shead__title one__title">Every platform through one connection.</h2>
            <p class="one__text">
              Connecting each platform to an assistant yourself means a separate server and a
              separate setup for each one.
              {
                ACCOUNTS_OPEN
                  ? 'Here you connect on one page of ours and choose what to share.'
                  : 'Here you will connect on one page of ours and choose what to share.'
              }
            </p>
            <ul class="ticks" role="list">
              {PROMISES.map((p) => <li>{p}</li>)}
            </ul>
          </div>

          <div class="cpanel" data-connections={ACCOUNTS_OPEN ? 'live' : 'preview'}>
            <p class="cpanel__top">
              <span class="cpanel__name">Your connections</span>
              {
                ACCOUNTS_OPEN ? (
                  <span class="cpanel__where">{MCP_HOST.replace(/\/mcp$/, '/connect')}</span>
                ) : (
                  <span class="tag tag--review">Preview</span>
                )
              }
            </p>
            <ul class="cpanel__rows" role="list">
              {
                PANEL.map((r) => {
                  const st = panelStatus(r.platforms);
                  const open = st === 'available' && 'action' in r;
                  const on = open && 'connected' in r;
                  return (
                    <li class:list={['crow', { 'crow--on': on, 'crow--later': st === 'next' }]}>
                      <span class="crow__text">
                        <span class="crow__title">{r.title}</span>
                        <span class="crow__note">{open && 'sample' in r ? r.sample : r.note}</span>
                      </span>
                      {open ? (
                        <span class:list={[on ? 'badge' : 'crow__action']}>{r.action}</span>
                      ) : (
                        <span class:list={['tag', TAG[st]]}>{STATUS_LABEL[st]}</span>
                      )}
                    </li>
                  );
                })
              }
            </ul>
            {
              !ACCOUNTS_OPEN && (
                <p class="cpanel__foot">A drawing of the page being built. Nothing connects yet.</p>
              )
            }
          </div>
        </div>
      </section>

      {/* --------------------------------------------- 4 · the evidence --- */}
      <section class="section" data-section="automation-report">
        <div class="wrap">
          <div class="shead" data-reveal="1">
            <p class="shead__label">What asking looks like</p>
            <h2 class="shead__title">Ask a business question.</h2>
            <p class="shead__aside">
              Four saved questions come with it. Each one says where the figures come from and what
              to check next.
            </p>
          </div>

          <div class="sbody">
            <Investigation headingId="demo" />
          </div>
        </div>
      </section>

      {/* --------------------------------------------- 5 · what's inside --- */}
      <section class="section section--band" data-section="automation-inside" data-added="automation-mcp-2026-11">
        <div class="wrap">
          <div class="shead" data-reveal="1">
            <p class="shead__label">What's inside</p>
            <h2 class="shead__title">Your data, and the method to read it.</h2>
          </div>

          <div class="sbody inside">
            <div class="gcard" style="--gx:0%;--gy:0%">
              <p class="inside__tags">
                <span class="tag tag--ok">No sign-in needed</span>
              </p>
              <h3 class="gcard__title inside__title">Our method, as tools</h3>
              <ul class="kv" role="list">
                {
                  TOOLS.map((t) => (
                    <li>
                      <span class="kv__k">{t.name}</span>
                      <span class="kv__v">{t.does}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="gcard gcard--lead" style="--gx:100%;--gy:0%" data-account-data={ACCOUNTS_OPEN ? 'live' : 'coming'}>
              <p class="inside__tags">
                <span class="tag tag--fix">With your accounts connected</span>
                {!ACCOUNTS_OPEN && <span class="tag tag--review">{STATUS_LABEL.coming}</span>}
              </p>
              <h3 class="gcard__title inside__title">Your numbers, read for you</h3>
              <ul class="kv" role="list">
                {
                  reads.map((p) => (
                    <li>
                      <span class="kv__k">{p.name}</span>
                      <span class="kv__v">{p.reads}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="inside__foot">
                {
                  ACCOUNTS_OPEN
                    ? 'The traps are handled for you: all ad networks are counted, long reports are read in full, and installs are not mixed with other conversions.'
                    : 'The traps will be handled for you: all ad networks are counted, long reports are read in full, and installs are not mixed with other conversions.'
                }
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* -------------------------------------------------- 6 · security --- */}
      <section class="section" data-section="automation-security" data-added="automation-mcp-2026-11">
        <div class="wrap">
          <div class="shead" data-reveal="1">
            <p class="shead__label">Security</p>
            <h2 class="shead__title">It can read. It cannot change anything.</h2>
            <p class="shead__aside">
              No tool in this server can edit a campaign, a budget, a product or a setting. That is
              how it is built, not a promise about behaviour.
            </p>
          </div>

          <div class="sbody">
            {!ACCOUNTS_OPEN && <h3 class="sub">As it is built today</h3>}
            <div class="ggrid ggrid--4 swipe" data-swipe>
              {
                security.map((c, i) => (
                  <div class="gcard" style={`--gx:${GLOW[i % GLOW.length]}`}>
                    <h3 class="sec__title">{c.title}</h3>
                    <p class="sec__text">{c.body}</p>
                  </div>
                ))
              }
            </div>
            <div class="swipe__meta" data-swipe-meta aria-hidden="true">
              <span class="swipe__dots" data-swipe-dots>{security.map(() => <i />)}</span>
              <span data-swipe-count>1 of {security.length}</span>
            </div>

            {
              !ACCOUNTS_OPEN && (
                <div class="later" data-when-accounts-open>
                  <h3 class="sub">When account connection opens</h3>
                  <ul class="kv kv--panel" role="list">
                    {SECURITY.accounts.map((c) => (
                      <li>
                        <span class="kv__k">{c.title}</span>
                        <span class="kv__v">{c.body}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>
        </div>
      </section>

      {/* ------------------------------------------------- 7 · platforms --- */}
      <section class="section section--band" data-section="automation-platforms" data-added="automation-mcp-2026-11">
        <div class="wrap detail">
          <div class="detail__head" data-reveal="1">
            <p class="shead__label">Platforms</p>
            <h2 class="detail__title">
              {ACCOUNTS_OPEN ? 'What connects today, and what is next.' : 'What connects first, and what is next.'}
            </h2>
            <p class="detail__text">
              A platform is listed as available only after it has been tested against real accounts.
            </p>
          </div>

          <div class="ptable">
            <table>
              <thead>
                <tr>
                  <th scope="col">Platform</th>
                  <th scope="col">How you connect</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                {
                  PLATFORMS.map((p) => (
                    <tr data-platform-status={p.status}>
                      <th scope="row" class:list={['ptable__name', { 'is-later': p.status === 'next' }]}>
                        {p.name}
                      </th>
                      <td class="ptable__how">{p.how}</td>
                      <td>
                        <span class:list={['tag', TAG[p.status]]}>{STATUS_LABEL[p.status]}</span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {/* ----------------------------------------------- 8 · done for you -- */}
      <section class="section" data-section="automation-setup" data-added="automation-mcp-2026-11">
        <div class="wrap">
          <div class="gcard gcard--lead done" style="--gx:100%;--gy:0%">
            <div class="done__copy">
              <p class="shead__label">Done for you</p>
              <h2 class="done__title">Want it set up and tuned to your reporting?</h2>
              <p class="done__text">
                We connect your accounts with you, agree what each metric means, and write the saved
                questions your team will ask every week.
              </p>
            </div>
            <div class="done__act">
              <a href={`${base}/#contact`} class="btn-primary">
                Discuss your setup
                <Icon name="arrow-right" size={16} />
              </a>
              <a class="cta__mail" href="mailto:hello@e2eapp.com">hello@e2eapp.com</a>
            </div>
          </div>
        </div>
      </section>

      {/* ------------------------------------------------ 9 · the detail -- */}
      <section class="section detail-sec" data-section="automation-detail" data-added="redesign-2026-11">
        <div class="wrap detail">
          <div class="detail__head" data-reveal="1">
            <p class="shead__label">The detail</p>
            <h2 class="detail__title">What connects, who approves, how figures are defined</h2>
            <p class="detail__text">How a setup done for you works today.</p>
          </div>

          <div class="detail__list">
            {
              DISCLOSURES.map((d, i) => (
                <details class="disc" open={i === 0}>
                  <summary>{d.label}</summary>
                  <div class="disc__body">
                    {d.body.map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      {/* ------------------------------------------- 10 · common questions -- */}
      <section class="section detail-sec" data-section="automation-faq" data-added="automation-mcp-2026-11">
        <div class="wrap detail">
          <div class="detail__head" data-reveal="1">
            <p class="shead__label">Before you add it</p>
            <h2 class="detail__title">Common questions.</h2>
          </div>

          <div class="detail__list">
            {
              FAQS.map((f) => (
                <div class="qa" data-faq>
                  <h3 class="qa__q">{f.q}</h3>
                  <p class="qa__a">{f.a}</p>
                </div>
              ))
            }
            <p class="legal" data-mcp-legal>
              <span>The server's own pages:</span>
              <a href={`${base}/mcp/privacy`}>MCP privacy</a>
              <a href={`${base}/mcp/terms`}>MCP terms</a>
            </p>
          </div>
        </div>
      </section>

      <Cta />
    </main>

    <Footer />
  </div>
  {SERVER_OPEN && <script is:inline set:html={COPY_SCRIPT} />}
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  /* --- 1 · header -----------------------------------------------------------
     The shared `.phero` (redesign.css) with two columns on a wide screen: the
     copy on the left, a sample chat on the right. Below 1000px it is the
     centred header every other page has, with the chat under it. */

  .hero2 {
    display: grid;
    /* The page's own width, so the copy starts on the same left edge as every
       section under it. */
    max-width: var(--wrap);
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s16);
    align-items: center;
  }

  .hero2__copy {
    min-width: 0;
  }

  .hero2 .phero__title {
    max-width: 18ch;
  }

  .addr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px var(--s4);
    box-sizing: border-box;
    max-width: 560px;
    min-height: 60px;
    margin: var(--s12) auto 0;
    padding: 8px 10px 8px 20px;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-line-strong);
    text-align: left;
  }

  .addr__k {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .addr__v {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: clamp(14px, 1.15vw, 16.5px);
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  /* Not open: the address is there to be read, not used. */
  .addr[data-mcp-address='coming'] .addr__v {
    color: var(--color-text-3);
  }

  .addr__soon {
    padding: 8px 14px;
    font-size: var(--t-mono-sm);
  }

  .addr__copy {
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface-sunk);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--t-body-sm);
    font-weight: var(--fw-semibold);
    cursor: pointer;
  }

  .addr__copy:hover {
    border-color: var(--color-line-hover);
  }

  .hero2 .phero__actions {
    margin-top: var(--s6);
  }

  .hero2 .phero__note {
    max-width: 52ch;
    margin-inline: auto;
  }

  @media (max-width: 479px) {
    .addr {
      padding: 12px 16px;
    }

    .addr__k {
      display: none;
    }

    .addr__v {
      flex-basis: 100%;
      text-align: center;
    }
  }

  @media (min-width: 1000px) {
    .hero2 {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: clamp(40px, 6vw, 96px);
      text-align: left;
    }

    .hero2 .phero__title {
      margin-inline: 0;
      font-size: clamp(40px, 4vw, 56px);
    }

    .hero2 .phero__lead,
