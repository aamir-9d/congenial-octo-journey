---
import Icon from './Icon.astro';

/**
 * The closing ask on every page except the homepage (which carries the full
 * form instead). Styles are `.cta*` in src/styles/redesign.css.
 *
 * The heading and paragraph are the Contact section's own signed-off copy, so
 * the ask reads the same wherever a visitor meets it.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="cta" data-section="cta" data-added="redesign-2026-11">
  <div class="wrap cta__inner">
    <div>
      <p class="shead__label">Let's look at your setup</p>
      <h2 class="cta__title">Send me your MMP setup. I'll tell you what's broken in it.</h2>
    </div>
    <div>
      <p class="cta__text">
        Send your app's store link and I'll reply in writing with three measurement checks for it,
        free. Or book a 30-minute call, no pitch.
      </p>
      <p>
        <a href={`${base}/#contact`} class="btn-primary" style="margin-top: var(--s8)">
          Get a free first look
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
      <a class="cta__mail" href="mailto:hello@e2eapp.com">hello@e2eapp.com</a>
    </div>
  </div>
</section>
