---
import ServiceTable from './ServiceTable.astro';
import type { Visual } from '../data/services';

/**
 * The exhibit near the top of a service page: a glowing scene panel with the
 * page's own diagram on data cards.
 *
 * Board: design/v3/ServiceDetail.dc.html (the audit's five steps). The other
 * four kinds follow the same construction. Plain markup throughout, so every
 * word is readable by a screen reader and a crawler. Horizontal on a desktop,
 * vertical on a phone, never scaled down.
 */
interface Props {
  visual: Visual;
}

const { visual } = Astro.props;

const windows = [
  { name: 'Window 1', days: 'Days 0–2', text: 'Install and trial start are visible here.', grow: 3, tone: 'a' },
  { name: 'Window 2', days: 'Days 3–7', text: 'A seven-day trial charges at about day 7.', grow: 5, tone: 'b' },
  { name: 'Window 3', days: 'Days 8–35', text: 'Retention and repeat payment.', grow: 28, tone: 'c' },
  { name: 'Not seen', days: 'Day 36 on', text: 'The first monthly renewal, near day 37, needs server-side data.', grow: 4, tone: 'd' },
];

const orders = [
  { title: 'No wait', good: false, steps: ['App opens', 'SDK sends install', 'Prompt appears', 'User allows'], mark: 1, result: 'The answer arrives after the install was sent.' },
  { title: 'With the wait set', good: true, steps: ['App opens, wait set', 'Prompt appears', 'User allows', 'SDK sends install'], mark: 3, result: 'The install can carry the identifier.' },
];

const two = (n: number) => String(n).padStart(2, '0');
---

<div class="scene svis">
  <div class="svis__dots" aria-hidden="true"></div>
  <div class="svis__in">
    {visual.kind === 'chain' && (
      <>
        {/* The chain is the audit's exhibit, so its two labels are the audit's. */}
        <div class="svis__top">
          <span class="svis__label">What gets checked at each step</span>
          <span class="badge">Ranked by impact</span>
        </div>
        <ol class="vis-chain" role="list">
          {visual.steps.map(([name, text], i) => (
            <li class:list={['dcard', 'vis-chain__step', { 'dcard--raised vis-chain__step--last': i === visual.steps.length - 1 }]}>
              <span class="vis-chain__n" aria-hidden="true">{two(i + 1)}</span>
              <span class="vis-chain__copy">
                <span class="vis-chain__name">{name}</span>
                <span class="vis-chain__text">{text}</span>
              </span>
            </li>
          ))}
        </ol>
      </>
    )}

    {visual.kind === 'windows' && (
      <div class="svis__stack">
        <div class="dcard svis__card">
          <ol class="vis-win" role="list">
            {windows.map((w) => (
              <li class={`vis-win__item vis-win__item--${w.tone}`} style={`--grow:${w.grow}`}>
                <span class="vis-win__bar">
                  <span class="vis-win__name">{w.name}</span>
                  <span class="vis-win__days">{w.days}</span>
                </span>
                <span class="vis-win__text">{w.text}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="dcard svis__card">
          <ServiceTable
            head={['Window', 'Postback delay', 'Value available']}
            rows={[
              ['1', '24 to 48 hours', 'Fine (0 to 63) or coarse, depending on the data tier'],
              ['2', '24 to 144 hours', 'Coarse, unless the tier is 0'],
              ['3', '24 to 144 hours', 'Coarse, unless the tier is 0'],
            ]}
          />
        </div>
      </div>
    )}

    {visual.kind === 'order' && (
      <div class="svis__stack">
        {orders.map((o) => (
          <div class:list={['dcard', 'svis__card', { 'dcard--raised vis-order--good': o.good }]}>
            <h3 class:list={['vis-order__title', { 'vis-order__title--good': o.good }]}>{o.title}</h3>
            <ol class="vis-order__steps" role="list">
              {o.steps.map((s, i) => (
                <li class:list={['vis-order__step', i === o.mark && (o.good ? 'vis-order__step--good' : 'vis-order__step--bad')]}>
                  <span class="vis-order__n" aria-hidden="true">{two(i + 1)}</span>
                  {s}
                </li>
              ))}
            </ol>
            <p class="vis-order__result">{o.result}</p>
          </div>
        ))}
      </div>
    )}

    {visual.kind === 'spec' && (
      <dl class="dcard svis__card vis-spec">
        <div class="vis-spec__name">
          <dt class="vis-spec__key">Name</dt>
          <dd class="vis-spec__event">{visual.name}</dd>
        </div>
        {visual.fields.map(([k, v]) => (
          <div class="vis-spec__field">
            <dt class="vis-spec__key">{k}</dt>
            <dd class="vis-spec__value">{v}</dd>
          </div>
        ))}
      </dl>
    )}

    {visual.kind === 'table' && (
      <div class="dcard svis__card">
        <ServiceTable head={visual.head} rows={visual.rows} />
      </div>
    )}
  </div>
</div>

<style>
  ol,
  dl,
  dd {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svis {
    overflow: hidden;
    min-height: 0;
    padding: clamp(16px, 3.4vw, 44px);
  }

  .svis__dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle at center, rgba(var(--rgb-text), var(--dot-grid)) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  .svis__in {
    position: relative;
    min-width: 0;
  }

  .svis__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s8);
  }

  .svis__label {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .svis__stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .svis__card {
    min-width: 0;
    padding: clamp(16px, 2.2vw, 28px);
  }

  /* --- chain: the audit's five steps --- */

  .vis-chain {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .vis-chain__step {
    display: flex;
    align-items: flex-start;
    gap: var(--s6);
    min-width: 0;
    padding: 18px 20px;
  }

  .vis-chain__step--last {
    box-shadow:
      0 0 0 1px rgba(var(--rgb-accent), 0.6),
      0 26px 50px -22px rgba(0, 0, 0, 0.55);
  }

  .vis-chain__n {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-accent-text);
  }

  .vis-chain__step--last .vis-chain__n {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  .vis-chain__copy {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    min-width: 0;
  }

  .vis-chain__name {
    font-size: var(--t-h3-station);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-h3);
    line-height: 1.2;
  }

  .vis-chain__text {
    font-size: var(--t-body-sm);
    line-height: 1.5;
    color: var(--color-text-2);
  }

  @media (min-width: 700px) {
    .vis-chain {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (min-width: 1100px) {
    .vis-chain {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(12px, 1.6vw, 24px);
    }

    .vis-chain__step {
      flex-direction: column;
      gap: 20px;
      min-height: 190px;
      padding: 24px 22px;
    }

    .vis-chain__name {
      font-size: var(--t-h3);
    }
  }

  /* --- windows: SKAN's three windows --- */

  .vis-win {
    display: flex;
    gap: 4px;
  }

  .vis-win__item {
    flex: var(--grow) 1 0;
    min-width: 168px;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .vis-win__bar {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px;
    min-height: 78px;
    border-radius: var(--radius-sm);
  }

  .vis-win__item--a .vis-win__bar {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  .vis-win__item--b .vis-win__bar {
    background: rgba(var(--rgb-accent), 0.34);
  }

  .vis-win__item--c .vis-win__bar {
    background: rgba(var(--rgb-accent), 0.16);
  }

  .vis-win__item--d .vis-win__bar {
    border: 1px dashed var(--color-text-4);
  }

  .vis-win__name {
    font-weight: var(--fw-semibold);
    font-size: var(--t-body-sm);
  }

  .vis-win__days {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
  }

  .vis-win__text {
    padding-right: var(--s4);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  /* --- order: ATT, the same four steps twice --- */

  .vis-order__title {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .vis-order__title--good {
    color: var(--color-accent-text);
  }

  .vis-order--good {
    box-shadow:
      0 0 0 1px rgba(var(--rgb-accent), 0.6),
      0 26px 50px -22px rgba(0, 0, 0, 0.55);
  }

  .vis-order__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: var(--s6);
  }

  .vis-order__step {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    min-width: 0;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    font-size: var(--t-body-sm);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
  }

  .vis-order__n {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    font-weight: var(--fw-regular);
    color: var(--color-text-4);
  }

  .vis-order__step--bad {
    box-shadow: inset 0 0 0 1.5px var(--color-text-4);
  }

  .vis-order__step--good {
    background: var(--color-accent);
    box-shadow: none;
    color: var(--color-ink);
  }

  .vis-order__step--good .vis-order__n {
    color: var(--color-ink);
  }

  .vis-order__result {
    margin-top: var(--s6);
    font-size: var(--t-body-sm);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  /* --- spec: one event from a tracking plan --- */

  .vis-spec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 0 24px;
  }

  .vis-spec__name {
    grid-column: 1 / -1;
    padding: 0 0 18px;
  }

  .vis-spec__event {
    margin-top: var(--s2);
    font-family: var(--font-mono);
    font-size: var(--t-stat);
    line-height: var(--lh-tight);
    color: var(--color-accent-text);
    overflow-wrap: anywhere;
  }

  .vis-spec__field {
    min-width: 0;
    padding: 14px 0;
    border-top: 1px solid var(--color-line-strong);
  }

  .vis-spec__key {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .vis-spec__value {
    margin-top: var(--s2);
    font-size: var(--t-body-sm);
    line-height: var(--lh-snug);
    overflow-wrap: anywhere;
  }

  @media (max-width: 899px) {
    .vis-win {
      flex-direction: column;
    }

    .vis-win__item {
      flex: none;
      min-width: 0;
      gap: var(--s3);
      padding-bottom: var(--s4);
    }

    .vis-win__bar {
      min-height: 0;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
    }

    /* Height stands in for the bar's width, so the third window still reads as
       much the longest. */
    .vis-win__item--c .vis-win__bar {
      min-height: 110px;
    }
  }

  @media (max-width: 767px) {
    .vis-order__steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .vis-order__step {
      flex-direction: row;
      align-items: baseline;
      gap: var(--s4);
    }
  }
</style>
