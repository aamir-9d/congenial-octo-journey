---
/**
 * "01 / Find the gaps" — three checks as open editorial columns.
 *
 * Rebuilt to the approved reference: a left-aligned header with the supporting
 * line set against it on the right, then three equal columns divided by
 * hairlines. No cards, no panels, no fills — the columns are held apart by
 * rules and whitespace alone.
 *
 * ── Palette ──────────────────────────────────────────────────────────────
 *
 * The brief lists hex values; they are within a shade of the site's own
 * tokens, so the tokens are what ship. #2C333D is --color-line-strong to the
 * eye, #F5AD25 is --color-accent, and so on down the list. Introducing a
 * second near-identical palette would be drift, and `tests/tokens.test.ts`
 * exists to catch exactly that.
 *
 * ── The icons are drawn here, not vendored ───────────────────────────────
 *
 * The site's icon set is Phosphor, filled, and has no bars, node tree or
 * globe in it. The reference draws all three as thin outlines, which is a
 * different weight from the vendored set anyway, so they are authored here as
 * plain geometry — rectangles, circles and arcs. That keeps the change inside
 * this section and avoids inventing path data for glyphs I would be
 * transcribing from memory.
 *
 * Numbers and icons are decorative and hidden from assistive technology: each
 * column is already named by its own heading, and "01" announced before it
 * would be noise.
 *
 * All copy here is new, so the section root carries `data-added` — the
 * copy-parity check lifts it out whole and goes on comparing the export's own
 * strings, which ship in full on /services.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = `${base}/services`;

/** Line icons, 24×24, stroked with currentColor so the amber comes from CSS. */
const ICONS: Record<string, string> = {
  bars: `
    <rect x="3"  y="14" width="4" height="7"  rx="1" />
    <rect x="10" y="9"  width="4" height="12" rx="1" />
    <rect x="17" y="4"  width="4" height="17" rx="1" />`,
  nodes: `
    <circle cx="12" cy="5"  r="2.6" />
    <circle cx="5"  cy="19" r="2.6" />
    <circle cx="19" cy="19" r="2.6" />
    <path d="M12 7.6 v3.4 M5 16.4 v-2.2 a1.2 1.2 0 0 1 1.2-1.2 h11.6 a1.2 1.2 0 0 1 1.2 1.2 v2.2" />`,
  globe: `
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12 h18" />
    <path d="M12 3 a13 13 0 0 1 0 18 a13 13 0 0 1 0 -18 z" />`,
};

const CHECKS = [
  {
    n: '01',
    icon: 'bars',
    title: 'Revenue after install',
    desc: 'Count renewals, refunds and server events.',
  },
  {
    n: '02',
    icon: 'nodes',
    title: 'The route to purchase',
    desc: 'Find where installs stop becoming customers.',
  },
  {
    n: '03',
    icon: 'globe',
    title: 'Economics by market',
    desc: 'Know which markets can support your spend.',
  },
];
---

<section id="services" class="section" data-section="diagnostics" data-added="redesign">
  <div class="wrap">
    <div class="gaps__head" data-reveal="1">
      <div>
        <p class="eyebrow eyebrow--amber gaps__eyebrow">01 / Find the gaps</p>
        <h2 class="gaps__h2">Three checks.<br />One connected picture.</h2>
      </div>

      <p class="gaps__lead">
        Follow the revenue, the purchase journey, and the economics behind your next decision.
      </p>
    </div>

    <ol class="gaps__list" data-reveal="2">
      {
        CHECKS.map((c) => (
          <li class="gaps__item">
            <div class="gaps__mark">
              <span class="gaps__n" aria-hidden="true">
                {c.n}
              </span>
              <svg
                class="gaps__icon"
                viewBox="0 0 24 24"
                width="38"
                height="38"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                set:html={ICONS[c.icon]}
              />
            </div>

            <h3 class="gaps__title">{c.title}</h3>
            <p class="gaps__desc">{c.desc}</p>

            <a class="gaps__link" href={services}>
              Learn more
              <span class="gaps__arrow" aria-hidden="true">&#8594;</span>
            </a>
          </li>
        ))
      }
    </ol>

    {/* A quiet handover to the section that does the arithmetic. Kept from the
        previous composition: it is the only route from here to the payback
        model, and the reference neither shows nor removes it. */}
    <div class="gaps__next" data-reveal="2">
      <p class="gaps__next-label">Next / Test the economics</p>
      <p class="gaps__next-text">See when acquisition spend comes back.</p>
      <a class="gaps__next-link" href="#payback">
        Explore the payback model
        <span class="gaps__next-arrow" aria-hidden="true">&#8595;</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* --- header --------------------------------------------------------------- */

  .gaps__head {
    display: grid;
    gap: var(--s6);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 900px) {
    .gaps__head {
      grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
      gap: var(--s16);
      align-items: start;
    }
  }

  .gaps__eyebrow {
    margin-bottom: var(--s6);
  }

  .gaps__h2 {
    font-size: clamp(32px, 4.2vw, 54px);
    line-height: 1.1;
    letter-spacing: var(--ls-h2);
    color: var(--color-text);
  }

  .gaps__lead {
    /* The measure belongs on the element that owns the font size: in `ch` on
       the grid cell it would resolve against 16px and cut this to a third. */
    max-width: 44ch;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-2);
  }

  @media (min-width: 900px) {
    .gaps__lead {
      /* Set against the heading, as drawn, rather than ranged left under it. */
      justify-self: end;
      text-align: right;
      margin-top: 6px;
    }
  }

  /* --- the three columns ---------------------------------------------------- */

  .gaps__list {
    list-style: none;
    margin: clamp(48px, 6vw, 84px) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 860px) {
    .gaps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gaps__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  @media (min-width: 860px) {
    .gaps__item {
      height: 100%;
    }
  }

  /* Hairlines between the columns, and horizontal ones once they stack. No
     boxes: the rule and the whitespace do the separating. */
  .gaps__item + .gaps__item {
    margin-top: clamp(36px, 5vw, 48px);
    padding-top: clamp(36px, 5vw, 48px);
    border-top: 1px solid var(--color-line-strong);
  }

  @media (min-width: 860px) {
    .gaps__item + .gaps__item {
      margin-top: 0;
      padding-top: 0;
      padding-left: clamp(28px, 3.4vw, 56px);
      border-top: 0;
      border-left: 1px solid var(--color-line-strong);
    }

    .gaps__item:not(:last-child) {
      padding-right: clamp(28px, 3.4vw, 56px);
    }
  }

  /* --- number and icon ------------------------------------------------------ */

  .gaps__mark {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s6);
    width: 100%;
  }

  @media (min-width: 860px) {
    /* Stacked on desktop, as drawn; side by side once the column is full width
       and the number would otherwise leave a lot of empty air beside it. */
    .gaps__mark {
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(18px, 2vw, 30px);
    }
  }

  /* Outlined, and decorative. If a browser cannot stroke text it keeps the
     solid fill rather than rendering nothing — the @supports guard is what
     makes the transparent fill safe. */
  .gaps__n {
    font-family: var(--font-heading);
    font-size: clamp(56px, 6.4vw, 82px);
    font-weight: var(--fw-bold);
    line-height: 0.9;
    letter-spacing: 0.01em;
    color: var(--color-line-strong);
  }

  @supports (-webkit-text-stroke: 1px currentColor) {
    .gaps__n {
      color: transparent;
      -webkit-text-stroke: 1.3px var(--color-line-strong);
    }
  }

  .gaps__icon {
    flex: none;
    color: var(--color-accent);
  }

  /* --- column copy ---------------------------------------------------------- */

  .gaps__title {
    margin-top: clamp(22px, 2.6vw, 34px);
    font-size: clamp(22px, 1.9vw, 26px);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    letter-spacing: var(--ls-h3);
    color: var(--color-text);
  }

  .gaps__desc {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-2);
  }

  .gaps__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    /* Pushed to the foot of an equal-height column so all three links sit on
       one line, whatever the description above them does. */
    margin-top: auto;
    padding-top: clamp(14px, 1.6vw, 22px);
    font-size: 16px;
    font-weight: var(--fw-medium);
    text-decoration: none;
    color: var(--color-accent);
  }

  .gaps__link:hover {
    color: var(--color-accent-hover);
  }

  .gaps__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .gaps__arrow {
    transition: transform 180ms var(--ease-out-soft);
  }

  .gaps__link:hover .gaps__arrow {
    transform: translateX(3px);
  }

  /* --- handover ------------------------------------------------------------- */

  .gaps__next {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4) var(--s8);
    margin-top: clamp(48px, 6vw, 84px);
    padding-top: var(--s8);
    border-top: 1px solid var(--color-line);
  }

  .gaps__next-label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .gaps__next-text {
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .gaps__next-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    color: var(--color-accent);
  }

  .gaps__next-link:hover {
    color: var(--color-accent-hover);
  }

  .gaps__next-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .gaps__next-arrow {
    transition: transform 180ms var(--ease-out-soft);
  }

  .gaps__next-link:hover .gaps__next-arrow {
    transform: translateY(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .gaps__arrow,
    .gaps__next-arrow {
      transition: none;
    }

    .gaps__link:hover .gaps__arrow,
    .gaps__next-link:hover .gaps__next-arrow {
      transform: none;
    }
  }
</style>
