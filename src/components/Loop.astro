---
/**
 * The Full Loop, as an actual cycle.
 *
 * The rounded-rectangle diagram is gone, and so is the separate stacked
 * fallback it needed below 1024px. One 3x3 grid at every width: the circle in
 * the centre cell, the four stations at N / E / S / W, so reading order runs
 * clockwise and each card points at the circle. That also removes the "back to
 * 01" marker, which was failing contrast — NOTES.md flagged item 1.
 *
 * One dot travels the ring on `animateMotion`, with a wider outline circle on
 * the same path as a halo. Deliberately no rotating dashed arc: a moving dashed
 * line reads as a broken connection, not a flowing one.
 *
 * Station copy is the export's, in full. The design file abbreviates it; the
 * outcome lines especially are the point of the section.
 */

const stations = [
  {
    n: '01',
    title: 'Instrument',
    body: 'Get the raw signal right at the source. Event taxonomy and naming, a written tracking plan the developers can actually implement, SDK integration and QA, consent and ATT prompt sequencing, debug and sandbox validation before anything ships.',
    outcome:
      'Outcome: Events fire when they should, named what they should be, carrying what they should carry.',
  },
  {
    n: '02',
    title: 'Attribute',
    body: 'Connect the signal to a source. MMP configuration and audit, SKAdNetwork and AdAttributionKit conversion schemas, attribution window alignment, server-to-server events, deferred deep linking, conversion APIs to every ad platform, web-to-app click capture.',
    outcome: 'Outcome: Every install and every dollar traceable to the click that caused it.',
  },
  {
    n: '03',
    title: 'Decide',
    body: 'Turn clean data into a spending decision. Cohort LTV and retention decay, CAC payback curves by channel and by country, trial-to-paid economics, breakeven ceilings per market, paywall funnel diagnosis.',
    outcome:
      'Outcome: A defensible number for what you can afford to pay for a user — market by market.',
  },
  {
    n: '04',
    title: 'Deploy',
    body: 'Spend against those numbers. Google Ads app and web-to-app campaigns, Apple Ads, Meta, TikTok, ASO and store listing strategy, paywall and pricing tests, ad monetisation and mediation.',
    outcome:
      'Outcome: Budget deployed where the arithmetic says it works — and fresh signal flowing back into Station 01.',
  },
];

const byNumber = Object.fromEntries(stations.map((s) => [s.n, s]));

/* Node geometry on the 112px ring, plus a small tangent arrowhead just past
   each node showing the direction of travel. */
const nodes = [
  { n: '01', cx: 150, cy: 38, ny: 43, arrow: '196,46 186,38 190,50' },
  { n: '02', cx: 262, cy: 150, ny: 155, arrow: '254,196 262,186 250,190' },
  { n: '03', cx: 150, cy: 262, ny: 267, arrow: '104,254 114,262 110,250' },
  { n: '04', cx: 38, cy: 150, ny: 155, arrow: '46,104 38,114 50,110' },
];

/* One full turn of the ring, closed. Both the dot and its halo ride this. */
const RING = 'M 150 38 A 112 112 0 1 1 149.9 38 Z';
---

<section id="loop" class="loop section" data-section="loop">
  <div class="wrap">
    <div class="section-head" data-reveal="1">
      <div class="eyebrow">HOW THE WORK IS SEQUENCED</div>
      <h2 class="loop__h2">The Full Loop</h2>
      <p class="section-lead">
        Four stations. The output of the last one is the input to the first. That's the point.
      </p>
    </div>

    <div class="loop__grid">
      {
        (['01', '02', '03', '04'] as const).map((n) => (
          <div class:list={['loop__cell', `loop__cell--${n}`]}>
            <div class="loop__card" data-reveal="1">
              <div class="loop__station">STATION {byNumber[n]!.n}</div>
              <h3 class="loop__title">{byNumber[n]!.title}</h3>
              <p class="loop__body">{byNumber[n]!.body}</p>
              <p class="loop__outcome">{byNumber[n]!.outcome}</p>
            </div>
          </div>
        ))
      }

      <div class="loop__cell loop__cell--ring">
        <svg
          class="loop__svg"
          viewBox="0 0 300 300"
          role="img"
          aria-label="The loop: Instrument, Attribute, Decide, Deploy, feeding back to Instrument"
        >
          <circle cx="150" cy="150" r="112" fill="none" stroke="var(--color-line-strong)" stroke-width="1.5"></circle>

          <circle r="5.5" fill="var(--color-accent)">
            <animateMotion dur="11s" repeatCount="indefinite" path={RING}></animateMotion>
          </circle>
          <circle r="11" fill="none" stroke="var(--color-accent)" stroke-width="1" opacity="0.35">
            <animateMotion dur="11s" repeatCount="indefinite" path={RING}></animateMotion>
          </circle>

          {
            nodes.map((nd) => (
              <g>
                <circle
                  cx={nd.cx}
                  cy={nd.cy}
                  r="19"
                  fill="var(--color-surface)"
                  stroke="var(--color-accent)"
                  stroke-width="1.5"
                />
                <text
                  x={nd.cx}
                  y={nd.ny}
                  text-anchor="middle"
                  font-family="IBM Plex Mono, monospace"
                  font-size="12"
                  font-weight="500"
                  fill="var(--color-accent)"
                >
                  {nd.n}
                </text>
                <polygon points={nd.arrow} fill="var(--color-accent)" />
              </g>
            ))
          }

          <text x="150" y="144" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.8" fill="var(--color-text-4)">SIGNAL IN</text>
          <text x="150" y="163" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.8" fill="var(--color-text-4)">SPEND OUT</text>
        </svg>
      </div>
    </div>

    <p data-reveal="1" class="pull loop__pull">
      Most consultants stop after Station 02. The loop only closes when the same person walks all
      four.
    </p>
  </div>
</section>

<style>
  .loop {
    background: linear-gradient(180deg, var(--color-bg), var(--color-band) 50%, var(--color-bg));
  }


  .loop__h2 {
    margin-top: 16px;
    font-size: var(--t-h2);
    letter-spacing: var(--ls-h2);
  }

  .loop__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px) minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    margin: clamp(40px, 4vw, 64px) auto 0;
    max-width: var(--wrap-loop);
    align-items: center;
  }

  /* Each cell is only a positioning hook; the card inside carries the surface. */
  .loop__cell {
    min-width: 0;
  }

  /* N / E / S / W around the ring, so reading order runs clockwise. */
  .loop__cell--01 {
    grid-column: 2;
    grid-row: 1;
  }
  .loop__cell--02 {
    grid-column: 3;
    grid-row: 2;
  }
  .loop__cell--03 {
    grid-column: 2;
    grid-row: 3;
  }
  .loop__cell--04 {
    grid-column: 1;
    grid-row: 2;
  }
  .loop__cell--ring {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    place-items: center;
    padding: clamp(8px, 1.5vw, 20px);
  }

  /* Each card points at the circle it sits beside. */
  .loop__cell--01 .loop__card,
  .loop__cell--03 .loop__card {
    text-align: center;
  }
  .loop__cell--04 .loop__card {
    text-align: right;
  }

  .loop__card {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 20px;
    box-shadow: var(--ring);
  }

  .loop__station {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .loop__title {
    margin-top: 8px;
    font-size: var(--t-h3-station);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-h3);
  }

  .loop__body {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .loop__outcome {
    margin-top: var(--s4);
    padding-top: var(--s4);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: var(--lh-card);
    color: var(--color-accent);
  }

  .loop__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .loop__pull {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  /* Below 900px the ring cannot hold four cards around it. One column, the
     diagram first, then the stations in order — the same reading order the
     ring encodes. */
  @media (max-width: 900px) {
    .loop__grid {
      grid-template-columns: 1fr;
      gap: var(--s4);
    }

    .loop__cell--ring {
      grid-column: 1;
      grid-row: 1;
      max-width: 300px;
      margin: 0 auto;
    }

    .loop__cell--01 {
      grid-column: 1;
      grid-row: 2;
    }
    .loop__cell--02 {
      grid-column: 1;
      grid-row: 3;
    }
    .loop__cell--03 {
      grid-column: 1;
      grid-row: 4;
    }
    .loop__cell--04 {
      grid-column: 1;
      grid-row: 5;
    }

    .loop__cell--01 .loop__card,
    .loop__cell--03 .loop__card,
    .loop__cell--04 .loop__card {
      text-align: left;
    }
  }

  /* The travelling dot is the only continuous motion here. */
  @media (prefers-reduced-motion: reduce) {
    .loop__svg :global(animateMotion) {
      display: none;
    }
  }
</style>
