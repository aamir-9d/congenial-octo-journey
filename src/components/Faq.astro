---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
import { GROUP_A, GROUP_B, toHtml } from '../data/faq';
import { SERVICES } from '../data/services';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const serviceName = (slug: string) => SERVICES.find((s) => s.slug === slug)?.name;

/**
 * Nineteen questions in two groups.
 *
 * Board: design/v3/Faq.dc.html. Each group is its own section: the group's
 * heading and one small card in the left columns, its accordion in the right.
 * The page's h1 is in the <PageHero> above this component.
 *
 * All nineteen answers are unchanged and still come from src/data/faq.ts, so
 * Schema.astro's FAQPage JSON-LD needs no change and cannot drift.
 * tests/faq.test.ts reads `<details class="faq__item"` and `<p class="faq__a"`
 * from the built page: keep those two exactly, every answer in the HTML, and
 * one row open in each group.
 *
 * The rows are native <details>, so they open without a script and the
 * browser's find-in-page reaches a closed answer.
 */

/* The label above each group says how many questions it holds, counted from
   the data. */
const WORDS = [
  'Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten',
  'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen',
  'Nineteen', 'Twenty',
];
const count = (n: number) => `${WORDS[n] ?? n} questions`;

const audit = SERVICES[0]!;

interface Card {
  href: string;
  icon: IconName;
  title: string;
  text: string;
  go: string;
  glow: string;
}

const groups: { id: string; label: string; lead: string; items: typeof GROUP_A; card: Card }[] = [
  {
    id: 'working-together',
    label: 'Working together',
    lead: 'Price, timeline, access and scope, answered.',
    items: GROUP_A,
    card: {
      href: `${base}/#contact`,
      icon: 'paper-plane-tilt',
      title: 'A 30-minute call, no pitch.',
      text: "I'll name the specific gaps I can see and what each one is likely costing.",
      go: 'Book a call',
      glow: '--gx:0%;--gy:100%',
    },
  },
  {
    id: 'technical-scope',
    label: 'Technical scope',
    lead: 'MMPs, SKAdNetwork, web-to-app and subscription revenue.',
    items: GROUP_B,
    card: {
      href: `${base}/services/${audit.slug}`,
      icon: 'magnifying-glass',
      title: audit.name,
      text: audit.summary,
      go: 'Start here',
      glow: '--gx:100%;--gy:0%',
    },
  },
];
---

<div id="faq" data-section="faq">
  {
    groups.map((g) => (
      <section id={g.id} class="section faq__section" data-section={`faq-${g.id}`}>
        <div class="wrap faq__grid">
          <div class="faq__head" data-reveal="1">
            <p class="shead__label">{count(g.items.length)}</p>
            <h2 class="faq__title">{g.label}</h2>
            <p class="faq__lead">{g.lead}</p>
          </div>

          <div class="faq__list">
            {g.items.map((item, i) => (
              <details class="faq__item" open={i === 0}>
                <summary class="faq__q">
                  <span class="faq__q-text">{item.q}</span>
                  <span class="faq__sign" aria-hidden="true" />
                </summary>
                <p class="faq__a" set:html={toHtml(item.a)} />
                {item.service && serviceName(item.service) && (
                  <a class="faq__more" href={`${base}/services/${item.service}`}>
                    {serviceName(item.service)}
                    <Icon name="arrow-right" size={13} />
                  </a>
                )}
              </details>
            ))}
          </div>

          <a class="gcard faq__card" href={g.card.href} style={g.card.glow}>
            <span class="gcard__icon">
              <Icon name={g.card.icon} size={22} />
            </span>
            <span class="faq__card-title">{g.card.title}</span>
            <span class="faq__card-text">{g.card.text}</span>
            <span class="gcard__go">
              {g.card.go}
              <Icon name="arrow-right" size={13} />
            </span>
          </a>
        </div>
      </section>
    ))
  }
</div>

<style>
  .faq__section + .faq__section {
    padding-top: 0;
  }

  /* One column on a phone, in reading order: heading, questions, card. From
     900px the heading and the card share the left columns and the accordion
     takes the right, spanning both rows. */
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s12);
  }

  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(32px, 5vw, 72px);
      row-gap: var(--s16);
      align-items: start;
    }

    .faq__head {
      grid-column: 1;
      grid-row: 1;
    }

    .faq__card {
      grid-column: 1;
      grid-row: 2;
      max-width: 360px;
    }

    .faq__list {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  .faq__head {
    min-width: 0;
  }

  .faq__title {
    margin-top: var(--s6);
    font-size: clamp(28px, 3.1vw, 44px);
    letter-spacing: var(--ls-h2);
    line-height: var(--lh-h2);
  }

  .faq__lead {
    margin-top: var(--s6);
    max-width: 34ch;
    font-size: var(--t-section-lead);
    color: var(--color-text-2);
  }

  .faq__card {
    padding: 28px;
  }

  .faq__card-title {
    margin-top: var(--s6);
    font-size: 20px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-snug);
    line-height: 1.25;
  }

  .faq__card-text {
    margin-top: 10px;
    font-size: 15.5px;
    color: var(--color-text-2);
  }

  /* --- Accordion ---------------------------------------------------------- */
  .faq__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s4);
    min-width: 0;
  }

  .faq__item {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-width: 0;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--ring);
    transition: box-shadow 200ms var(--ease-out-soft);
  }

  /* The open row is the lead card of its group: amber ring, full corner glow. */
  .faq__item::before {
    content: '';
    position: absolute;
    z-index: -1;
    right: -90px;
    top: -110px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--rgb-accent)), transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms var(--ease-out-soft);
  }

  .faq__item[open] {
    box-shadow: var(--ring-accent);
  }

  .faq__item[open]::before {
    opacity: var(--glow-lead);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s8);
    min-height: 76px;
    padding: 18px 22px 18px 30px;
    cursor: pointer;
    list-style: none;
    font-size: clamp(17px, 1.5vw, 19px);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-snug);
    line-height: 1.3;
  }

  .faq__q:focus-visible {
    outline-offset: -4px;
    border-radius: var(--radius-lg);
  }

  .faq__item[open] .faq__q {
    font-weight: var(--fw-bold);
  }

  .faq__q-text {
    min-width: 0;
  }

  /* Plus when closed, minus on a filled disc when open: two bars, the upright
     one turning flat. */
  .faq__sign {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    color: var(--color-accent-text);
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2.4px;
    margin: -1.2px 0 0 -7px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 200ms var(--ease-out-soft);
  }

  .faq__sign::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__sign {
    background: var(--color-accent);
    box-shadow: none;
    color: var(--color-ink);
  }

  .faq__item[open] .faq__sign::after {
    transform: rotate(0deg);
  }

  .faq__a {
    padding: 0 30px 30px;
    max-width: 72ch;
    font-size: var(--t-section-lead);
    line-height: var(--lh-answer);
    color: var(--color-text-2);
  }

  .faq__a :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-text);
  }

  /* Link to the specialist page under an answer. */
  .faq__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin: -18px 30px 18px;
    font-size: var(--t-body-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-accent-text);
  }

  @media (max-width: 767px) {
    .faq__q {
      min-height: 64px;
      gap: var(--s6);
      padding: 14px 16px 14px 20px;
    }

    .faq__sign {
      width: 32px;
      height: 32px;
    }

    .faq__a {
      padding: 0 20px 22px;
      font-size: 15.5px;
    }

    .faq__more {
      margin: -12px 20px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item,
    .faq__item::before,
    .faq__sign::before,
    .faq__sign::after {
      transition: none;
    }
  }
</style>
