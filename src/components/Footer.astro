---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* The export pointed Privacy and Terms at `#`, since neither page existed.
   They exist now, so the links resolve. */
const links = [
  { href: '#services', label: 'Services' },
  { href: '#loop', label: 'The Loop' },
  { href: '#approach', label: 'Approach' },
  { href: `${base}/blog`, label: 'Blog' },
  { href: 'mailto:hello@e2eapps.com', label: 'hello@e2eapps.com' },
];
---

<footer class="footer">
  <div class="footer__top">
    <div class="footer__brand">
      <div class="footer__logo">E2E Apps</div>
      <p class="footer__tagline">
        One specialist owns the entire growth loop &#8212; a second owns the infrastructure it runs
        on.
      </p>
    </div>
    <div class="footer__links">
      {links.map((l) => <a href={l.href} class="footer__link">{l.label}</a>)}
      <a
        href="https://www.linkedin.com/in/aamir-jan-khan/"
        target="_blank"
        rel="noopener"
        class="footer__link">LinkedIn</a
      >
    </div>
  </div>

  <div class="footer__legal">
    <span>&#169; 2026 E2E Apps &#183; e2eapps.com</span>
    <span class="footer__legal-links">
      <a href={`${base}/privacy`} class="footer__link footer__link--dim">Privacy</a>
      <a href={`${base}/terms`} class="footer__link footer__link--dim">Terms</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(44px, 5vw, 72px) var(--gutter) 32px;
    background: var(--color-band);
    border-top: 1px solid var(--color-line-soft);
  }

  .footer__top {
    max-width: var(--wrap);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer__brand {
    max-width: 38ch;
  }

  /* Was `color: var(--color-text)`, which the compatibility shim resolved to the
     page ground — 1.02:1 against the footer. Invisible, and only found by
     auditing the shim rather than by looking at the page. */
  .footer__logo {
    font-size: 19px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-brand);
    color: var(--color-text);
  }

  .footer__tagline {
    margin-top: 10px;
    font-size: var(--t-card-sm);
    line-height: var(--lh-prose);
    color: var(--color-text-3);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 40px);
    font-size: var(--t-card-sm);
    color: var(--color-text-2);
  }

  .footer__link {
    transition: color 160ms var(--ease-out-soft);
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  .footer__legal {
    max-width: var(--wrap);
    margin: 36px auto 0;
    padding-top: 20px;
    border-top: 1px solid var(--color-line-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--color-text-4);
  }

  .footer__legal-links {
    display: flex;
    gap: 22px;
  }

  .footer__link--dim {
    color: var(--color-text-4);
  }
</style>
