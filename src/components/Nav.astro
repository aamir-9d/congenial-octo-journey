---
import Icon from './Icon.astro';

/**
 * Sticky full-width bar, not a floating pill.
 *
 * The pill was `position: fixed` with a 16px inset, which meant every page had
 * to reserve 48px of extra top padding to clear it and in-page anchors needed a
 * 96px scroll margin. A sticky bar occupies its own space, so both go away.
 *
 * The mobile sheet below 480px is the next commit — NOTES.md flagged item 4,
 * where the links simply vanished with nothing replacing them.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: '#services', label: 'Services' },
  { href: '#loop', label: 'The Loop' },
  { href: '#approach', label: 'Approach' },
  { href: `${base}/blog`, label: 'Blog' },
  { href: '#faq', label: 'FAQ' },
];
---

<nav class="nav">
  <div class="nav__bar">
    <a href="#top" class="nav__logo">E2E Apps</a>

    <div id="nav-links" class="nav__links">
      {links.map((l) => <a href={l.href} class="nav__link">{l.label}</a>)}
    </div>

    <a href="#contact" class="nav__cta">
      Book a call
      <Icon name="arrow-up-right" size={13} />
    </a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 90;
    background: rgba(14, 16, 20, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-line-soft);
  }

  .nav__bar {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 14px var(--gutter);
  }

  .nav__logo {
    font-size: 18px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-brand);
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    gap: clamp(14px, 2vw, 26px);
    margin-left: auto;
    align-items: center;
    font-size: var(--t-card-sm);
    white-space: nowrap;
    color: var(--color-text-2);
  }

  .nav__link {
    transition: color 160ms var(--ease-out-soft);
  }

  .nav__link:hover {
    color: var(--color-accent);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: var(--t-card-sm);
    font-weight: var(--fw-semibold);
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-ink);
    white-space: nowrap;
    box-shadow: 0 0 0 0 rgba(var(--rgb-accent), 0);
    transition:
      background 160ms var(--ease-out-soft),
      box-shadow 160ms var(--ease-out-soft);
  }

  .nav__cta:hover {
    background: var(--color-accent-hover);
    box-shadow: var(--shadow-accent-sm);
  }

  /* Below 480px the links hide and the CTA takes the auto margin they leave
     behind, so the bar does not collapse to the left. The hamburger and the
     full-screen sheet land in the mobile commit. */
  @media (max-width: 480px) {
    .nav__links {
      display: none;
    }

    .nav__cta {
      margin-left: auto;
    }
  }
</style>
