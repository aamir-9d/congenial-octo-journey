---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

/**
 * A single post.
 *
 * Canonical points at this page, not at LinkedIn: the site should be able to
 * rank for its own author's work. The original is credited visibly at the foot
 * instead. If you would rather consolidate the signal onto LinkedIn, the change
 * is one line in Base.astro's canonical — say so and I will flip it.
 */

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title={`${post.data.title} — E2E Apps`}
  description={post.data.kicker}
  path={`/blog/${post.id}`}
>
  <div class="page">
    <Nav />

    <article class="section">
      <div class="post">
        <a class="post__back" href={`${base}/blog`}>&#8592; All posts</a>

        <div class="post__meta">
          <span class="post__tag">{post.data.tag}</span>
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time>
        </div>

        <h1 class="post__title">{post.data.title}</h1>
        <p class="post__kicker">{post.data.kicker}</p>

        <div class="post__body">
          <Content />
        </div>

        <aside class="post__cta">
          <p class="post__cta-text">{post.data.cta}</p>
          <a class="btn-primary post__cta-btn" href={`${base}/#contact`}>
            Book a call
            <Icon name="arrow-right" size={14} />
          </a>
        </aside>

        {
          post.data.source && (
            <p class="post__source">
              First published on{' '}
              <a class="link" href={post.data.source} target="_blank" rel="noopener">
                LinkedIn &#8599;
              </a>
            </p>
          )
        }
      </div>
    </article>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  .section {
    padding-top: calc(var(--section-pad) + 48px);
  }

  .post {
    max-width: 760px;
    margin: 0 auto;
  }

  .post__back {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-accent);
    text-decoration: none;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s6);
    margin-top: var(--s12);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-text-4);
  }

  .post__tag {
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .post__title {
    margin-top: var(--s6);
    font-size: var(--t-h2);
    color: var(--color-text);
  }

  .post__kicker {
    margin-top: var(--s8);
    font-size: var(--t-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  /* The article body is rendered Markdown, so these have to reach elements
     this component does not itself declare. */
  .post__body {
    margin-top: var(--s16);
    padding-top: var(--s12);
    border-top: 1px solid var(--color-line);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .post__body :global(h2) {
    margin-top: var(--s16);
    font-size: var(--t-h3-station);
    color: var(--color-text);
  }

  .post__body :global(h3) {
    margin-top: var(--s12);
    font-size: var(--t-post-title);
    color: var(--color-text);
  }

  .post__body :global(p),
  .post__body :global(ul),
  .post__body :global(ol) {
    margin-top: var(--s6);
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: var(--s8);
  }

  .post__body :global(li) {
    margin-top: var(--s3);
  }

  .post__body :global(strong) {
    color: var(--color-text);
  }

  .post__body :global(a) {
    color: var(--color-accent);
    border-bottom: 1px solid rgba(var(--rgb-accent), 0.35);
  }

  /* Inline code. Fenced blocks are Shiki's <pre><code> and are handled below. */
  .post__body :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-surface);
    border-radius: 3px;
    padding: 0.12em 0.35em;
  }

  .post__body :global(pre) {
    margin-top: var(--s6);
    padding: var(--s6) var(--s8);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line);
    /* Long lines scroll inside the block rather than widening the page. */
    overflow-x: auto;
    font-size: var(--t-mono);
    line-height: var(--lh-prose);
  }

  /* Figures.

     Markdown gives no way to mark up a <figure>, so an image followed by an
     italic line on the next line lands in one <p> and is styled as one. The
     height cap does the work a width cap cannot: the charts are landscape and
     the paywall screenshot is a 1125x2436 phone capture, so constraining
     height keeps the portrait one from running a full screen tall while the
     landscape ones still fill the measure. */
  .post__body :global(p:has(img)) {
    margin-top: var(--s12);
    text-align: center;
  }

  .post__body :global(p img) {
    max-width: 100%;
    max-height: 520px;
    width: auto;
    height: auto;
    border-radius: var(--radius-sm);
    /* A hairline, so a screenshot with a light ground does not float on the
       dark page with no edge. */
    box-shadow: var(--ring);
  }

  .post__body :global(p:has(img) em) {
    display: block;
    margin-top: var(--s4);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    font-style: normal;
    line-height: var(--lh-snug);
    color: var(--color-text-4);
  }

  /* Original diagrams, drawn in the site's own palette rather than lifted
     from a source deck. <figure> because they carry a caption that is part of
     the argument, not a label. */
  .post__body :global(figure) {
    margin: var(--s12) 0 0;
    padding: var(--s8);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--ring);
    overflow-x: auto;
  }

  .post__body :global(figure svg) {
    display: block;
    width: 100%;
    height: auto;
    /* The diagrams are drawn on a fixed viewBox; below this they stop being
       legible and should scroll inside the figure instead of shrinking. */
    min-width: 460px;
  }

  .post__body :global(figcaption) {
    margin-top: var(--s6);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    line-height: var(--lh-body);
    color: var(--color-text-4);
  }

  /* Case studies carry comparison tables. Wrapped in its own scroller so a
     wide table never widens the page -- the same rule the site holds itself
     to at phone width. */
  .post__body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin-top: var(--s8);
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: var(--lh-snug);
  }

  .post__body :global(thead) {
    border-bottom: 1px solid var(--color-line);
  }

  .post__body :global(th) {
    padding: var(--s3) var(--s6) var(--s3) 0;
    text-align: left;
    white-space: nowrap;
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    font-size: var(--t-mono-2xs);
    color: var(--color-text-4);
  }

  .post__body :global(td) {
    padding: var(--s3) var(--s6) var(--s3) 0;
    border-top: 1px solid var(--color-line-soft);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* The row label reads as prose, the figures as data. */
  .post__body :global(td:first-child) {
    white-space: normal;
    font-family: var(--font-body);
    color: var(--color-text-4);
  }

  .post__body :global(td strong) {
    color: var(--color-accent);
    font-weight: var(--fw-regular);
  }

  .post__body :global(blockquote) {
    margin-top: var(--s6);
    padding-left: var(--s6);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-4);
  }

  /* Closing CTA. Every post carries one, tailored to what it just argued --
     the copy comes from the post's own frontmatter, so the technical articles
     close on the failure mode they imply rather than on a generic pitch. */
  .post__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s6);
    margin-top: var(--s16);
    padding: var(--s8);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--ring-accent);
  }

  .post__cta-text {
    flex: 1;
    min-width: min(100%, 34ch);
    margin: 0;
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .post__cta-btn {
    flex: none;
  }

  @media (max-width: 640px) {
    .post__cta {
      padding: var(--s6);
      gap: var(--s4);
    }

    .post__cta-btn {
      width: 100%;
      justify-content: center;
      min-height: 52px;
    }
  }

  .post__source {
    margin-top: var(--s16);
    padding-top: var(--s8);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-text-4);
  }
</style>
