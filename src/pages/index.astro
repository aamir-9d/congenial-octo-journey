---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Proof from '../components/Proof.astro';
import PaybackTeaser from '../components/PaybackTeaser.astro';
import Automation from '../components/Automation.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Loop from '../components/Loop.astro';
// Founders is hidden on the homepage until the portraits exist; see below.
// import Founders from '../components/Founders.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

/**
 * The homepage.
 *
 * Restructured on 27 November 2026 so the page follows one line of argument:
 * what is sold, the track record, the services, the evidence, the method, then
 * the ask. Before this it opened on attribution, moved to "three checks" and a
 * full payback calculator, and only reached the services and the way of
 * working at the bottom. The owner's verdict was that a visitor could not tell
 * what was being sold.
 *
 *   Hero           the service and the buyer, and one action
 *   Stats          four figures, each read from the file that owns it
 *   ServiceIndex   what I do: the specialist services, audit first
 *   Proof          what audits turn up, with a link to the findings page
 *   CaseStudy      one case, shown all the way down
 *   Loop           how the work runs
 *   PaybackTeaser  a pointer to the calculator on /payback-calculator
 *   Automation     ongoing reporting
 *   Founders       HIDDEN for now: no portraits yet. /about shows both.
 *   Contact        the one action, again
 *
 * Off this page, not deleted: the full calculator (on /payback-calculator)
 * and Problems (on /services). The "three checks" block (Diagnostics.astro) is
 * removed; its three links are covered by the services grid. Git history has it.
 *
 * Proof is a full section again rather than the nested tail of the case
 * study, because it now comes before the case.
 */

const title = 'Mobile Attribution Audits & Fixes for Subscription Apps — E2E Apps';
/* One constant feeds the meta description, og:description and
   twitter:description. Kept in step with the hero: a search snippet or a
   shared link that advertises a claim the page no longer makes is a
   promise broken before the visitor arrives. */
const description =
  'Mobile attribution audits and fixes for subscription apps. I find what your MMP setup gets wrong, fix it at the source, and show which campaigns pay back.';
---

<Base title={title} description={description} path="/">
  <Schema slot="head" />
  <div class="page">
    <Nav />
    <main id="main">
      <Hero />
      <Stats />
      <ServiceIndex eyebrow="WHAT I DO" />
      <Proof />
      <CaseStudy />
      <Loop />
      <PaybackTeaser />
      <Automation />
      {/* Hidden until the founder portraits exist. To bring it back, restore
          the import above and this line:
      <Founders />
      */}
      <Contact />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
    /* `clip`, not `hidden` — see global.css. `hidden` makes this a scroll
       container and the sticky nav sticks to it instead of the viewport. */
    overflow-x: clip;
  }
</style>
