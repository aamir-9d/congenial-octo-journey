---
import { AUDIT_COUNT } from '../data/findings';
import { SERVICES } from '../data/services';
import { PORTFOLIO_APPS, YEARS } from '../data/authors';

/**
 * Four figures directly under the hero: the track record, before the services.
 *
 * Every number is imported from the file that already owns it, so this strip
 * cannot say something the rest of the site does not. tests/pages.test.ts
 * compares the rendered figures with those constants.
 *
 * New section (27 November 2026), so it is marked `data-added` and the
 * copy-parity comparison leaves it out.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stats: { value: string; label: string; href?: string }[] = [
  {
    value: String(AUDIT_COUNT),
    label: 'attribution audits behind the published findings',
    href: `${base}/mmp-audit-findings`,
  },
  { value: String(SERVICES.length), label: 'specialist services, one problem each', href: '#specialist' },
  { value: PORTFOLIO_APPS, label: 'iOS and Android apps in the portfolio I run growth for' },
  { value: String(YEARS.count), label: 'years across measurement and ad platforms' },
];
---

<section class="stats" data-section="stats" data-added="structure-2026-11" aria-label="Track record">
  <div class="wrap">
    <dl class="stats__row">
      {
        stats.map((s) => (
          <div class="stats__item">
            <dt class="stats__label">
              {s.href ? <a href={s.href}>{s.label}</a> : s.label}
            </dt>
            <dd class="stats__value tabular">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    padding: 0 var(--gutter) var(--s16);
  }

  .stats__row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--ring);
  }

  /* Value above label on screen; label first in the source, because a
     definition list reads term then description. */
  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--s2);
    padding: var(--s6);
  }

  .stats__item + .stats__item {
    border-left: 1px solid var(--color-line);
  }

  .stats__value {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--t-stat);
    font-weight: var(--fw-bold);
    line-height: var(--lh-flat);
    color: var(--color-accent);
  }

  .stats__label {
    font-size: var(--t-card-sm);
    line-height: var(--lh-snug);
    color: var(--color-text-2);
  }

  .stats__label a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 3px;
  }

  .stats__label a:hover {
    color: var(--color-text);
  }

  @media (max-width: 767px) {
    .stats {
      padding-bottom: var(--s12);
    }

    .stats__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats__item {
      padding: var(--s4);
    }

    .stats__item + .stats__item {
      border-left: 0;
    }

    .stats__item:nth-child(even) {
      border-left: 1px solid var(--color-line);
    }

    .stats__item:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }
  }
</style>
