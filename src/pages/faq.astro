---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import Schema from '../components/Schema.astro';

/**
 * FAQ.
 *
 * This was 29% of the homepage -- 1,211 words and nineteen disclosures, more
 * than any other section, sitting in front of visitors who had not yet asked
 * a question. It is reference material and belongs on a page people arrive at
 * deliberately.
 *
 * Every question and answer is unchanged; src/data/faq.ts is still the single
 * source, and it still feeds the FAQPage structured data.
 */

const title = 'FAQ - E2E Apps';
const description =
  'Nineteen questions about working together and technical scope: pricing, timelines, access, what happens if nothing is wrong, MMPs, SKAdNetwork, web-to-app and subscription revenue.';
---

<Base title={title} description={description} path="/faq">
  <Schema slot="head" faq />
  <div class="page">
    <Nav />


    <Faq lead />

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }



</style>
