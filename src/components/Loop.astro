---
import Icon from './Icon.astro';
/**
 * The Full Loop, as an actual cycle.
 *
 * The rounded-rectangle diagram is gone, and so is the separate stacked
 * fallback it needed below 1024px. One 3x3 grid at every width: the circle in
 * the centre cell, the four stations at N / E / S / W, so reading order runs
 * clockwise and each card points at the circle. That also removes the "back to
 * 01" marker, which was failing contrast — NOTES.md flagged item 1.
 *
 * One dot travels the ring on `animateMotion`, with a wider outline circle on
 * the same path as a halo. Deliberately no rotating dashed arc: a moving dashed
 * line reads as a broken connection, not a flowing one.
 *
 * Station copy is the export's, in full. The design file abbreviates it; the
 * outcome lines especially are the point of the section.
 */

const stations = [
  {
    n: '01',
    title: 'Instrument',
    body: 'Get the raw signal right at the source. Event taxonomy and naming, a written tracking plan the developers can actually implement, SDK integration and QA, consent and ATT prompt sequencing, debug and sandbox validation before anything ships.',
    outcome:
      'Outcome: Events fire when they should, named what they should be, carrying what they should carry.',
    lead: 'Event taxonomy, a written tracking plan, SDK integration and QA, consent and ATT sequencing.',
    out: 'Events fire when they should, carrying what they should.',
    delay: '0s',
  },
  {
    n: '02',
    title: 'Attribute',
    body: 'Connect the signal to a source. MMP configuration and audit, SKAdNetwork and AdAttributionKit conversion schemas, attribution window alignment, server-to-server events, deferred deep linking, conversion APIs to every ad platform, web-to-app click capture.',
    outcome: 'Outcome: Every install and every dollar traceable to the click that caused it.',
    lead: 'MMP audit, SKAN and AdAttributionKit schemas, server-to-server events, web-to-app capture.',
    out: 'Every dollar traceable to the click that caused it.',
    delay: '1.3s',
  },
  {
    n: '03',
    title: 'Decide',
    body: 'Turn clean data into a spending decision. Cohort LTV and retention decay, CAC payback curves by channel and by country, trial-to-paid economics, breakeven ceilings per market, paywall funnel diagnosis.',
    outcome:
      'Outcome: A defensible number for what you can afford to pay for a user — market by market.',
    lead: 'Cohort LTV, payback curves by channel and country, breakeven ceilings per market.',
    out: 'A defensible number for what a user is worth.',
    delay: '2.6s',
  },
  {
    n: '04',
    title: 'Deploy',
    body: 'Spend against those numbers. Google Ads app and web-to-app campaigns, Apple Ads, Meta, TikTok, ASO and store listing strategy, paywall and pricing tests, ad monetisation and mediation.',
    outcome:
      'Outcome: Budget deployed where the arithmetic says it works — and fresh signal flowing back into Station 01.',
    lead: 'Google, Apple Ads, Meta, TikTok, ASO and pricing — spent against those numbers.',
    out: 'Budget where the arithmetic says it works.',
    delay: '3.9s',
  },
];

const byNumber = Object.fromEntries(stations.map((s) => [s.n, s]));

/* Node geometry on the 112px ring, plus a small tangent arrowhead just past
   each node showing the direction of travel. */
const nodes = [
  { n: '01', cx: 150, cy: 38, ny: 43, arrow: '196,46 186,38 190,50' },
  { n: '02', cx: 262, cy: 150, ny: 155, arrow: '254,196 262,186 250,190' },
  { n: '03', cx: 150, cy: 262, ny: 267, arrow: '104,254 114,262 110,250' },
  { n: '04', cx: 38, cy: 150, ny: 155, arrow: '46,104 38,114 50,110' },
];

/* One full turn of the ring, closed. Both the dot and its halo ride this. */
const RING = 'M 150 38 A 112 112 0 1 1 149.9 38 Z';
---

<section id="loop" class="loop section" data-section="loop">
  <div class="wrap">
    <div class="section-head" data-reveal="1">
      <div class="eyebrow">HOW THE WORK IS SEQUENCED</div>
      <h2 class="loop__h2">The Full Loop</h2>
      <p class="section-lead">
        Four stations. The output of the last one is the input to the first. That's the point.
      </p>
    </div>

    <div class="loop__grid">
      {
        (['01', '02', '03', '04'] as const).map((n) => (
          <div class:list={['loop__cell', `loop__cell--${n}`]}>
            <div class="loop__card" data-reveal="1">
              {/* The rail is the loop on a phone. It is inside the card rather
                  than a second copy of the section, so the station content
                  exists once and the accessibility tree stays clean. */}
              <div class="loop__rail" aria-hidden="true">
                <span class="loop__node" style={`--node-delay:${byNumber[n]!.delay}`}>
                  {byNumber[n]!.n}
                </span>
                <span class="loop__line"></span>
              </div>
              <div class="loop__content">
                <div class="loop__station">STATION {byNumber[n]!.n}</div>
                <h3 class="loop__title">{byNumber[n]!.title}</h3>
                <p class="loop__body wide-only">{byNumber[n]!.body}</p>
                <p class="loop__lead narrow-only">{byNumber[n]!.lead}</p>
                <p class="loop__outcome wide-only">{byNumber[n]!.outcome}</p>
                <p class="loop__out narrow-only">{byNumber[n]!.out}</p>
              </div>
            </div>
          </div>
        ))
      }

      {/* The circle never showed the return on a phone. This does: the path
          drops out of station 04 and turns back toward 01. */}
      <div class="loop__return" data-reveal="1">
        <svg viewBox="0 0 36 76" role="img" aria-label="The output of Station 04 returns to Station 01">
          <path d="M18 0 L18 44 Q18 60 34 60" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.75"></path>
        </svg>
        <p class="loop__return-note">
          <Icon name="arrow-u-left-up" size={17} />
          <span>Fresh signal flows back into Station 01. That's the loop closing.</span>
        </p>
      </div>

      <div class="loop__cell loop__cell--ring">
        <svg
          class="loop__svg"
          viewBox="0 0 300 300"
          role="img"
          aria-label="The loop: Instrument, Attribute, Decide, Deploy, feeding back to Instrument"
        >
          <circle cx="150" cy="150" r="112" fill="none" stroke="var(--color-line-strong)" stroke-width="1.5"></circle>

          <circle r="5.5" fill="var(--color-accent)">
            <animateMotion dur="11s" repeatCount="indefinite" path={RING}></animateMotion>
          </circle>
          <circle r="11" fill="none" stroke="var(--color-accent)" stroke-width="1" opacity="0.35">
            <animateMotion dur="11s" repeatCount="indefinite" path={RING}></animateMotion>
          </circle>

          {
            nodes.map((nd) => (
              <g>
                <circle
                  cx={nd.cx}
                  cy={nd.cy}
                  r="19"
                  fill="var(--color-surface)"
                  stroke="var(--color-accent)"
                  stroke-width="1.5"
                />
                <text
                  x={nd.cx}
                  y={nd.ny}
                  text-anchor="middle"
                  font-family="IBM Plex Mono, monospace"
                  font-size="12"
                  font-weight="500"
                  fill="var(--color-accent)"
                >
                  {nd.n}
                </text>
                <polygon points={nd.arrow} fill="var(--color-accent)" />
              </g>
            ))
          }

          <text x="150" y="144" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.8" fill="var(--color-text-4)">SIGNAL IN</text>
          <text x="150" y="163" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.8" fill="var(--color-text-4)">SPEND OUT</text>
        </svg>
      </div>
    </div>

    <p data-reveal="1" class="pull loop__pull">
      Most consultants stop after Station 02. The loop only closes when the same person walks all
      four.
    </p>
  </div>
</section>

<style>
  .loop {
    background: linear-gradient(180deg, var(--color-bg), var(--color-band) 50%, var(--color-bg));
  }


  .loop__h2 {
    margin-top: 16px;
    font-size: var(--t-h2);
    letter-spacing: var(--ls-h2);
  }

  .loop__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(min(260px, 100%), 340px) minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    margin: clamp(40px, 4vw, 64px) auto 0;
    max-width: var(--wrap-loop);
    align-items: center;
  }

  /* Each cell is only a positioning hook; the card inside carries the surface. */
  .loop__cell {
    min-width: 0;
  }

  /* N / E / S / W around the ring, so reading order runs clockwise. */
  .loop__cell--01 {
    grid-column: 2;
    grid-row: 1;
  }
  .loop__cell--02 {
    grid-column: 3;
    grid-row: 2;
  }
  .loop__cell--03 {
    grid-column: 2;
    grid-row: 3;
  }
  .loop__cell--04 {
    grid-column: 1;
    grid-row: 2;
  }
  .loop__cell--ring {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    place-items: center;
    padding: clamp(8px, 1.5vw, 20px);
  }

  /* Each card points at the circle it sits beside. */
  .loop__cell--01 .loop__card,
  .loop__cell--03 .loop__card {
    text-align: center;
  }
  .loop__cell--04 .loop__card {
    text-align: right;
  }

  .loop__card {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 20px;
    box-shadow: var(--ring);
  }

  .loop__station {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .loop__title {
    margin-top: 8px;
    font-size: var(--t-h3-station);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-h3);
  }

  .loop__body {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .loop__outcome {
    margin-top: var(--s4);
    padding-top: var(--s4);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: var(--lh-card);
    color: var(--color-accent);
  }

  .loop__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .loop__pull {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  /* Below 900px the ring cannot hold four cards around it. One column, the
     diagram first, then the stations in order — the same reading order the
     ring encodes. */
  @media (max-width: 900px) {
    .loop__grid {
      grid-template-columns: 1fr;
      gap: var(--s4);
    }

    .loop__cell--ring {
      grid-column: 1;
      grid-row: 1;
      max-width: 300px;
      margin: 0 auto;
    }

    .loop__cell--01 {
      grid-column: 1;
      grid-row: 2;
    }
    .loop__cell--02 {
      grid-column: 1;
      grid-row: 3;
    }
    .loop__cell--03 {
      grid-column: 1;
      grid-row: 4;
    }
    .loop__cell--04 {
      grid-column: 1;
      grid-row: 5;
    }

    .loop__cell--01 .loop__card,
    .loop__cell--03 .loop__card,
    .loop__cell--04 .loop__card {
      text-align: left;
    }
  }

  /* --- the phone: a rail, not a circle -------------------------------------

     Below 768px the ring stops being a diagram and becomes decoration sitting
     above four unrelated cards, so the animation and the content explain each
     other to nobody. The rail replaces it: the stations sit ON the line, the
     signal lights each node in turn, and the dashed return path closes it back
     to 01. Same idea, legible at 402px.
     ---------------------------------------------------------------------- */

  .loop__rail,
  .loop__return {
    display: none;
  }

  @media (max-width: 767px) {
    /* One continuous line, so no gap between rows and no card ground. */
    .loop__grid {
      display: block;
    }

    .loop__cell--ring {
      display: none;
    }

    .loop__card {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 14px;
      padding: 0;
      background: none;
      box-shadow: none;
      text-align: left;
    }

    .loop__rail {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .loop__node {
      width: 36px;
      height: 36px;
      flex: none;
      display: grid;
      place-items: center;
      border-radius: 50%;
      border: 1.5px solid var(--color-accent);
      background: var(--color-surface);
      font-family: var(--font-mono);
      font-size: var(--t-mono-sm);
      color: var(--color-accent);
      animation: loop-node 5.2s ease-in-out var(--node-delay) infinite;
    }

    .loop__line {
      width: 2px;
      flex: 1;
      min-height: 20px;
      background: linear-gradient(180deg, rgba(var(--rgb-accent), 0.5), var(--color-line));
    }

    .loop__content {
      padding-bottom: var(--s8);
    }

    .loop__title {
      margin-top: 0;
      font-size: 21px;
      line-height: 1.2;
    }

    .loop__lead {
      margin-top: var(--s2);
      font-size: 13.5px;
      line-height: var(--lh-body);
      color: var(--color-text-2);
    }

    .loop__out {
      margin-top: var(--s3);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: var(--lh-body);
      color: var(--color-accent);
    }

    /* The station kicker is redundant once the number is on the rail. */
    .loop__station {
      display: none;
    }

    .loop__return {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 14px;
    }

    .loop__return svg {
      width: 36px;
      height: 76px;
    }

    .loop__return-note {
      display: flex;
      align-items: center;
      gap: 9px;
      align-self: center;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      background: rgba(var(--rgb-accent), 0.09);
      box-shadow: inset 0 0 0 1px rgba(var(--rgb-accent), 0.28);
      font-size: 13.5px;
      line-height: var(--lh-tight);
      color: var(--color-text);
    }

    .loop__return-note svg {
      flex: none;
      color: var(--color-accent);
    }

    .loop__pull {
      margin-top: var(--s8);
      text-align: left;
    }
  }

  /* The travelling dot is the only continuous motion here. */
  @media (prefers-reduced-motion: reduce) {
    .loop__svg :global(animateMotion) {
      display: none;
    }

    .loop__node {
      animation: none;
    }
  }
</style>
