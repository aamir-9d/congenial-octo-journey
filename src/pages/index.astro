---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Diagnostics from '../components/Diagnostics.astro';
import Proof from '../components/Proof.astro';
import Payback from '../components/Payback.astro';
import Automation from '../components/Automation.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Loop from '../components/Loop.astro';
// Founders is hidden on the homepage until the portraits exist; see below.
// import Founders from '../components/Founders.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

/**
 * The homepage.
 *
 * The sections are the signed-off ones, unchanged. Only their order moved, on
 * 27 November 2026, so the page makes one argument from top to bottom. Before
 * that it opened on attribution, went to "three checks" and the calculator,
 * and reached the way of working, which is what is actually sold, last.
 *
 *   Hero        the service and the buyer, and one action
 *   Loop        01  how the work runs: the four stations are the service
 *   CaseStudy   02  one case, shown all the way down
 *   Proof           three more findings, as its tail
 *   Diagnostics 03  three checks a visitor can run on their own setup
 *   Payback     04  the payback map: test it with your own numbers
 *   Automation      ongoing reporting, once the problem and evidence have landed
 *   Founders        HIDDEN for now: no portraits yet. /about shows both.
 *   Contact         the one action, again
 *
 * Diagnostics stays directly above Payback: its closing line points down at
 * the payback map. Proof stays a SIBLING of CaseStudy, not a child: CaseStudy
 * is marked data-added and the copy-parity check strips such blocks whole,
 * which would take Proof's signed-off copy with it.
 *
 * A same-day attempt replaced several sections with new ones (a stats strip,
 * a services grid, a calculator pointer). The owner preferred the originals;
 * they are back and the new ones are deleted.
 */

const title = 'Mobile Attribution Audits & Fixes for Subscription Apps — E2E Apps';
/* One constant feeds the meta description, og:description and
   twitter:description. Kept in step with the hero: a search snippet or a
   shared link that advertises a claim the page no longer makes is a
   promise broken before the visitor arrives. */
const description =
  'Mobile attribution audits and fixes for subscription apps. I find what your MMP setup gets wrong, fix it at the source, and show which campaigns pay back.';
---

<Base title={title} description={description} path="/">
  <Schema slot="head" />
  <div class="page">
    <Nav />
    <main id="main">
      <Hero />
      <Loop />
      <CaseStudy />
      <Proof nested />
      <Diagnostics />
      <Payback eyebrow="04 / The payback map" />
      <Automation />
      {/* Hidden until the founder portraits exist. To bring it back, restore
          the import above and this line:
      <Founders />
      */}
      <Contact />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
    /* `clip`, not `hidden` — see global.css. `hidden` makes this a scroll
       container and the sticky nav sticks to it instead of the viewport. */
    overflow-x: clip;
  }
</style>
