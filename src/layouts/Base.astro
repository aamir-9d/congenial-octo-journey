---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Path relative to the site root, e.g. "/privacy". Used for the canonical URL. */
  path?: string;
  /** Suppress indexing — used by 404. */
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}${p}`;

const canonical = new URL(`${base}${path === '/' ? '/' : path}`, Astro.site).href;
const ogImage = new URL(asset('/og-image.png'), Astro.site).href;

/* One list, two consumers: the preload links and the @font-face src below.
   Keeping them in step is what stops a preload from fetching a URL the CSS
   never asks for (which Chrome warns about and which wastes the round trip). */
const FONTS = {
  archivo: asset('/fonts/archivo-var-latin.woff2'),
  sans: asset('/fonts/ibm-plex-sans-var-latin.woff2'),
  mono: asset('/fonts/ibm-plex-mono-400-latin.woff2'),
};

/* Google's `latin` subset range, verbatim. It deliberately excludes U+2192 (→),
   U+2197 (↗) and U+2260 (≠), which the copy uses — those already fell back to a
   system font on the original, and matching the range keeps that rendering
   identical. Widening it would change pixels. See NOTES.md. */
const LATIN =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="E2E Apps" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />

    {/* Archivo carries the h1; Plex Sans carries the hero paragraph. Both are
        above the fold and on the LCP path. Plex Mono is above the fold too but
        only on small eyebrow text, so it loads with the stylesheet rather than
        spending a third preload slot against the LCP. */}
    <link rel="preload" href={FONTS.archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={FONTS.sans} as="font" type="font/woff2" crossorigin />

    <style is:inline set:html={`
@font-face {
  font-family: 'Archivo';
  font-style: normal;
  font-weight: 400 700;
  font-stretch: 62% 125%;
  font-display: swap;
  src: url('${FONTS.archivo}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'IBM Plex Sans';
  font-style: normal;
  font-weight: 400 600;
  font-stretch: 100%;
  font-display: swap;
  src: url('${FONTS.sans}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'IBM Plex Mono';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${FONTS.mono}') format('woff2');
  unicode-range: ${LATIN};
}
`} />

    {/* Set before first paint so the reveal transition never flashes content
        visible and then hides it. With JS off the class is absent and every
        [data-reveal] block stays visible. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/* Consent defaults, then the container. Must come before any tag. */}
    <Analytics />

    <slot name="head" />
  </head>

  <body>
    <slot />
    <ConsentBanner />

    <script>
      import { initReveal } from '../scripts/reveal';
      import { captureAttribution } from '../scripts/attribution';
      import { initConsent } from '../scripts/consent';
      import { initEngagement } from '../scripts/engagement';

      // Capture click IDs first: everything downstream reads the cookie it writes.
      captureAttribution();
      initConsent();
      initReveal();
      initEngagement();
    </script>
  </body>
</html>
