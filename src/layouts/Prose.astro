---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  updated?: string;
  noindex?: boolean;
}

const { title, description, path, heading, updated, noindex = false } = Astro.props;
---

<Base title={title} description={description} path={path} noindex={noindex}>
  <div class="page">
    <Nav />
    <main class="prose section">
      <div class="prose__inner">
        <h1 class="prose__h1">{heading}</h1>
        {updated && <div class="prose__updated">Last updated {updated}</div>}
        <div class="prose__body">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Base>

<style is:global>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
    overflow-x: hidden;
  }

  .prose {
    /* Clear the fixed nav. */
    padding-top: calc(var(--section-pad) + 48px);
  }

  .prose__inner {
    max-width: 68ch;
    margin: 0 auto;
  }

  .prose__h1 {
    font-size: var(--t-h2);
    color: var(--color-text);
  }

  .prose__updated {
    margin-top: var(--s6);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-meta);
    color: var(--color-text-4);
  }

  .prose__body {
    margin-top: var(--s12);
    display: grid;
    gap: var(--s8);
    font-size: var(--t-body);
    color: var(--color-text-2);
  }

  .prose__body h2 {
    margin-top: var(--s8);
    font-size: var(--t-h3-sm);
    color: var(--color-text);
  }

  .prose__body h3 {
    font-size: var(--t-post-title);
    color: var(--color-text);
  }

  .prose__body ul {
    margin: 0;
    padding-left: var(--s8);
    display: grid;
    gap: var(--s3);
  }

  .prose__body code {
    font-family: var(--font-mono);
    font-size: var(--t-card);
    background: var(--color-surface);
    border-radius: 3px;
    padding: 1px 5px;
  }

  .prose__body table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-card);
  }

  .prose__body th,
  .prose__body td {
    text-align: left;
    vertical-align: top;
    padding: var(--s3) var(--s4) var(--s3) 0;
    border-bottom: 1px solid var(--color-line);
  }

  .prose__body th {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-meta);
    color: var(--color-text-4);
    font-weight: 400;
  }

  /* Wide tables scroll inside their own box rather than the page. */
  .prose__scroll {
    overflow-x: auto;
  }
</style>
