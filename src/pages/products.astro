---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Products from '../components/Products.astro';

/**
 * Products.
 *
 * Moved off the homepage, where three product cards competed with the
 * argument rather than supporting it. Someone evaluating the tools wants a
 * page about the tools.
 */

const title = 'Products - E2E Apps';
const description =
  'Three tools built for measurement and store work: Monetization Scout, ASO Suite and ASO Agent. Each links to a full overview.';
---

<Base title={title} description={description} path="/products">
  <div class="page">
    <Nav />

    <header class="page-head">
      <div class="wrap">
        <div class="eyebrow eyebrow--amber">TOOLS BUILT FOR THIS WORK</div>
        <h1 class="page-head__h1">Three products, in detail.</h1>
        <p class="page-head__lead">
          Built for our own portfolio work first, then written up. Each card opens a full overview as a PDF.
        </p>
      </div>
    </header>

    <Products />

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  .page-head {
    padding: calc(var(--section-pad) + 48px) var(--gutter) 0;
  }

  .page-head__h1 {
    margin-top: var(--s4);
    max-width: 20ch;
    font-size: var(--t-h1);
    letter-spacing: var(--ls-h1);
    line-height: var(--lh-h1);
  }

  .page-head__lead {
    margin-top: var(--s6);
    max-width: 58ch;
    font-size: var(--t-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }
</style>
