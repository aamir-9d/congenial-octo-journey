---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

/**
 * Blog index.
 *
 * Styled with the current tokens so the articles are readable and reviewable
 * on the preview now. The Bento restyle lands with the rest of the sections —
 * the markup here is the shape the design calls for (date, title, kicker, tag,
 * arrow), so that pass is a stylesheet change rather than a rewrite.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const title = 'Blog — E2E Apps';
const description =
  'Findings from live mobile measurement stacks: SKAdNetwork, Mixpanel JQL, and the Python that turns onboarding data into conversion rates.';
---

<Base title={title} description={description} path="/blog">
  <div class="page">
    <Nav />

    <section class="section">
      <div class="wrap">
        <div class="eyebrow">FROM THE BLOG</div>
        <h1 class="blog__head">What we're finding in live stacks</h1>
        <p class="section-lead">
          Written while the work was happening, not afterwards. Every one of these started as a
          problem in somebody's stack.
        </p>

        <div class="blog__list">
          {
            posts.map((post) => (
              <a class="blog__row" href={`${base}/blog/${post.id}`}>
                <span class="blog__date">
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>
                    {fmt(post.data.date)}
                  </time>
                </span>
                <span class="blog__body">
                  <span class="blog__title">{post.data.title}</span>
                  <span class="blog__kicker">{post.data.kicker}</span>
                </span>
                <span class="blog__tag">{post.data.tag}</span>
                <span class="blog__arrow" aria-hidden="true">&#8594;</span>
                <span class="blog__read">Read &#8594;</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  .section {
    padding-top: calc(var(--section-pad) + 48px);
  }

  .blog__head {
    font-size: var(--t-h2);
    color: var(--color-text);
  }

  .blog__list {
    margin-top: var(--s16);
  }

  .blog__row {
    display: grid;
    grid-template-columns: minmax(0, 110px) minmax(0, 1fr) minmax(0, 190px) auto;
    gap: var(--s8);
    align-items: baseline;
    padding: var(--s8) 0;
    border-top: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    transition: background 0.16s ease;
  }

  .blog__row:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .blog__row:hover {
    background: rgba(var(--rgb-text), 0.03);
  }

  .blog__date {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-text-4);
    white-space: nowrap;
  }

  .blog__title {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--t-post-title);
    line-height: var(--lh-pull);
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
  }

  .blog__kicker {
    display: block;
    margin-top: var(--s3);
    font-size: var(--t-card);
    line-height: var(--lh-snug);
    color: var(--color-text-2);
  }

  .blog__tag {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .blog__arrow {
    font-family: var(--font-mono);
    color: var(--color-text-4);
  }

  /* Phone only: the arrow at the end of a wide row becomes an explicit
     affordance once the row is a stacked block. */
  .blog__read {
    display: none;
  }

  /* The rows follow `design/E2E Apps - Bento mobile.dc.html`: date and tag on
     one line, a 17px title beneath, the kicker, then "Read". These rules used
     to live in the homepage Blog component; the blog index is where the rows
     are now, so this is where they belong. */
  @media (max-width: 767px) {
    .blog__row {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 10px;
      row-gap: var(--s3);
      align-items: center;
      padding: var(--s6) 0;
    }

    .blog__title {
      font-size: 17px;
      line-height: 1.3;
    }

    .blog__read {
      order: 4;
      grid-column: 1 / -1;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      justify-self: start;
      font-size: 13px;
      font-weight: var(--fw-semibold);
      color: var(--color-accent);
    }

    .blog__date {
      order: 1;
    }

    .blog__body {
      grid-column: 1 / -1;
      order: 3;
    }

    .blog__tag {
      order: 2;
      justify-self: start;
    }

    .blog__arrow {
      display: none;
    }
  }
</style>
