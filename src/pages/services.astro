---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Problems from '../components/Problems.astro';
import Stack from '../components/Stack.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Engage from '../components/Engage.astro';
import { SERVICES } from '../data/services';

/**
 * Services.
 *
 * Both of these sections used to sit on the homepage, where together they were
 * 824 words and fifteen disclosures — a fifth of the page — read by a visitor
 * who had not yet been given a reason to care. They are reference material:
 * what goes wrong, and what we do about it. Someone who wants that detail comes
 * looking for it, and now there is somewhere to send them.
 *
 * Nothing was cut in the move. The homepage keeps a compressed problem
 * statement; the full argument and the ten capability bundles live here.
 *
 * Board: design/v3/Services.dc.html. The h1 and lead sit in the PageHero; the
 * problem cards, the five services, the situations, the ways to work together
 * and the bundles follow, and the page closes on the shared ask.
 */

const title = 'Mobile Attribution & App Growth Services — E2E Apps';
const description =
  'What breaks in mobile measurement, and the ten capability bundles that fix it: MMP attribution, SKAdNetwork, tracking plans, subscriptions, app ads and ASO.';

/* The specialist pages this page lists (ServiceIndex), as an ItemList. Built
   from the same array the section renders, so the two cannot disagree. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'E2E Apps specialist services',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: new URL(`${base}/services/${s.slug}`, Astro.site).href,
  })),
};
---

<Base title={title} description={description} path="/services">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(list)} />
  <div class="page">
    <Nav />
    <main id="main">
      <Breadcrumbs trail={[{ name: 'Services', path: '/services' }]} />
      <PageHero
        label="Why your numbers don't reconcile"
        title="Three places the money goes missing. And one place it was never there."
        lead="The first isn't a measurement failure, and no amount of attribution accuracy will save you from it. The other three are — the revenue exists and you can't see it."
        cta={{ href: `${base}/#contact`, text: 'Get a free first look' }}
        section="services-hero"
      />
      <Problems />
      <ServiceIndex />
      <Engage />
      <Stack />
      <Cta />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }
</style>
