---
import Slider from './Slider.astro';
import { computeView, INITIAL_STATE, type CalcState, type CalcView } from '../scripts/calc-model';
import '../styles/calculator.css';

/**
 * The payback model card — the only genuinely stateful part of the page.
 *
 * Behaviour lives in src/scripts/calculator.ts, the maths in calc-model.ts,
 * ported verbatim from the export.
 *
 * `data-bind` marks a text destination, `data-when` a block whose visibility
 * follows a boolean on the view, and `data-set`/`data-slider`/`data-toggle`
 * mark controls. Every one of them is also filled here at build time, so the
 * card is complete and correct before any JS runs — the chart draws, the tiles
 * read their real figures, and nothing flashes empty.
 */

const st: CalcState = INITIAL_STATE;
const view = computeView(st);
const v = <K extends keyof CalcView>(k: K) => view[k];

const periods = [
  { value: 'weekly', label: 'Weekly' },
  { value: 'monthly', label: 'Monthly' },
  { value: 'annual', label: 'Annual' },
] as const;

/* The absolute-positioned chart labels are placed from these, both now and on
   every later render. */
const L = view.labels;
const chartVars = [
  `--y-lbl-w:${L.yLabelWidth}px`,
  `--lbl-zero-top:${L.zero.top}px`,
  `--lbl-ymax-top:${L.yMax.top}px`,
  `--lbl-ymin-top:${L.yMin.top}px`,
  `--lbl-t-top:${L.t0.top}px`,
  `--lbl-t0-left:${L.t0.left}px`,
  `--lbl-tmid-left:${L.tMid.left}px`,
  `--lbl-tend-left:${L.tEnd.left}px`,
  `--lbl-day7-left:${L.day7.left}px`,
  `--lbl-day7-top:${L.day7.top}px`,
  `--lbl-be-top:${L.be.top}px`,
  `--lbl-be-left:${L.be.left}px`,
  `--lbl-be-opacity:${L.be.opacity}`,
].join(';');

const subSliders = [
  { id: 's-i2t', label: 'Install → trial start', key: 'i2t', bind: 'i2tLabel', min: 1, max: 25, step: 0.5 },
  { id: 's-t2p', label: 'Trial → paid', key: 't2p', bind: 't2pLabel', min: 10, max: 60, step: 1 },
  { id: 's-price', label: 'Plan price', key: 'price', bind: 'priceLabel', min: 1.99, max: 99.99, step: 1 },
];

const subSliders2 = [
  { id: 's-ret', label: 'Renewal retention per cycle', key: 'retention', bind: 'retLabel', min: 50, max: 98, step: 0.5 },
];

const subSliders3 = [
  { id: 's-ref', label: 'Refund rate', key: 'refund', bind: 'refundLabel', min: 0, max: 10, step: 0.5 },
  { id: 's-cpi', label: 'Cost per install', key: 'cpi', bind: 'cpiLabel', min: 0.2, max: 8, step: 0.05 },
];

const adSliders = [
  { id: 's-arp', label: 'ARPDAU', key: 'arpdau', bind: 'arpdauLabel', min: 0.005, max: 0.5, step: 0.005 },
  { id: 's-d1', label: 'D1 retention', key: 'd1', bind: 'd1Label', min: 10, max: 60, step: 1 },
  { id: 's-d30', label: 'D30 retention', key: 'd30', bind: 'd30Label', min: 1, max: 25, step: 1 },
  { id: 's-acpi', label: 'Cost per install', key: 'adCpi', bind: 'adCpiLabel', min: 0.05, max: 3, step: 0.05 },
];

const derived = [
  { label: 'Install → paid', bind: 'i2pLabel' },
  { label: 'Net per payment', bind: 'netPaymentLabel' },
  { label: 'LTV per payer', bind: 'ltvPayerLabel' },
  { label: 'LTV per install', bind: 'ltvInstallLabel' },
];

const assumptions = [
  'Geometric per-cycle retention — a constant renewal rate every billing cycle.',
  'Constant ARPDAU across tenure.',
  'No seasonality in eCPM.',
  'No organic uplift from paid spend.',
  'No involuntary-churn recovery (failed payments never retried).',
  'Steady-state approximation — no cohort-size or price changes over the horizon.',
];
---

<div class="calc">
  {/* --- header: title + mode toggle ------------------------------------- */}
  <div class="calc__head">
    <div>
      <div class="calc__kicker">CUMULATIVE NET PER INSTALL</div>
      <div class="calc__title">Payback model</div>
    </div>
    <div class="calc__modes" role="group" aria-label="Monetisation model">
      <button type="button" class="calc__mode" data-set="mode" data-value="sub" aria-pressed={String(st.mode === 'sub')}>
        Subscription
      </button>
      <button type="button" class="calc__mode" data-set="mode" data-value="ad" aria-pressed={String(st.mode === 'ad')}>
        Ad-monetised
      </button>
    </div>
  </div>

  <div>
    {/* --- chart --------------------------------------------------------- */}
    <div class="calc__chart-pane">
      <div class="calc__chart-bar">
        <div class="calc__horizons" role="group" aria-label="Time horizon">
          {
            [90, 180, 365].map((h) => (
              <button
                type="button"
                class="calc__horizon"
                data-set="horizon"
                data-value={h}
                aria-pressed={String(st.horizon === h)}
              >
                {h}d
              </button>
            ))
          }
        </div>
        <div class="calc__breakeven" data-bind="breakevenLabel">{v('breakevenLabel')}</div>
      </div>

      <div id="chart-wrap" class="chart" style={chartVars}>
        <svg
          id="chart-svg"
          viewBox={v('vb')}
          width="100%"
          role="img"
          class="chart__svg"
          aria-labelledby="chartTitle chartDesc"
        >
          <title id="chartTitle">
            Cumulative net revenue per install, true versus dashboard-measured
          </title>
          <desc id="chartDesc" data-bind="chartSummary">{v('chartSummary')}</desc>
          <g stroke="#E2E0DA" stroke-width="1">
            <line id="ax-y" x1={v('axLeft')} y1={v('plotTop')} x2={v('axLeft')} y2={v('axBottom')}></line>
            <line id="ax-x" x1={v('axLeft')} y1={v('axBottom')} x2={v('axRight')} y2={v('axBottom')}></line>
          </g>
          <path id="p-gap" d={v('gapPath')} fill="#E39A1F" opacity={v('gapOpacity')} class="areafade"></path>
          <line id="zero-line" x1={v('axLeft')} y1={v('zeroY')} x2={v('axRight')} y2={v('zeroY')} stroke="#5C6779" stroke-width="1"></line>
          {/* Invisible in the export too (opacity 0) — the visible "0" is the
              HTML label overlay below. Carried across unchanged rather than
              dropped, and harmless to AT because role="img" makes the SVG a
              leaf node. */}
          <text id="zero-text" x={v('zeroTextX')} y={v('zeroTextY')} text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="12" fill="#5C6779" opacity="0">0</text>
          <line id="day7-line" x1={v('day7X')} y1={v('plotTop')} x2={v('day7X')} y2={v('axBottom')} stroke="#5C6779" stroke-width="1" stroke-dasharray="3 4" opacity="0.7"></line>
          <path id="p-meas" d={v('measPath')} fill="none" stroke="#5C6779" stroke-width="2" stroke-dasharray="6 5" stroke-linejoin="round"></path>
          <path id="p-true" d={v('truePath')} fill="none" stroke="#0E6E63" stroke-width="2.6" stroke-linejoin="round" pathLength="1" class="drawn"></path>
          <g id="cross-mark" opacity={v('crossOpacity')}>
            <line id="cross-line" x1={v('crossX')} y1={v('crossMarkTop')} x2={v('crossX')} y2={v('zeroY')} stroke="#E39A1F" stroke-width="1.5" stroke-dasharray="2 3"></line>
            <circle id="cross-dot" cx={v('crossX')} cy={v('zeroY')} r="5.5" fill="#E39A1F" stroke="#FFFFFF" stroke-width="2"></circle>
          </g>
        </svg>
        <div id="lbl-zero" class="chart__lbl chart__lbl--y">0</div>
        <div id="lbl-ymax" class="chart__lbl chart__lbl--y" data-bind="yMaxLabel">{v('yMaxLabel')}</div>
        <div id="lbl-ymin" class="chart__lbl chart__lbl--y" data-bind="yMinLabel">{v('yMinLabel')}</div>
        <div id="lbl-t0" class="chart__lbl chart__lbl--t">day 0</div>
        <div id="lbl-tmid" class="chart__lbl chart__lbl--t" data-bind="midTick">{v('midTick')}</div>
        <div id="lbl-tend" class="chart__lbl chart__lbl--t" data-bind="endTick">{v('endTick')}</div>
        <div id="lbl-day7" class="chart__lbl" data-bind="day7Label">{v('day7Label')}</div>
        <div
          id="lbl-be"
          class:list={['chart__lbl', 'chart__lbl--be', { 'is-flipped': L.be.flip }]}
          data-bind="breakevenLabel"
        >
          {v('breakevenLabel')}
        </div>
      </div>

      <div class="calc__legend">
        <span class="calc__legend-item"><span class="calc__swatch--true"></span>True revenue</span>
        <span class="calc__legend-item" data-when="isSub" hidden={!view.isSub}>
          <span class="calc__swatch--meas"></span>What your dashboard sees
        </span>
        <span class="calc__legend-item" data-when="isSub" hidden={!view.isSub}>
          <span class="calc__swatch--gap"></span>Invisible to your dashboard
        </span>
      </div>

      {/* --- assumptions ------------------------------------------------- */}
      <div class="calc__assump">
        <div class="calc__assump-bar">
          <div class="calc__assump-title">A MODEL, NOT A MEASUREMENT.</div>
          <button
            type="button"
            id="assump-toggle"
            class="calc__assump-btn"
            aria-expanded={String(st.assumpOpen)}
            aria-controls="assump-panel"
          >
            Assumptions <span data-bind="assumpIcon">{st.assumpOpen ? '−' : '+'}</span>
          </button>
        </div>
        <div id="assump-panel" class="calc__assump-panel" data-when="assumpOpen" hidden={!st.assumpOpen}>
          <ul class="calc__assump-list">
            {assumptions.map((a) => <li>{a}</li>)}
          </ul>
          <p class="calc__assump-note">
            Real retention isn't perfectly geometric &#8212; month one churns harder, then the curve
            flattens. This model will be slightly pessimistic past month six.
          </p>
        </div>
      </div>

      {/* --- tiles ------------------------------------------------------- */}
      <div class="calc__tiles">
        <div class="calc__tile">
          <div class="calc__tile-label">TRUE BREAKEVEN</div>
          <div class="calc__tile-val calc__tile-val--teal" data-bind="tileTrue">{v('tileTrue')}</div>
        </div>
        <div class="calc__tile">
          <div class="calc__tile-label">YOUR DASHBOARD REPORTS</div>
          <div class="calc__tile-val calc__tile-val--red" data-bind="tileDash">{v('tileDash')}</div>
        </div>
        <div class="calc__tile">
          <div class="calc__tile-label">INVISIBLE / 1,000 INSTALLS</div>
          <div class="calc__tile-val" data-bind="tileInvisible">{v('tileInvisible')}</div>
        </div>
        <div class="calc__tile">
          <div class="calc__tile-label" data-bind="roasTileLabel">{v('roasTileLabel')}</div>
          <div class="calc__tile-val" data-bind="tileRoas">{v('tileRoas')}</div>
        </div>
      </div>

      {/* --- verdict ----------------------------------------------------- */}
      <p class="calc__verdict" data-when="isSub" hidden={!view.isSub}>
        On the numbers your dashboard reports, you would pause this campaign. On the real numbers it
        returns <span class="calc__verdict-fig" data-bind="lifeRoas">{v('lifeRoas')}</span> over the
        subscription's life. That decision is what the gap costs.
      </p>
      <p class="calc__verdict" data-when="isAd" hidden={!view.isAd}>
        At this ARPDAU and this decay, an install returns
        <span class="calc__verdict-fig" data-bind="adHorizonRoas">{v('adHorizonRoas')}</span> by day
        <span data-bind="horizon">{v('horizon')}</span>. Everything after that is the part nobody
        waits for.
      </p>

      <p aria-live="polite" class="calc__summary" data-bind="chartSummary">{v('chartSummary')}</p>
    </div>

    {/* --- controls ------------------------------------------------------ */}
    <div class="calc__controls">
      {/* subscription */}
      <div data-when="isSub" hidden={!view.isSub}>
        <div class="calc__grid">
          {subSliders.map((f) => <Slider {...f} />)}

          <div class="calc__field calc__field--group">
            <div class="calc__group-label" id="lbl-period">Billing period</div>
            <div class="calc__segmented" role="group" aria-labelledby="lbl-period">
              {
                periods.map((p) => (
                  <button
                    type="button"
                    class="calc__seg"
                    data-set="period"
                    data-value={p.value}
                    aria-pressed={String(st.period === p.value)}
                  >
                    {p.label}
                  </button>
                ))
              }
            </div>
          </div>

          <div class="calc__field calc__field--group">
            <div class="calc__group-label" id="lbl-trial">Trial length</div>
            <div class="calc__segmented" role="group" aria-labelledby="lbl-trial">
              {
                [3, 7, 14, 30].map((d) => (
                  <button
                    type="button"
                    class="calc__seg"
                    data-set="trialDays"
                    data-value={d}
                    aria-pressed={String(st.trialDays === d)}
                  >
                    {d}d
                  </button>
                ))
              }
            </div>
          </div>

          {subSliders2.map((f) => <Slider {...f} />)}

          <div class="calc__field calc__field--group">
            <div class="calc__group-label" id="lbl-comm">Store commission</div>
            <div class="calc__segmented" role="group" aria-labelledby="lbl-comm">
              {
                [15, 30].map((c) => (
                  <button
                    type="button"
                    class="calc__seg"
                    data-set="commission"
                    data-value={c}
                    aria-pressed={String(st.commission === c)}
                  >
                    {c}%
                  </button>
                ))
              }
            </div>
          </div>

          {subSliders3.map((f) => <Slider {...f} />)}
        </div>

        <div class="calc__derived">
          {
            derived.map((d) => (
              <div>
                {d.label}
                <div class="calc__derived-val" data-bind={d.bind}>
                  {view[d.bind as keyof typeof view]}
                </div>
              </div>
            ))
          }
        </div>

        <p class="calc__warn" data-when="isAnnual" hidden={!view.isAnnual}>
          Annual SKU: one payment at trial end, then nothing until day 365. The whole bet rides on a
          single charge and one renewal decision a year later.
        </p>

        <div class="calc__gaps">
          <div class="calc__gaps-title">WHAT YOUR DASHBOARD CURRENTLY SEES</div>
          <div class="calc__gaps-grid">
            <label for="c-renew" class="calc__check">
              <input
                id="c-renew"
                type="checkbox"
                data-toggle="renewalCapture"
                checked={st.renewalCapture}
                class="calc__box"
              />
              <span>
                Server-side renewal capture
                <span class="calc__check-note">Off: only the first payment is ever visible.</span>
              </span>
            </label>

            <div class="calc__check-stack">
              <label for="c-skan" class="calc__check">
                <input
                  id="c-skan"
                  type="checkbox"
                  data-toggle="skanMapped"
                  checked={st.skanMapped}
                  class="calc__box"
                />
                <span>
                  SKAN schema mapped to revenue
                  <span class="calc__check-note">Off: null conversion values report zero revenue.</span>
                </span>
              </label>
              <Slider
                id="s-skan"
                label="Share of iOS installs with null CV"
                key="skanNull"
                bind="skanNullLabel"
                min={0}
                max={80}
                step={1}
                small
              />
            </div>

            <div class="calc__check-stack">
              <label for="c-web" class="calc__check">
                <input
                  id="c-web"
                  type="checkbox"
                  data-toggle="webStitched"
                  checked={st.webStitched}
                  class="calc__box"
                />
                <span>
                  Web-to-app click stitching
                  <span class="calc__check-note">Off: paid installs get miscredited to organic.</span>
                </span>
              </label>
              <Slider
                id="s-web"
                label="Share miscredited to organic"
                key="webLoss"
                bind="webLossLabel"
                min={0}
                max={60}
                step={1}
                small
              />
            </div>
          </div>
        </div>
      </div>

      {/* ad-monetised */}
      <div data-when="isAd" hidden={!view.isAd}>
        <div class="calc__grid">
          {adSliders.map((f) => <Slider {...f} />)}
        </div>

        <div class="calc__crosscheck">
          <div class="calc__gaps-title">D7 CROSS-CHECK</div>
          <div class="calc__crosscheck-row">
            <div class="calc__crosscheck-cell">
              Model predicts D7
              <div class="calc__crosscheck-val" data-bind="predD7Label">{v('predD7Label')}</div>
            </div>
            <div class="calc__crosscheck-input">
              <label for="i-d7">Your actual D7 (%)</label>
              <input
                id="i-d7"
                type="number"
                min="0"
                max="60"
                step="0.1"
                value={st.realD7}
                data-number="realD7"
                class="calc__number"
              />
            </div>
          </div>
          <div class="calc__crosscheck-note">
            Fitted decay exponent b = <span data-bind="bLabel">{v('bLabel')}</span> &#183; cumulative
            active days by D30 = <span data-bind="activeD30Label">{v('activeD30Label')}</span>
          </div>
          <p class="calc__warn calc__warn--tight" data-when="d7Mismatch" hidden={!view.d7Mismatch}>
            Your curve isn't a power law. That usually means a broken onboarding step, not a bad
            model.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initCalculator } from '../scripts/calculator';
  initCalculator();
</script>

