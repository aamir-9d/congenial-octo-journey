<style>
  .art {
    display: block;
    height: var(--art-h, 190px);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface-sunk);
    color: var(--color-text);
  }

  /* The blue is the same fixed hue the page header's second bloom uses. */
  .art[data-ground='1'] {
    background:
      linear-gradient(135deg, rgba(64, 86, 140, calc(var(--bloom-blue) * 0.9)), rgba(64, 86, 140, calc(var(--bloom-blue) * 0.28))),
      var(--color-surface);
  }

  .art[data-ground='2'] {
    background:
      linear-gradient(135deg, rgba(var(--rgb-accent), 0.22), rgba(var(--rgb-accent), 0.06)),
      var(--color-surface);
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  text {
    font-family: var(--font-mono);
  }

  .f-a {
    fill: var(--color-accent);
  }
  .f-wash {
    fill: rgba(var(--rgb-accent), 0.16);
  }
  .f-ink {
    fill: var(--color-ink);
  }
  .f-t {
    fill: currentColor;
  }
  .f-t3 {
    fill: var(--color-text-3);
  }
  .f-mid {
    fill: var(--chart-measured);
  }
  .f-dim {
    fill: var(--chart-bar-dim);
  }
  .f-ln {
    fill: var(--color-line-strong);
  }
  .f-bg {
    fill: var(--color-bg);
  }
  .f-su {
    fill: var(--color-surface-sunk);
  }

  .s-a {
    stroke: var(--chart-true);
  }
  .s-ink {
    stroke: var(--color-ink);
  }
  .s-t {
    stroke: currentColor;
  }
  .s-t3 {
    stroke: var(--color-text-3);
  }
  .s-mid {
    stroke: var(--chart-measured);
  }
  .s-dim {
    stroke: var(--chart-bar-dim);
  }
  .s-line {
    stroke: var(--color-line-strong);
