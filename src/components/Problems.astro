---
import Icon from './Icon.astro';
import { decayCurve } from '../data/decay';
import type { IconName } from '../data/icons';

/**
 * The five problem cards on /services.
 *
 * Board: design/v3/Services.dc.html. The page's h1 and lead now sit in the
 * <PageHero> above, so this section has no head of its own: it opens straight
 * on the grid, and each card title is an h2.
 *
 * Twelve columns from 1024px: row one is span 7 + span 5, row two is three
 * span 4. Every card has the same parts in the same order: icon and kicker,
 * title, lead, the "Why it happens" disclosure, and a visual pinned to the
 * bottom. The min-heights on the title and lead keep the disclosure triggers of
 * one row on a common line; reword a lead and they need re-checking.
 *
 * Below 700px the grid is one swipe row (src/scripts/swipe.ts).
 *
 * COPY. The signed-off paragraphs are split at their own sentence breaks: the
 * opening sentences are the lead, the remainder sits behind the disclosure.
 * Nothing is reworded. Card 05 was added with the bento and keeps its
 * `data-added` mark.
 */

const decay = decayCurve();
/* The dashed payback marker's position, as a share of the chart's width, so
   the label under the chart can sit beneath it. */
const [, , boxW] = decay.viewBox.split(' ').map(Number);
const payPct = (Number(decay.payX) / (boxW || 300)) * 100;

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** Same inline convention as src/data/faq.ts: `code` becomes <code>. */
const withCode = (t: string) => esc(t).replace(/`([^`]+)`/g, '<code class="problems__token">$1</code>');

/** The code visual, with one fragment picked out in amber. */
const withMark = (t: string, mark?: string) =>
  mark ? esc(t).replace(esc(mark), `<span class="problems__mark">${esc(mark)}</span>`) : esc(t);

type Visual = 'curve' | 'bars' | 'code' | 'chips';

interface Card {
  span: 7 | 5 | 4;
  num: string;
  numAmber?: boolean;
  lead?: boolean;
  icon: IconName;
  title: string;
  text: string;
  /** The rest of the signed-off paragraph. Backticks become <code>. */
  body: string;
  visual: Visual;
  code?: string;
  mark?: string;
  chips?: string[];
  added?: boolean;
  /** Where the corner glow sits. */
  glow: [string, string];
}

const cards: Card[] = [
  {
    span: 7,
    num: '01 · NOT A MEASUREMENT PROBLEM',
    numAmber: true,
    lead: true,
    icon: 'chart-line-down',
    title: 'Retention nobody watches past D7.',
    text: 'Every LTV model is retention multiplied by monetisation. If the retention curve dies before the payback horizon, the campaign cannot break even at any CPI — the money was never going to be there.',
    body: "Most teams track D1, quote D7 in a deck, and never build the D30 curve that actually decides it. On a subscription app, payback lands somewhere around month nine. A cohort that's gone by week three never gets there.",
    visual: 'curve',
    glow: ['100%', '0%'],
  },
  {
    span: 5,
    num: '02',
    icon: 'arrows-clockwise',
    title: 'Renewals nobody counted.',
    text: "Subscription renewals happen on Apple's servers while your app is closed.",
    body: 'If nothing is listening server-side, that revenue never reaches your MMP or your ad platforms — so every channel looks worse than it is, and you optimise against your own best cohorts.',
    visual: 'bars',
    glow: ['0%', '100%'],
  },
  {
    span: 4,
    num: '03',
    icon: 'git-branch',
    title: 'A conversion schema built for nothing in particular.',
    text: 'SKAdNetwork gives you a handful of bits and one short window.',
    body: 'Most schemas were set up once, copied from a blog post, and never mapped to the events that actually predict revenue for this app.',
    visual: 'code',
    code: 'skan_cv: null\n71% of postbacks',
    mark: 'skan_cv: null',
    glow: ['0%', '0%'],
  },
  {
    span: 4,
    num: '04',
    icon: 'arrow-square-out',
    title: 'The web-to-app gap.',
    text: 'Someone clicks a Google ad on your website, installs later, subscribes a week after that.',
    body: 'Without `gclid`/`gbraid`/`wbraid` capture and a conversion sent back, Google never learns which click earned the money — so it optimises toward the wrong people.',
    visual: 'code',
    code: 'web_click → install\n→ ??? → subscription',
    mark: '???',
    glow: ['50%', '100%'],
  },
  {
    span: 4,
    num: 'AND WHERE IT GOES RIGHT',
    numAmber: true,
    icon: 'plugs-connected',
    title: 'One stack, one person accountable.',
    text: 'Measurement, attribution and the media buying under one owner — so nobody can blame the other when the two disagree.',
    body: 'Aamir owns measurement, attribution and the media. Faisal owns the server-side infrastructure: the webhook receivers, the relays, the pipelines that run unattended.',
    visual: 'chips',
    chips: ['AppsFlyer', 'Adjust', 'RevenueCat', 'ASSN V2', 'RTDN', 'GA4', 'OCI', 'CAPI'],
    added: true,
    glow: ['100%', '40%'],
  },
];
---

<section id="services" class="section" data-section="problems">
  <div class="wrap">
    <div class="ggrid problems__grid swipe" data-swipe>
      {
        cards.map((c) => (
          <article
            class:list={['gcard', 'problems__card', `problems__card--span-${c.span}`, { 'gcard--lead': c.lead }]}
            style={`--gx:${c.glow[0]};--gy:${c.glow[1]}`}
            data-added={c.added ? 'bento' : undefined}
          >
            <div class="problems__kicker">
              <span class="gcard__icon">
                <Icon name={c.icon} size={24} />
              </span>
              <span class:list={['problems__num', { 'problems__num--amber': c.numAmber }]}>{c.num}</span>
            </div>

            <h2 class="problems__title">{c.title}</h2>
            <p class="problems__lead">{c.text}</p>

            <details class="problems__why">
              <summary class="problems__why-summary">
                <span>Why it happens</span>
                <Icon name="caret-down" size={12} />
              </summary>
              <p class="problems__body" set:html={withCode(c.body)} />
            </details>

            <div class="problems__visual">
              {
                c.visual === 'curve' && (
                  <div class="dcard problems__panel">
                    <div class="dcard__label">
                      <span>Retention curve</span>
                      <span>Example</span>
                    </div>
                    <svg
                      class="problems__curve"
                      viewBox={decay.viewBox}
                      preserveAspectRatio="none"
                      role="img"
                      aria-label="Retention curve dying before the payback horizon"
                    >
                      <path d={decay.area} fill="var(--chart-true)" opacity="0.14" />
                      <path
                        d={decay.line}
                        fill="none"
                        stroke="var(--chart-true)"
                        stroke-width="2.2"
                        vector-effect="non-scaling-stroke"
                        pathLength="1"
                        class="drawn"
                      />
                      <line
                        x1={decay.payX}
                        y1="4"
                        x2={decay.payX}
                        y2="92"
                        stroke="var(--chart-rule)"
                        stroke-width="1"
                        stroke-dasharray="3 4"
                        vector-effect="non-scaling-stroke"
                      />
                    </svg>
                    <div class="problems__horizon" style={`padding-right:${(100 - payPct).toFixed(1)}%`}>
                      payback horizon
                    </div>
                  </div>
                )
              }

              {
                c.visual === 'bars' && (
                  <div class="dcard problems__panel">
                    <div class="dcard__label">
                      <span>Revenue the channel gets credit for</span>
                      <span>Example</span>
                    </div>
                    <div class="problems__bars" aria-hidden="true">
                      <div class="problems__bar problems__bar--dim" />
                      <div class="problems__bar problems__bar--true" />
                    </div>
                    <div class="problems__bar-labels">
                      <span class="problems__bar-label">Dashboard</span>
                      <span class="problems__bar-label problems__bar-label--amber">True</span>
                    </div>
                  </div>
                )
              }

              {c.visual === 'code' && <div class="dcard problems__code" set:html={withMark(c.code!, c.mark)} />}

              {
                c.visual === 'chips' && (
                  <div class="problems__chips">
                    {c.chips!.map((k) => (
                      <span class="problems__chip">{k}</span>
                    ))}
                  </div>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
    <div class="swipe__meta" data-swipe-meta aria-hidden="true">
      <span class="swipe__dots" data-swipe-dots>{cards.map(() => <i />)}</span>
      <span data-swipe-count>1 of {cards.length}</span>
    </div>

    <p data-reveal="1" class="problems__pull">
      Three of these are fixable in weeks.
      <span class="problems__pull-rest">
        The first is a product problem, and we'll tell you if that's the one you have.
      </span>
    </p>
  </div>
</section>

<style>
  /* Two columns from 700px (from .ggrid), with the lead card across both. */
  @media (min-width: 700px) and (max-width: 1023px) {
    .problems__card--span-7 {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .problems__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .problems__card--span-7 {
      grid-column: span 7;
    }

    .problems__card--span-5 {
      grid-column: span 5;
    }

    .problems__card--span-4 {
      grid-column: span 4;
    }

    /* Hold the disclosure triggers of one row on a common line. */
    .problems__card--span-7 .problems__lead,
    .problems__card--span-5 .problems__lead {
      min-height: 4.8em;
    }

    .problems__card--span-4 .problems__title {
      min-height: 2.36em;
    }

    .problems__card--span-4 .problems__lead {
      min-height: 4.8em;
    }
  }

  .problems__card {
    min-width: 0;
  }

  .problems__kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .problems__num {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .problems__num--amber {
    color: var(--color-accent-text);
  }

  .problems__title {
    margin-top: var(--s8);
    font-size: clamp(21px, 2vw, 27px);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-h3);
    line-height: 1.18;
  }

  .problems__lead {
    margin-top: var(--s4);
    max-width: 62ch;
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .problems__why {
    margin-top: var(--s2);
  }

  .problems__why-summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--ls-disclosure);
    color: var(--color-accent-text);
  }

  .problems__why-summary :global(svg) {
    transition: transform 180ms var(--ease-out-soft);
  }

  .problems__why[open] .problems__why-summary :global(svg) {
    transform: rotate(180deg);
  }

  .problems__body {
    margin-top: var(--s2);
    max-width: 62ch;
    font-size: var(--t-body-sm);
    line-height: var(--lh-prose);
    color: var(--color-text-2);
  }

  /* Inside set:html, so a scoped rule cannot reach it. */
  .problems__body :global(.problems__token) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  /* Pins every visual to the bottom of its card, whatever the lead does. */
  .problems__visual {
    margin-top: auto;
    padding-top: var(--s8);
  }

  .problems__panel {
    padding: 16px 20px 14px;
  }

  .problems__curve {
    display: block;
    width: 100%;
    height: 110px;
    margin-top: var(--s4);
  }

  .problems__horizon {
    display: flex;
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    color: var(--color-text-4);
  }

  .problems__bars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 28px;
    align-items: end;
    height: 110px;
    margin-top: var(--s4);
  }

  .problems__bar {
    border-radius: 8px 8px 0 0;
    transform-origin: bottom;
    animation: grow-y 0.7s var(--ease-out-soft) both;
  }

  .problems__bar--dim {
    height: 40px;
    background: var(--chart-bar-dim);
    animation-delay: 0.2s;
  }

  .problems__bar--true {
    height: 110px;
    background: var(--color-accent);
    animation-delay: 0.34s;
  }

  .problems__bar-labels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 28px;
    padding-top: 10px;
    border-top: 1px solid var(--color-line-strong);
  }

  .problems__bar-label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-chip);
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .problems__bar-label--amber {
    color: var(--color-accent-text);
  }

  /* pre-line, because the newline inside the string is the layout. */
  .problems__code {
    min-height: 76px;
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.75;
    white-space: pre-line;
    overflow-wrap: anywhere;
    color: var(--color-text-2);
  }

  .problems__code :global(.problems__mark) {
    color: var(--color-accent-text);
  }

  .problems__chips {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 8px;
    min-height: 76px;
  }

  .problems__chip {
    padding: 6px 11px;
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    white-space: nowrap;
    color: var(--color-text-2);
  }

  .problems__pull {
    margin: clamp(40px, 5vw, 72px) auto 0;
    max-width: min(100%, 860px);
    text-align: center;
    text-wrap: balance;
    font-size: clamp(21px, 2.1vw, 28px);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-h3);
    line-height: 1.32;
    color: var(--color-text);
  }

  .problems__pull-rest {
    color: var(--color-text-2);
  }

  @media (max-width: 640px) {
    .problems__card {
      padding: var(--s6);
    }

    .problems__title {
      margin-top: var(--s6);
      font-size: var(--t-post-title);
      line-height: 1.24;
    }

    .problems__lead {
      font-size: var(--t-body-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .problems__why-summary :global(svg) {
      transition: none;
    }
  }
</style>
