---
/**
 * The spot illustration on a post card.
 *
 * Board: design/v3/Blog.dc.html, which draws one per post. They are copied
 * here shape for shape; only the colours changed. The board paints them in
 * fixed dark hex values, and these are painted with classes that read the
 * tokens, so each one works in the dark and the light theme:
 *
 *   amber fill      -> --color-accent         amber stroke -> --chart-true
 *   amber lettering -> --color-accent-text    ink on amber -> --color-ink
 *   dark shapes     -> --color-bg / --color-surface-sunk
 *   placeholders    -> --color-line-strong / --chart-bar-dim / --chart-measured
 *   outlines        -> --color-text-3         highlights   -> --color-text
 *
 * A post is matched by its slug. A post with no drawing of its own (a new
 * one, say) gets a drawing chosen by its tag, and failing that the ranked
 * bars, so a card is never left with an empty panel.
 *
 * `ground` picks one of three panel grounds; callers pass the card's index so
 * neighbours differ.
 */
interface Props {
  slug: string;
  tag?: string;
  ground?: number;
}

type Art =
  | 'dial'
  | 'frames'
  | 'bubbles'
  | 'timeline'
  | 'steps'
  | 'sheet'
  | 'card'
  | 'pulse'
  | 'fork'
  | 'nodes'
  | 'table'
  | 'bars'
  | 'network'
  | 'funnel'
  | 'ranked'
  | 'drop';

const BY_SLUG: Record<string, Art> = {
  'app-quality-is-an-ad-serving-gate': 'dial',
  'creative-coverage-is-an-inventory-key': 'frames',
  'one-campaign-per-language': 'bubbles',
  'the-learning-period-is-a-line-in-your-budget': 'timeline',
  'between-cancel-and-cancelled': 'steps',
  'conversion-after-the-buy-button': 'sheet',
  'involuntary-churn-failed-payments': 'card',
  'renewals-happen-while-your-app-is-closed': 'pulse',
  'the-strategy-was-right-the-traffic-was-wrong': 'fork',
  'where-churn-shows-up-in-your-numbers': 'nodes',
  'master-onboarding-insights-with-pandas': 'table',
  'app-conversion-rate-analysis-in-python': 'bars',
  'leveraging-skan-for-ios': 'network',
  'mastering-jql-in-javascript': 'funnel',
};

const BY_TAG: Record<string, Art> = {
  campaigns: 'timeline',
  subscriptions: 'card',
  monetisation: 'sheet',
  analytics: 'bars',
  creative: 'frames',
  skadnetwork: 'network',
  python: 'table',
  mixpanel: 'funnel',
  paywall: 'drop',
  report: 'ranked',
};

const LABEL: Record<Art, string> = {
  dial: 'A score dial with its needle short of full, next to a locked gate',
  frames: 'Three ad frames, 9:16, 1:1 and 16:9, the widest drawn dashed as missing',
  bubbles: 'Three overlapping speech bubbles labelled EN, ES and AR',
  timeline: 'A fourteen-day timeline with an arrow looping back to the first day',
  steps: 'A stepped flow of four stages that ends in a switch turned off',
  sheet: 'A phone with a billing sheet sliding up from the bottom, and bars of different lengths beside it',
  card: 'A payment card with a retry arrow on its corner',
  pulse: 'A server stack sending a pulse that stops short of a dimmed app icon',
  fork: 'Two arrows leaving one point and diverging, one solid and one dashed',
  nodes: 'Four connected nodes, three of them marked in amber',
  table: 'A small data table with one column highlighted',
  bars: 'Four groups of paired bars standing on a baseline',
  network: 'One device linked to six network nodes, one line solid amber and the rest dashed',
  funnel: 'A funnel of four narrowing bars between a pair of code braces',
  ranked: 'Five horizontal bars of decreasing length, the longest in amber',
  drop: 'Two bars, a long one and a much shorter amber one, with an arrow pointing down between them',
};

const { slug, tag = '', ground = 0 } = Astro.props;
const art: Art = BY_SLUG[slug] ?? BY_TAG[tag.toLowerCase()] ?? 'ranked';
const g = ((ground % 3) + 3) % 3;
---

