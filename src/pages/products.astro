---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import Products from '../components/Products.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';

/**
 * Products.
 *
 * Board: design/v3/Products.dc.html. The page header carries the h1; the
 * section under it is one large card per product (Products.astro); the closing
 * ask ends the page.
 *
 * Moved off the homepage, where three product cards competed with the
 * argument rather than supporting it. Someone evaluating the tools wants a
 * page about the tools.
 */

const title = 'Monetization & ASO Tools — E2E Apps';
const description =
  'Three tools built for measurement and store work: Monetization Scout, ASO Suite and ASO Agent. Each links to a full overview.';
---

<Base title={title} description={description} path="/products">
  <div class="page">
    <Nav />
    <main id="main">
      <Breadcrumbs trail={[{ name: 'Products', path: '/products' }]} />
      <PageHero
        label="Products"
        title="Monetization and app store optimization tools"
        lead="Three tools from E2E Apps, each one a full overview — what it does, how it works, and screenshots from the running build."
        section="products-intro"
      />
      <Products />
      <Cta />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }
</style>
