---
import Icon from './Icon.astro';
import { GROUP_A, GROUP_B, toHtml } from '../data/faq';

/**
 * Nineteen questions, two columns.
 *
 * The width problem: the FAQ sat in a 760px column while every section around
 * it used the page wrap, so its edges lined up with nothing. It is in the same
 * 1280px wrap as everything else now, split into the two groups it already had
 * — "Working together" and "Technical scope" — which is what earns the width
 * back rather than stretching a single list across it.
 *
 * All nineteen answers are unchanged and still come from src/data/faq.ts, so
 * Schema.astro's FAQPage JSON-LD needs no change and cannot drift.
 *
 * Answers cap at 72ch. A 600px measure is unreadable regardless of how much
 * column there is.
 */

const groups = [
  { label: 'Working together', items: GROUP_A },
  { label: 'Technical scope', items: GROUP_B },
];
---

<section id="faq" class="faq section" data-section="faq">
  <div class="wrap">
    <div class="section-head" data-reveal="1">
      <div class="eyebrow">BEFORE YOU BOOK</div>
      <h2 class="faq__h2">Questions people ask before booking.</h2>
      <p class="section-lead">Including the ones that are awkward to answer.</p>
    </div>

    <div class="faq__cols">
      {
        groups.map((g) => (
          <div class="faq__col">
            <div class="faq__group">{g.label}</div>
            {g.items.map((item, i) => (
              <details class="faq__item" open={i === 0}>
                <summary class="faq__q">
                  <span>{item.q}</span>
                  <Icon name="caret-down" size={13} />
                </summary>
                <p class="faq__a" set:html={toHtml(item.a)} />
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: linear-gradient(180deg, var(--color-bg), var(--color-band) 50%, var(--color-bg));
  }


  .faq__h2 {
    margin-top: 16px;
    font-size: var(--t-h2);
    letter-spacing: var(--ls-h2);
  }

  .faq__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 0 clamp(28px, 4vw, 64px);
    margin-top: clamp(40px, 4vw, 64px);
  }

  /* Each column is a track in the grid; the min-width stops a long question
     forcing the two columns apart. */
  .faq__col {
    min-width: 0;
  }

  .faq__group {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
    color: var(--color-accent);
    padding-bottom: 14px;
  }

  .faq__item {
    border-top: 1px solid var(--color-line);
  }

  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 0;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-size: 16.5px;
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
  }

  .faq__q :global(svg) {
    margin-top: 5px;
    color: var(--color-text-4);
    transition: transform 180ms ease;
  }

  .faq__item[open] .faq__q :global(svg) {
    transform: rotate(180deg);
  }

  .faq__a {
    padding: 0 0 20px;
    max-width: 72ch;
    font-size: var(--t-card);
    line-height: var(--lh-answer);
    color: var(--color-text-2);
  }

  .faq__a :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__q :global(svg) {
      transition: none;
    }
  }

  /* --- phone ------------------------------------------------------------- */

  @media (max-width: 767px) {
    .faq__q {
      min-height: 44px;
      padding: var(--s4) 0;
      font-size: 15.5px;
      line-height: 1.4;
    }

    .faq__a {
      padding: 0 0 var(--s6);
      font-size: 14px;
      line-height: var(--lh-answer);
    }

    .faq__group {
      margin-top: var(--s8);
    }
  }
</style>
