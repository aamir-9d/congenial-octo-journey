---
import { computeView, INITIAL_STATE, type CalcState, type CalcView } from '../scripts/calc-model';

interface Props {
  id: string;
  label: string;
  /** Shorter label for phone width, where the full one cannot sit beside its
      own readout. Falls back to `label`. */
  short?: string;
  /** State key this slider writes to. */
  key: keyof CalcState;
  /** View key holding its formatted readout. */
  bind: keyof CalcView;
  min: number;
  max: number;
  step: number;
  /** The narrower variant used inside the attribution-gap checkboxes. */
  small?: boolean;
}

const { id, label, short, key, bind, min, max, step, small = false } = Astro.props;

const view = computeView(INITIAL_STATE);
---

<div class={small ? 'calc__sub-field' : 'calc__field'}>
  <div class={small ? 'calc__sub-head' : 'calc__field-head'}>
    <label for={id}>
      {
        short ? (
          <>
            <span class="wide-only">{label}</span>
            <span class="narrow-only">{short}</span>
          </>
        ) : (
          label
        )
      }
    </label>
    <span class="calc__field-val" data-bind={bind}>{view[bind]}</span>
  </div>
  {/* `aria-valuetext` carries the formatted readout — "8.0%", "$1.20" — so a
      screen reader announces what the page shows rather than the raw number.
      calculator.ts keeps it in step on every render. */}
  <input
    id={id}
    type="range"
    min={min}
    max={max}
    step={step}
    value={INITIAL_STATE[key]}
    aria-valuetext={String(view[bind])}
    data-slider={key}
    data-readout={bind}
    class:list={['calc__range', { 'calc__range--sm': small }]}
  />
</div>
