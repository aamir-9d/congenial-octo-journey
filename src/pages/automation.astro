---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Investigation from '../components/Investigation.astro';
import { STEPS, OUTCOMES, DISCLOSURES, TEASER } from '../data/automation.ts';

/**
 * /automation
 *
 * Revision 2 of docs/automation-visual-revision.md. Two structural changes from
 * the first build:
 *
 *   The 40/60 split hero is gone. The copy column ended roughly 500px above the
 *   panel beside it, and the empty lower-left region read as unfinished. A
 *   centred introduction now sits above a full-width demonstration.
 *
 *   Three sources became four and one assistant became three. GA4 covers the
 *   behaviour gap between acquisition and revenue, and Claude, ChatGPT and
 *   Gemini appear equally — the service is not exclusive to one provider.
 *
 * Sections: centred hero, full-width demonstration, four outcomes, three
 * process steps, three disclosures, closing CTA.
 *
 * Disclosure is not concealment. Every limit that would change a buying
 * decision sits beside its example inside the demonstration; the disclosures
 * carry the long-form version of the same facts.
 */

const title = 'Automation — E2E Apps';
const description =
  'Bring Google Ads, GA4, AdMob and RevenueCat into one reporting workflow, and investigate spend, user behavior and revenue with Claude, ChatGPT or Gemini. Reporting and investigation; account changes are written up for your decision.';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={title} description={description} path="/automation">
  <div class="page">
    <Nav />

    <main id="main">
      {/* ---------------------------------------------------- 1 · hero ---- */}
      <section class="section section--lead" data-section="automation-hero">
        <div class="wrap">
          <div class="lead-in">
            <p class="eyebrow eyebrow--amber">{TEASER.eyebrow}</p>
            <h1 class="lead-in__h1">Your growth stack.<br />Your choice of AI.</h1>
            <p class="lead-in__lead">
              Investigate your reporting sources in the assistant your team already uses, with the
              source figures attached.
            </p>

            <a href={`${base}/#contact`} class="btn-primary lead-in__cta">
              Discuss your setup
              <Icon name="arrow-right" size={15} />
            </a>
          </div>

          <div class="stage">
            <Investigation headingId="demo" />
          </div>
        </div>
      </section>

      {/* ------------------------------------------------ 2 · outcomes ---- */}
      <section class="section" data-section="automation-outcomes">
        <div class="wrap">
          <ul class="outcomes">
            {
              OUTCOMES.map((o) => (
                <li class="outcome">
                  <h2 class="outcome__title">{o.title}</h2>
                  <p class="outcome__body">{o.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {/* ----------------------------------------------- 3 · how we work -- */}
      <section class="section" data-section="automation-process">
        <div class="wrap">
          <h2 class="sec__h2">How we work</h2>

          <ol class="steps">
            {
              STEPS.map((s) => (
                <li class="step">
                  <span class="step__n">{s.n}</span>
                  <span class="step__title">{s.title}</span>
                  <p class="step__body">{s.body}</p>
                </li>
              ))
            }
          </ol>

          <div class="detail">
            {
              DISCLOSURES.map((d) => (
                <details class="detail__item">
                  <summary class="detail__summary">{d.label}</summary>
                  <div class="detail__body">
                    {d.body.map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      {/* -------------------------------------------------- 4 · closing --- */}
      <section class="section" data-section="automation-cta">
        <div class="wrap">
          <div class="close">
            <h2 class="close__h2">Make your reporting easier to act on.</h2>
            <p class="close__body">
              Tell us which accounts you run and which assistant your team uses.
            </p>
            <a href={`${base}/#contact`} class="btn-primary">
              Discuss your setup
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  /* --- 1 · hero ----------------------------------------------------------- */

  /* Centred introduction above a full-width demonstration. The 40/60 split this
     replaces left the copy column ending 500px above the panel beside it, and
     the empty lower-left region read as an unfinished page. */
  /* No measure on this container.
     
     `max-width: 30ch` here resolves against the container's own 16px font, not
     the 60px headline inside it -- about 240px, which wrapped a two-line
     headline onto five. docs/design.md states the rule and this broke it: a
     measure belongs on the element that owns the font size. */
  .lead-in {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lead-in__h1 {
    margin-top: var(--s4);
    /* 56-64px desktop, ~34-40px phone, per the brief. */
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    color: var(--color-text);
    /* At its own size, not the container's. Holds the two authored lines. */
    max-width: 22ch;
    text-wrap: balance;
  }

  .lead-in__lead {
    margin-top: var(--s8);
    max-width: 44ch;
    font-size: var(--t-section-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .lead-in__cta {
    margin-top: var(--s12);
  }

  .stage {
    margin-top: var(--s16);
    padding: var(--s12) var(--s8);
    border-radius: var(--radius-panel);
    background: var(--color-band);
    box-shadow: var(--ring);
    min-width: 0;
  }

  @media (max-width: 640px) {
    .stage {
      margin-top: var(--s12);
      padding: var(--s8) var(--s6);
    }
  }

  /* --- 2 · outcomes ------------------------------------------------------- */

  /* Open columns with a rule, not three more rounded cards. */
  .outcomes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s8);
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }

  .outcome {
    padding-top: var(--s6);
    border-top: 1px solid var(--color-line-strong);
    min-width: 0;
  }

  .outcome__title {
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-snug);
    color: var(--color-text);
  }

  .outcome__body {
    margin-top: var(--s4);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-3);
  }

  /* --- 3 · process -------------------------------------------------------- */

  .sec__h2 {
    font-size: var(--t-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    color: var(--color-text);
  }

  .steps {
    list-style: none;
    margin: var(--s12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s8);
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }

  .step {
    min-width: 0;
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-accent);
  }

  .step__title {
    display: block;
    margin-top: var(--s3);
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .step__body {
    margin-top: var(--s4);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-3);
  }

  .detail {
    margin-top: var(--s16);
    border-top: 1px solid var(--color-line);
  }

  .detail__item {
    border-bottom: 1px solid var(--color-line);
  }

  .detail__summary {
    display: flex;
    align-items: center;
    min-height: 56px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--ls-disclosure);
    color: var(--color-text-2);
    list-style: none;
  }

  .detail__summary::-webkit-details-marker {
    display: none;
  }

  /* The +/− is CSS on [open], so the disclosures need no JavaScript at all. */
  .detail__summary::before {
    content: '+';
    flex: none;
    width: 1.4em;
    font-size: 1.1em;
    color: var(--color-accent);
  }

  .detail__item[open] .detail__summary::before {
    content: '\2212';
  }

  .detail__item[open] .detail__summary {
    color: var(--color-text);
  }

  .detail__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .detail__body {
    padding: 0 0 var(--s8) 1.4em;
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    max-width: 74ch;
  }

  .detail__body p {
    margin: 0;
    font-size: var(--t-card-sm);
    line-height: var(--lh-body);
    color: var(--color-text-3);
  }

  /* --- 4 · closing -------------------------------------------------------- */

  .close {
    max-width: 58ch;
  }

  .close__h2 {
    font-size: var(--t-h2-card);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2-card);
    color: var(--color-text);
    text-wrap: balance;
  }

  .close__body {
    margin: var(--s8) 0 var(--s12);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }
</style>
