---
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';

/**
 * The two founders.
 *
 * A 78px photo slot beside the name and role, then a single-paragraph bio, a
 * row of credential tags, and the LinkedIn link.
 *
 * The bios are CONDENSED from the export's three paragraphs to one — new copy,
 * marked `data-added` and awaiting sign-off. The full originals are still in
 * git history if the condensed version does not land.
 *
 * The build-time `fs.existsSync` check stays: drop `aamir.jpg` / `faisal.jpg`
 * into public/img/ and the photos render. Until then the slot shows a user glyph
 * on a diagonal-stripe ground, which reads as deliberate rather than as a
 * missing image.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicDir = path.resolve(process.cwd(), 'public');
const hasPhoto = (file: string) => fs.existsSync(path.join(publicDir, 'img', file));

const founders = [
  {
    file: 'aamir.jpg',
    name: 'Aamir Jan Khan',
    role: 'MEASUREMENT & GROWTH',
    alt: 'Aamir Jan Khan',
    linkedin: 'https://www.linkedin.com/in/aamir-jan-khan/',
    tags: ['48 AppsFlyer accounts', '50+ apps', 'Media buying'],
    bio: "I run growth for a portfolio of 50+ iOS and Android apps — which means I'm not describing this work from the outside. Five years across measurement platforms, ad platforms, app stores and subscription analytics. Most people in this field pick a side, the plumbing or the media buying. In a portfolio you don't get that luxury, because you own the outcome, not the task.",
  },
  {
    file: 'faisal.jpg',
    name: 'Muhammad Faisal Khan',
    role: 'INFRASTRUCTURE & OPERATIONS',
    alt: 'Muhammad Faisal Khan',
    linkedin: 'https://www.linkedin.com/in/muhammad-faisal-khan-3606365/',
    tags: ['20 years', 'LTE & 5G core', 'Cisco / Nokia / Ericsson'],
    bio: "Twenty years as a solution architect on carrier-grade mobile networks — packet core delivery across Cisco, Nokia and Ericsson. A lot of what breaks in app measurement isn't a setting in a dashboard. It's a server that has to receive a webhook, validate it, and forward it on without dropping anything. That's the half I own.",
  },
];
---

<section class="section" data-section="founders">
  <div class="wrap">
    <div class="section-head founders__head" data-reveal="1">
      <div class="eyebrow">WHO YOU TALK TO</div>
      <h2 class="founders__h2">Nothing gets handed off.</h2>
    </div>

    <div class="founders__grid">
      {
        founders.map((f) => (
          <div class="founders__card" data-reveal="1">
            <div class="founders__id">
              <div class="founders__slot">
                {
                  hasPhoto(f.file) ? (
                    <img
                      src={`${base}/img/${f.file}`}
                      alt={f.alt}
                      width="156"
                      height="156"
                      loading="lazy"
                      decoding="async"
                      class="founders__photo"
                    />
                  ) : (
                    <Icon name="user" size={24} />
                  )
                }
              </div>
              <div>
                <h3 class="founders__name">{f.name}</h3>
                <div class="founders__role">{f.role}</div>
              </div>
            </div>

            <p class="founders__bio" data-added="bento">{f.bio}</p>

            <div class="founders__tags">
              {f.tags.map((t) => <span class="founders__tag">{t}</span>)}
            </div>

            <a href={f.linkedin} target="_blank" rel="noopener" class="founders__linkedin">
              LinkedIn
              <Icon name="arrow-up-right" size={13} />
            </a>
          </div>
        ))
      }
    </div>

    <p data-reveal="1" class="pull founders__pull">
      Nothing gets handed off. You talk to the two people doing the work.
    </p>
  </div>
</section>

<style>
  .founders__head {
    max-width: 48ch;
  }

  .founders__h2 {
    margin-top: 16px;
    font-size: var(--t-h2);
    letter-spacing: var(--ls-h2);
  }

  .founders__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: 16px;
    margin-top: clamp(40px, 4vw, 64px);
  }

  .founders__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 26px;
    box-shadow: var(--ring);
  }

  .founders__id {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* A deliberate placeholder, not a broken image: the stripes read as a frame
     waiting for a photo. */
  .founders__slot {
    flex: none;
    width: 78px;
    height: 78px;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #1d2128 0 6px, #191c22 6px 12px);
    display: grid;
    place-items: center;
    color: var(--color-line-hover);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  .founders__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .founders__name {
    font-size: var(--t-h3);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-brand);
  }

  .founders__role {
    margin-top: 5px;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .founders__bio {
    margin-top: 20px;
    font-size: var(--t-body-sm);
    line-height: var(--lh-answer);
    color: var(--color-text-2);
    flex: 1;
  }

  .founders__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .founders__tag {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    white-space: nowrap;
    color: var(--color-text-3);
    padding: 6px 11px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-sunk);
  }

  .founders__linkedin {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 20px;
    align-self: flex-start;
    font-size: var(--t-card-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
  }

  .founders__pull {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
</style>
