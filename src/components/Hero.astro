---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';

/**
 * Centred hero.
 *
 * The split hero is gone, and with it the summary card and the mini chart that
 * used to sit beside the headline — the Bento design puts the payback model in
 * its own section below the bento grid instead. Those two blocks were where the
 * frozen-bindings bug lived, so the calculator is self-contained again.
 *
 * The lead paragraph is NEW COPY awaiting sign-off, marked `data-added` so the
 * copy-parity test lifts it out rather than failing on it. The h1 is the
 * export's own headline, unchanged.
 */

const chips: { label: string; icon: IconName }[] = [
  { label: 'AppsFlyer', icon: 'broadcast' },
  { label: 'Adjust', icon: 'crosshair' },
  { label: 'SKAdNetwork 4.0', icon: 'shield-check' },
  { label: 'RevenueCat', icon: 'receipt' },
  { label: 'Google Ads', icon: 'cursor-click' },
  { label: 'Apple Ads', icon: 'magnifying-glass' },
  { label: 'GA4 & BigQuery', icon: 'chart-line' },
];
---

<section id="top" class="hero" data-section="hero">
  {/* Layer 1: a dot grid, masked to fade out before the section edges. */}
  <div class="hero__dots" aria-hidden="true"></div>

  {/* Layer 2: two blooms on long, offset drift loops. Transform only, so they
      stay on the compositor and cost no layout. */}
  <div class="hero__blooms" aria-hidden="true">
    <div class="hero__bloom hero__bloom--amber"></div>
    <div class="hero__bloom hero__bloom--cool"></div>
  </div>

  {/* Layer 3: a line sweeping the top edge, inside a 1px clipping strip. */}
  <div class="hero__scan" aria-hidden="true">
    <div class="hero__scan-line"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__pill" data-added="bento">
      <Icon name="plugs-connected" size={14} />
      Attribution, fixed at the source
    </div>

    <h1 class="hero__h1">Your dashboard says the campaign is losing money.</h1>

    <p class="hero__lead" data-added="bento">
      It broke even in month nine &#8212; you killed it in week one. I fix the attribution, close
      the marketing gaps it was hiding, and grow the app on numbers you can defend.
    </p>

    <div class="hero__actions">
      <a href="#contact" class="btn-primary">
        Find what your stack is missing
        <Icon name="arrow-right" size={15} />
      </a>
      <a href="#loop" class="btn-secondary">See how it works</a>
    </div>

    <div class="hero__chips" data-added="bento">
      {
        chips.map((c) => (
          <span class="hero__chip">
            <span class="hero__chip-icon"><Icon name={c.icon} size={13} /></span>
            {c.label}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 9vw, 132px) var(--gutter) clamp(56px, 6vw, 88px);
  }

  .hero__dots {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle at center,
      rgba(232, 234, 237, 0.055) 1px,
      transparent 1px
    );
    background-size: 34px 34px;
    mask-image: radial-gradient(ellipse 78% 62% at 50% 34%, #000 30%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 78% 62% at 50% 34%, #000 30%, transparent 78%);
  }

  .hero__blooms {
    position: absolute;
    inset: -25% -12% auto -12%;
    height: 130%;
    z-index: 0;
    pointer-events: none;
  }

  .hero__bloom {
    position: absolute;
    border-radius: 50%;
  }

  .hero__bloom--amber {
    top: -6%;
    left: 16%;
    width: 50%;
    height: 74%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(227, 154, 31, 0.26),
      rgba(227, 154, 31, 0) 66%
    );
    filter: blur(44px);
    animation: drift-a 28s ease-in-out infinite;
  }

  .hero__bloom--cool {
    top: 10%;
    right: 8%;
    width: 44%;
    height: 66%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(64, 86, 140, 0.34),
      rgba(64, 86, 140, 0) 68%
    );
    filter: blur(50px);
    animation: drift-b 36s ease-in-out infinite;
  }

  .hero__scan {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__scan-line {
    width: 38%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(227, 154, 31, 0.85), transparent);
    animation: scan 11s linear 1.4s infinite;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: var(--wrap);
    margin: 0 auto;
    text-align: center;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-mono-sm);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-pill);
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 7px 15px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-dim);
    box-shadow: inset 0 0 0 1px rgba(var(--rgb-accent), 0.24);
  }

  .hero__h1 {
    margin: 26px auto 0;
    font-size: var(--t-h1);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-h1);
    line-height: var(--lh-h1);
    max-width: 19ch;
  }

  .hero__lead {
    margin: 20px auto 0;
    max-width: 58ch;
    font-size: var(--t-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--s4);
    margin-top: var(--s12);
  }

  .hero__chips {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 38px;
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: var(--t-mono);
    white-space: nowrap;
    color: var(--color-text-2);
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-sunk);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  /* A wrapper, not a class on <Icon>. Passing the class through would land it
     on Icon.astro's own svg, where this scoped rule cannot reach it — the same
     mismatch tests/styles.test.ts caught on Slider.astro. */
  .hero__chip-icon {
    display: inline-flex;
    color: var(--color-accent);
  }

  /* --- entrance -----------------------------------------------------------
     Fires on load rather than on scroll: this is above the fold, so there is
     no entry to wait for. Opacity and transform only, so no layout shift.

     The h1 is the LCP element and starts at opacity 0, which means its 80ms
     delay is added to LCP. That is the whole cost of this, and it is why the
     h1 carries the shortest delay of the five. */
  .hero__pill,
  .hero__h1,
  .hero__lead,
  .hero__actions,
  .hero__chips {
    animation: rise 0.6s var(--ease-out-soft) both;
  }

  .hero__pill {
    animation-delay: 0s;
  }
  .hero__h1 {
    animation-delay: 0.08s;
  }
  .hero__lead {
    animation-delay: 0.16s;
  }
  .hero__actions {
    animation-delay: 0.24s;
  }
  .hero__chips {
    animation-delay: 0.32s;
  }

  /* The blooms are the only continuous work on the page. Stopping them for
     anyone who asks for less motion is both the correct behaviour and the
     cheapest thing on a phone. */
  /* From `design/E2E Apps - Bento mobile.dc.html`: a 33px headline, a 15px
     lead, full-width stacked CTAs at 52px, and a tighter dot grid. */
  @media (max-width: 640px) {
    .hero {
      padding: var(--s16) var(--gutter) var(--s12);
    }

    .hero__dots {
      background-size: 26px 26px;
      mask-image: radial-gradient(ellipse 80% 56% at 50% 30%, #000 26%, transparent 76%);
      -webkit-mask-image: radial-gradient(ellipse 80% 56% at 50% 30%, #000 26%, transparent 76%);
    }

    /* nowrap so the pill stays one line rather than breaking into two at
       402px, which is what makes the top of the page look ragged. */
    .hero__pill {
      font-size: 10px;
      padding: 7px 12px;
      white-space: nowrap;
    }

    .hero__h1 {
      margin-top: var(--s6);
      letter-spacing: -0.03em;
      line-height: 1.08;
    }

    .hero__lead {
      margin-top: var(--s4);
      font-size: var(--t-body-sm);
      line-height: var(--lh-prose);
    }

    /* Stacked and full width: two pills side by side at this width leaves
       neither a comfortable target. */
    .hero__actions {
      display: grid;
      gap: var(--s3);
      margin-top: var(--s8);
    }

    .hero__actions > * {
      justify-content: center;
      min-height: 52px;
      font-size: var(--t-body);
    }

    /* Seven chips wrap into five ragged centred rows at this width. One
       horizontally-scrolling strip instead: it reads as a deliberate row, and
       the overflow is the user's to explore rather than the layout's problem.
       The scrollbar is hidden; the fade at the right edge is what says there
       is more. */
    .hero__chips {
      margin-top: var(--s8);
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      /* Bleed to the viewport edge so the strip reads as scrollable rather
         than as a row that happens to be clipped. */
      margin-left: calc(var(--gutter) * -1);
      margin-right: calc(var(--gutter) * -1);
      padding: 0 var(--gutter);
      scroll-padding-left: var(--gutter);
    }

    .hero__chips::-webkit-scrollbar {
      display: none;
    }

    .hero__chip {
      flex: none;
      font-size: 11.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bloom,
    .hero__scan-line {
      animation: none;
    }

    .hero__pill,
    .hero__h1,
    .hero__lead,
    .hero__actions,
    .hero__chips {
      animation: none;
    }
  }
</style>
