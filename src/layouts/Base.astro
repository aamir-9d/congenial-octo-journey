---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Path relative to the site root, e.g. "/privacy". Used for the canonical URL. */
  path?: string;
  /** Suppress indexing — used by 404. */
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;

/* SITE_PREVIEW=1 marks a branch build served alongside the live site. Every
   page in it is noindex,nofollow: a second full copy of the site competing in
   search would be a real SEO problem, not a cosmetic one. Build-time only, so
   process.env is the right read here. */
const isPreview = process.env.SITE_PREVIEW === '1';
const blockIndexing = noindex || isPreview;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}${p}`;

const canonical = new URL(`${base}${path === '/' ? '/' : path}`, Astro.site).href;
const ogImage = new URL(asset('/og-image.png'), Astro.site).href;

/* One list, two consumers: the preload links and the @font-face src below.
   Keeping them in step is what stops a preload from fetching a URL the CSS
   never asks for (which Chrome warns about and which wastes the round trip). */
const FONTS = {
  body400: asset('/fonts/be-vietnam-pro-400-latin.woff2'),
  body500: asset('/fonts/be-vietnam-pro-500-latin.woff2'),
  body600: asset('/fonts/be-vietnam-pro-600-latin.woff2'),
  body700: asset('/fonts/be-vietnam-pro-700-latin.woff2'),
  mono: asset('/fonts/ibm-plex-mono-400-latin.woff2'),
};

/* Google's `latin` subset range, verbatim — and identical to the range the
   cream build used, so the `→ ↗ ≠` system-font fallback is unchanged.

   Be Vietnam Pro has no variable version on Google Fonts, despite the brief
   asking for one. Four static weights instead, 85KB for the set — still less
   than the 135KB Archivo-variable plus Plex-Sans-variable pair it replaces. */
const LATIN =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {blockIndexing && <meta name="robots" content={isPreview ? 'noindex, nofollow' : 'noindex, follow'} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="E2E Apps" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* SVG first for browsers that take it; the PNGs are the fallback, and
        Safari still wants apple-touch-icon by name. All generated from the one
        mark by scripts/build-icons.mjs. */}
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={asset('/favicon-16.png')} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={asset('/site.webmanifest')} />
    <meta name="theme-color" content="#0E1014" />

    {/* 700 carries the h1, which is the LCP element; 400 carries the lead
        paragraph beneath it. The other two weights and the mono face load with
        the stylesheet rather than spending preload slots against the LCP. */}
    <link rel="preload" href={FONTS.body700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={FONTS.body400} as="font" type="font/woff2" crossorigin />

    <style is:inline set:html={`
@font-face {
  font-family: 'Be Vietnam Pro';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${FONTS.body400}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Be Vietnam Pro';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url('${FONTS.body500}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Be Vietnam Pro';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url('${FONTS.body600}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Be Vietnam Pro';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('${FONTS.body700}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'IBM Plex Mono';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${FONTS.mono}') format('woff2');
  unicode-range: ${LATIN};
}
`} />

    {/* Set before first paint so the reveal transition never flashes content
        visible and then hides it. With JS off the class is absent and every
        [data-reveal] block stays visible. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/* Consent defaults, then the container. Must come before any tag. */}
    <Analytics />

    <slot name="head" />
  </head>

  <body>
    <slot />
    <ConsentBanner />

    <script>
      import { captureAttribution } from '../scripts/attribution';
      import { initConsent } from '../scripts/consent';
      import { initEngagement } from '../scripts/engagement';
      import { initDisclose } from '../scripts/disclose';
      import { initProducts } from '../scripts/products';

      // Capture click IDs first: everything downstream reads the cookie it writes.
      captureAttribution();
      initConsent();
      initDisclose();
      initProducts();
      initEngagement();
    </script>
  </body>
</html>
