---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import ServiceVisual from '../../components/ServiceVisual.astro';
import ServiceTable from '../../components/ServiceTable.astro';
import { AUTHORS } from '../../data/authors';
import type { IconName } from '../../data/icons';
import { SERVICES, UPDATED, rich } from '../../data/services';

/**
 * One specialist service. Five pages come from this template.
 *
 * Board: design/v3/ServiceDetail.dc.html. Page header, the page's exhibit on a
 * scene panel, the mistakes as glow cards on a band, the content blocks, the
 * FAQ beside its heading, the related services, then the shared ask.
 * Content lives in src/data/services.ts; nothing here is typed in twice.
 */

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = `/services/${service.slug}`;
const author = AUTHORS.aamir;
const related = service.related.map((slug) => SERVICES.find((s) => s.slug === slug)!);

/* Each service keeps the icon it has on /services and the homepage. */
const ICONS: IconName[] = ['magnifying-glass', 'shield-check', 'cursor-click', 'list', 'arrows-clockwise'];
const iconOf = (slug: string) => ICONS[SERVICES.findIndex((s) => s.slug === slug)] ?? 'stack';
const GLOW = [
  ['100%', '0%'],
  ['0%', '100%'],
  ['0%', '0%'],
  ['100%', '100%'],
];
const glow = (i: number) => `--gx:${GLOW[i % GLOW.length]![0]};--gy:${GLOW[i % GLOW.length]![1]}`;
const two = (n: number) => String(n).padStart(2, '0');

/* The audit's deliverable is a list of findings, so its block shows one: a
   mistake from this page's own list, laid out the way a finding is written. */
const isAudit = service.slug === 'mobile-attribution-audit';
const sample = isAudit ? service.mistakes.find((m) => m.wrong.startsWith('Revenue')) : undefined;

/* The shared closing band carries the audit's ask word for word, so the audit
   page does not print it a second time beside the FAQ. */
const showAsk = !isAudit;

const home = new URL(`${base}/`, Astro.site).href;
const url = new URL(`${base}${path}`, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: service.name,
      serviceType: service.name,
      description: service.description,
      url,
      areaServed: 'Worldwide',
      provider: { '@type': 'ProfessionalService', '@id': `${home}#business`, name: 'E2E Apps', url: home },
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: service.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Base title={service.title} description={service.description} path={path}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <div class="page">
    <Nav />
    <main id="main">
      <Breadcrumbs trail={[{ name: 'Services', path: '/services' }, { name: service.name, path }]} />

      <PageHero
        label={service.eyebrow}
        title={service.h1}
        lead={service.lead}
        cta={{ href: `${base}/#contact`, text: 'Book a call' }}
        section="service-intro"
      >
        <p class="svc__byline">
          By <a class="link" href={`${base}/about`}>{author.name}</a>, updated{' '}
          <time datetime={UPDATED.iso}>{UPDATED.label}</time>
        </p>
      </PageHero>

      <section class="section" data-section="service-visual">
        <div class="wrap">
          <div class="shead" data-reveal="1">
            <p class="shead__label">At a glance</p>
            <h2 class="shead__title svc__wide-title">{service.visualTitle}</h2>
            {service.visualLead && <p class="shead__aside">{service.visualLead}</p>}
          </div>
          <div class="sbody">
            <ServiceVisual visual={service.visual} />
            {service.visualNote && <p class="svc__note" set:html={rich(service.visualNote, base)} />}
          </div>
        </div>
      </section>

      <section class="section section--band" data-section="service-mistakes">
        <div class="wrap">
          <div class="shead" data-reveal="1">
            <p class="shead__label">Mistakes and fixes</p>
            <h2 class="shead__title">{service.mistakesTitle}</h2>
          </div>
          <div class="sbody">
            <ul
              class:list={[
                'ggrid',
                service.mistakes.length % 3 === 0 ? 'ggrid--3' : 'ggrid--4',
                'swipe',
                'svc__grid',
                { 'svc__grid--seven': service.mistakes.length === 7 },
              ]}
              role="list"
              data-swipe
              data-swipe-label="Mistake"
            >
              {service.mistakes.map((m, i) => (
                <li class="gcard svc__card" style={glow(i)}>
                  {/* "Mistake:" is part of the heading, so the heading still makes sense
                      when it is quoted on its own, away from the section title. */}
                  <div class="svc__kicker" aria-hidden="true">Mistake {two(i + 1)}</div>
                  <h3 class="svc__card-title"><span class="visually-hidden">Mistake: </span>{m.wrong}</h3>
                  <div class="svc__shows">
                    <div class="svc__kicker">{service.showsLabel}</div>
                    <p class="svc__card-text">{m.shows}</p>
                  </div>
                  <div class="svc__fix">
                    <div class="svc__kicker svc__kicker--amber">The fix</div>
                    <p class="svc__card-text svc__card-text--strong" set:html={rich(m.fix, base)} />
                  </div>
                </li>
              ))}
            </ul>
            <div class="swipe__meta" data-swipe-meta aria-hidden="true">
              <span class="swipe__dots" data-swipe-dots>{service.mistakes.map(() => <i />)}</span>
              <span data-swipe-count>Mistake 1 of {service.mistakes.length}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section" data-section="service-detail">
        <div class="wrap svc__blocks">
          {service.blocks.map((b, i) => {
            const withSample = Boolean(b.wide && sample && !b.list && !b.table);
            return (
              <div
                class:list={[
                  'gcard',
                  'svc__block',
                  { 'svc__block--wide': b.wide, 'gcard--lead svc__block--split': withSample },
                ]}
                style={glow(i + 1)}
              >
                <div class="svc__block-copy">
                  <h2 class="svc__block-title">{b.title}</h2>
                  {b.text && <p class="svc__block-text" set:html={rich(b.text, base)} />}
                  {b.list && (
                    b.ordered ? (
                      <ol class="svc__list svc__list--ordered">{b.list.map((item) => <li>{item}</li>)}</ol>
                    ) : (
                      <ul class:list={['svc__list', { 'svc__list--two': b.list.length > 6 }]}>
                        {b.list.map((item) => <li>{item}</li>)}
                      </ul>
                    )
                  )}
                  {b.table && (
                    <div class="svc__table">
                      <ServiceTable head={b.table.head} rows={b.table.rows} />
                    </div>
                  )}
                  {b.note && <p class="svc__note" set:html={rich(b.note, base)} />}
                </div>
                {withSample && sample && (
                  <div class="scene svc__sample">
                    <dl class="dcard svc__finding">
                      <div class="dcard__label">
                        <span>Finding</span>
                        <span>Sample</span>
                      </div>
                      <div class="svc__finding-row">
                        <dt class="svc__finding-key">Issue</dt>
                        <dd class="svc__finding-val svc__finding-val--strong">{sample.wrong}</dd>
                      </div>
                      <div class="svc__finding-row">
                        <dt class="svc__finding-key">Why it matters</dt>
                        <dd class="svc__finding-val">{sample.shows}</dd>
                      </div>
                      <div class="svc__finding-row">
                        <dt class="svc__finding-key svc__finding-key--amber">Fix</dt>
                        <dd class="svc__finding-val svc__finding-val--strong">{sample.fix}</dd>
                      </div>
                    </dl>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>

      <section class="section section--band" data-section="service-faq">
        <div class="wrap svc__faq">
          <div class="svc__faq-head" data-reveal="1">
            <p class="shead__label">Before you book</p>
            <h2 class="shead__title svc__faq-title">Common questions.</h2>
            {showAsk && (
              <aside class="svc__cta">
                <p class="svc__cta-text">{service.ask}</p>
                <a class="btn-primary svc__cta-btn" href={`${base}/#contact`}>
                  Book a call
                  <Icon name="arrow-right" size={16} />
                </a>
              </aside>
            )}
          </div>
          <div class="svc__faq-list">
            {service.faqs.map((f, i) => (
              <details class="svc__faq-item" open={i === 0}>
                <summary class="svc__q">
                  <span>{f.q}</span>
                  <Icon name="caret-down" size={16} />
                </summary>
                <p class="svc__a">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section" data-section="service-related">
        <nav class="wrap" aria-labelledby="svc-related">
          <div class="shead" data-reveal="1">
            <p class="shead__label">Related services</p>
            <h2 id="svc-related" class="shead__title">One problem per page.</h2>
            <p class="shead__aside">Each shows what apps get wrong and how to fix it.</p>
          </div>
          <div class="sbody">
          <ul class="ggrid ggrid--3 swipe svc__related" role="list" data-swipe>
            {related.map((s, i) => (
              <li class="svc__related-item">
                <a class="gcard svc__rel" href={`${base}/services/${s.slug}`} style={glow(i)}>
                  <span class="gcard__icon">
                    <Icon name={iconOf(s.slug)} size={24} />
                  </span>
                  <span class="gcard__title">{s.name}</span>
                  <span class="gcard__text">{s.summary}</span>
                  <span class="gcard__go">
                    See the fixes
                    <Icon name="arrow-right" size={15} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="swipe__meta" data-swipe-meta aria-hidden="true">
            <span class="swipe__dots" data-swipe-dots>{related.map(() => <i />)}</span>
            <span data-swipe-count>1 of {related.length}</span>
          </div>
          </div>
          <p class="svc__post">
            <a class="pill-link" href={`${base}/case-studies`}>
              Case studies
              <Icon name="arrow-right" size={15} />
            </a>
            <a class="pill-link" href={`${base}/mmp-audit-findings`}>
              What attribution audits keep finding
              <Icon name="arrow-right" size={15} />
            </a>
            {service.post && (
              <a class="pill-link" href={`${base}${service.post.href}`}>
                Read: {service.post.label}
                <Icon name="arrow-right" size={15} />
              </a>
            )}
          </p>
        </nav>
      </section>

      <Cta />
    </main>
    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  .svc__byline {
    margin-top: var(--s8);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-text-3);
  }

  /* The exhibit's heading is a sentence, so it gets a longer measure. */
  .svc__wide-title {
    max-width: 24ch;
  }

  .svc__note {
    margin-top: var(--s6);
    max-width: 78ch;
    font-size: var(--t-card-sm);
    line-height: var(--lh-prose);
    color: var(--color-text-3);
  }

  /* --- mistakes ---------------------------------------------------------- */

  /* Margin and padding are left to .swipe below 700px, where the row bleeds
     to the screen edges. */
  .svc__grid {
    margin-top: 0;
    margin-bottom: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .svc__grid {
      padding: 0;
    }
  }

  .svc__card {
    padding: clamp(20px, 2.2vw, 28px);
  }

  /* An odd last card closes its row instead of leaving a hole. */
  @media (min-width: 700px) and (max-width: 1023px) {
    .svc__card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .svc__grid--seven .svc__card:last-child {
      grid-column: span 2;
    }
  }

  .svc__kicker {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-4);
  }

  .svc__kicker--amber {
    color: var(--color-accent-text);
  }

  .svc__card-title {
    margin-top: var(--s4);
    font-size: 20px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-snug);
    line-height: 1.25;
  }

  .svc__shows {
    margin-top: var(--s6);
  }

  /* Pinned to the foot, under a rule, so every card in a row ends on its fix. */
  .svc__fix {
    margin-top: auto;
    padding-top: var(--s6);
  }

  .svc__fix::before {
    content: '';
    display: block;
    margin-bottom: var(--s6);
    border-top: 1px solid var(--color-line-strong);
  }

  .svc__card-text {
    margin-top: var(--s2);
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--color-text-2);
  }

  .svc__card-text--strong {
    color: var(--color-text);
  }

  @media (min-width: 1024px) {
    .svc__card-title {
      min-height: 2.5em;
    }

    .svc__fix .svc__card-text {
      min-height: 3em;
    }
  }

  /* --- content blocks ---------------------------------------------------- */

  .svc__blocks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .svc__block {
    padding: clamp(22px, 2.8vw, 36px);
  }

  .svc__block-copy {
    min-width: 0;
  }

  .svc__block-title {
    font-size: clamp(21px, 2vw, 27px);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-h3);
    line-height: 1.18;
  }

  .svc__block-text {
    margin-top: var(--s6);
    max-width: 72ch;
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .svc__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s4) var(--s8);
    margin: var(--s8) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--color-text-2);
  }

  .svc__list li {
    position: relative;
    min-width: 0;
    padding-left: 24px;
  }

  .svc__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Ordered lists keep their numbers, in the mono face. */
  .svc__list--ordered {
    counter-reset: step;
  }

  .svc__list--ordered li {
    padding-left: 38px;
    counter-increment: step;
  }

  .svc__list--ordered li::before {
    content: counter(step, decimal-leading-zero);
    top: 0.2em;
    width: auto;
    height: auto;
    border-radius: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-accent-text);
  }

  .svc__table {
    margin-top: var(--s8);
  }

  /* The audit's deliverable: the copy beside one sample finding. */
  .svc__sample {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 0;
    padding: clamp(16px, 2.6vw, 30px);
    border-radius: 20px;
  }

  .svc__finding {
    align-self: stretch;
    margin: 0;
  }

  .svc__finding-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    margin-top: var(--s4);
  }

  .svc__finding-key {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-chip);
    text-transform: uppercase;
    color: var(--color-text-3);
  }

  .svc__finding-key--amber {
    color: var(--color-accent-text);
  }

  .svc__finding-val {
    margin: 0;
    min-width: 0;
    font-size: var(--t-card);
    line-height: var(--lh-snug);
    color: var(--color-text-2);
  }

  .svc__finding-val--strong {
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  @media (min-width: 480px) {
    .svc__finding-row {
      grid-template-columns: minmax(0, 124px) minmax(0, 1fr);
      column-gap: 14px;
      align-items: baseline;
    }
  }

  @media (min-width: 700px) {
    .svc__list--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .svc__blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .svc__block--wide {
      grid-column: 1 / -1;
    }

    .svc__block--split {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(32px, 6vw, 96px);
      align-items: center;
    }

    .svc__block--split .svc__block-title {
      font-size: var(--t-h2-card);
      letter-spacing: var(--ls-h2-card);
      line-height: 1.14;
    }

    .svc__sample {
      min-height: 280px;
    }
  }

  @media (max-width: 899px) {
    .svc__sample {
      margin-top: var(--s8);
    }
  }

  /* --- FAQ --------------------------------------------------------------- */

  .svc__faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 4.5vw, 64px);
    align-items: start;
  }

  .svc__faq-head {
    min-width: 0;
  }

  .svc__faq-title {
    margin-top: var(--s6);
  }

  .svc__cta {
    margin-top: var(--s12);
  }

  .svc__cta-text {
    max-width: 34ch;
    font-size: var(--t-section-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .svc__cta-btn {
    margin-top: var(--s6);
    min-height: 50px;
  }

  .svc__faq-list {
    min-width: 0;
    border-top: 1px solid var(--color-line-strong);
  }

  .svc__faq-item {
    border-bottom: 1px solid var(--color-line-strong);
  }

  .svc__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 44px;
    padding: clamp(18px, 2vw, 26px) 0;
    cursor: pointer;
    list-style: none;
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-snug);
    line-height: var(--lh-snug);
  }

  .svc__q > span {
    min-width: 0;
  }

  .svc__q :global(svg) {
    color: var(--color-text-3);
    transition: transform 180ms var(--ease-out-soft);
  }

  .svc__faq-item[open] .svc__q :global(svg) {
    transform: rotate(180deg);
    color: var(--color-accent-text);
  }

  .svc__a {
    margin-top: calc(var(--s2) * -1);
    padding: 0 0 clamp(20px, 2vw, 28px);
    max-width: 62ch;
    font-size: var(--t-section-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  @media (min-width: 900px) {
    .svc__faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: clamp(40px, 7vw, 104px);
    }
  }

  /* --- related ----------------------------------------------------------- */

  /* No padding reset below 700px: there the list is a swipe row, and its
     side padding is what lines the first card up with the page gutter. */
  .svc__related {
    margin-bottom: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .svc__related {
      padding: 0;
    }
  }

  .svc__related-item {
    display: flex;
    min-width: 0;
  }

  .svc__rel {
    flex: 1;
    min-height: 268px;
  }

  @media (min-width: 700px) and (max-width: 1023px) {
    .svc__related-item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .svc__related-item:last-child:nth-child(odd) .svc__rel {
      min-height: 0;
    }
  }

  @media (min-width: 1024px) {
    .svc__rel .gcard__title {
      min-height: 2.36em;
    }
  }

  .svc__post {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s8);
  }

  @media (max-width: 640px) {
    .svc__cta-btn {
      width: 100%;
      justify-content: center;
      min-height: 54px;
    }

    .svc__post .pill-link {
      width: 100%;
      justify-content: space-between;
      padding: 10px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc__q :global(svg) {
      transition: none;
    }
  }
</style>
