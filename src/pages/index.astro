---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Diagnostics from '../components/Diagnostics.astro';
import Proof from '../components/Proof.astro';
import Payback from '../components/Payback.astro';
import Automation from '../components/Automation.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Loop from '../components/Loop.astro';
import Founders from '../components/Founders.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

/**
 * The homepage.
 *
 * It used to run twelve sections, 4,269 words and nineteen minutes of reading,
 * which is roughly four times what a page like this converts at. The stack,
 * products and the FAQ now have their own pages and the blog index already had
 * one; between them that was 40% of the words and 29 of the 35 disclosures.
 * Nothing was deleted in the move.
 *
 * Revision 2 of the automation brief sets this order:
 *
 *   Hero        the claim, and one action
 *   Diagnostics three rows naming where the money goes missing
 *   Payback     the payback map — prove it with your own numbers
 *   CaseStudy   one case, shown all the way down
 *   Proof       three more findings, as its tail
 *   Automation  ongoing reporting, once the problem and the evidence have landed
 *   Loop        the wider engagement
 *   Founders    who you would actually be talking to
 *   Contact     the one action, again
 *
 * Automation sits after the case study on purpose: a visitor meets the business
 * problem and the evidence first, and only then the service that keeps watching.
 * Leading with it would imply a platform in front of a consulting engagement.
 *
 * Proof now reads as the tail of the case-study movement, which is what the
 * approved composition asks for, but it is a SIBLING of CaseStudy rather than a
 * child of it. Folding it inside cannot work: CaseStudy is marked data-added
 * and the copy-parity check strips such blocks whole, which would take Proof's
 * signed-off copy with it. As a sibling it reads the same and survives.
 *
 * Problems is no longer on this page. It is not deleted -- /services renders it
 * in full, and Diagnostics links each row there. The audit measured it at
 * 1,441px here, a screen and a half spent before the calculator.
 */

const title = 'E2E Apps — Mobile attribution and growth for subscription apps';
/* One constant feeds the meta description, og:description and
   twitter:description. Kept in step with the hero: a search snippet or a
   shared link that advertises a claim the page no longer makes is a
   promise broken before the visitor arrives. */
const description =
  'Better signals, smarter ad spend, real app growth. I fix app attribution, uncover missed revenue, and close the gaps in your funnel.';
---

<Base title={title} description={description} path="/">
  <Schema slot="head" />
  <div class="page">
    <Nav />
    <main id="main">
      <Hero />
      <Diagnostics />
      <Payback />
      <CaseStudy />
      <Proof nested />
      <Automation />
      <Loop />
      <Founders />
      <Contact />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
    /* `clip`, not `hidden` — see global.css. `hidden` makes this a scroll
       container and the sticky nav sticks to it instead of the viewport. */
    overflow-x: clip;
  }
</style>
