---
import { EXAMPLES } from '../data/automation.ts';

/**
 * The example report: a live tabbed demonstration.
 *
 * Board: design/v3/Automation.dc.html. Four chips pick the example; the report
 * sits in a `.scene` panel as one main card (question, chart, finding, source)
 * beside three small cards (the change, the next check, the stated limit).
 *
 * Behaviour is src/scripts/investigation.ts and is asserted by
 * tests/investigation.test.ts: a real tablist, a roving tabindex, exactly one
 * selected tab, one panel per example, every state labelled as sample data.
 * The board also draws three static preview cards for the examples that are
 * not selected. They are not built: every example is already one click away,
 * and a second copy of each would state each figure twice.
 *
 * Charts: `paired` draws the focused campaign only, two bars on a common zero
 * baseline, so a finding may not cite the other campaigns (they are not on
 * screen; the portfolio context lives in `method`). `funnel` is horizontal
 * because its labels are event names. `trend` and `periods` are vertical bars,
 * with `trend` drawing the two period averages its finding quotes.
 *
 * Without JavaScript every panel renders: the first is visible, the rest carry
 * `hidden` plus a companion `display: none` rule, because an author `display`
 * beats the UA sheet's and without it all four render at once.
 *
 * Every colour is a token, so the panel is correct in both themes.
 */

interface Props {
  headingId?: string;
}

const { headingId = 'demo' } = Astro.props;

const W = 560;
const H = 132;
---

<div class="inv" data-investigation>
  <div class="tabs" role="tablist" aria-label="Example investigations">
    {
      EXAMPLES.map((e, i) => (
        <button
          type="button"
          role="tab"
          id={`${headingId}-tab-${e.id}`}
          class="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`${headingId}-panel-${e.id}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={e.id}
        >
          <span class="tab__n">{`0${i + 1}`}</span>
          <span class="tab__label">{e.tab}</span>
          <span class="tab__src">{e.source}</span>
        </button>
      ))
    }
  </div>

  {
    EXAMPLES.map((e, i) => {
      const c = e.chart;
      const pts = c.points;
      const max = Math.max(...pts.map((p) => Math.max(p.v, p.prev ?? 0)));
      const money = (v: number) => `${c.prefix ?? ''}${v.toLocaleString('en-US')}`;

      const n = pts.length;
      const gap = 12;
      const bw = (W - gap * (n - 1)) / n;

      const split = c.splitAfter ?? -1;
      const mean = (f: number, t: number) => pts.slice(f, t).reduce((s, p) => s + p.v, 0) / (t - f);
      const avgA = split >= 0 ? mean(0, split + 1) : 0;
      const avgB = split >= 0 ? mean(split + 1, n) : 0;

      const focus = pts[c.focus]!;

      return (
        <div
          role="tabpanel"
          id={`${headingId}-panel-${e.id}`}
          aria-labelledby={`${headingId}-tab-${e.id}`}
          class="panel scene"
          data-panel={e.id}
          hidden={i !== 0}
          tabindex="0"
        >
          <div class="dcard rep">
            <p class="rep__meta">
              <span class="rep__kicker">Example investigation</span>
              <span class="rep__sample">Sample data</span>
            </p>

            <p class="rep__q">{e.question}</p>

            <figure class="rep__chart">
              <figcaption class="rep__cap">{c.caption}</figcaption>

              {c.kind === 'paired' ? (
                /* Two bars, one campaign, common zero baseline. */
                <div class="pair">
                  <p class="pair__who">{focus.label}</p>
                  <div class="pair__row">
                    <span class="pair__label">Previous</span>
                    <span class="pair__track">
                      <span
                        class="pair__bar pair__bar--prev"
                        style={`width:${(((focus.prev ?? 0) / max) * 100).toFixed(1)}%`}
                      />
                    </span>
                    <span class="pair__v">{money(focus.prev ?? 0)}</span>
                  </div>
                  <div class="pair__row pair__row--now">
                    <span class="pair__label">Current</span>
                    <span class="pair__track">
                      <span
                        class="pair__bar pair__bar--now"
                        style={`width:${((focus.v / max) * 100).toFixed(1)}%`}
                      />
                    </span>
                    <span class="pair__v">{money(focus.v)}</span>
                  </div>
                </div>
              ) : c.kind === 'funnel' ? (
                <div class="funnel">
                  {pts.map((p, bi) => (
                    <div class:list={['fstep', { 'fstep--focus': bi === c.focus }]}>
                      <span class="fstep__label">{p.label}</span>
                      <span class="fstep__track">
                        <span class="fstep__bar" style={`width:${((p.v / max) * 100).toFixed(1)}%`} />
                      </span>
                      <span class="fstep__v">{p.v.toLocaleString('en-US')}</span>
                    </div>
                  ))}
                </div>
              ) : (
                <>
                  <svg
                    viewBox={`0 0 ${W} ${H}`}
                    preserveAspectRatio="none"
                    role="img"
                    aria-label={`${c.caption}. ${pts.map((p) => `${p.label} ${money(p.v)}`).join('. ')}.`}
                  >
                    {split >= 0 && (
                      <Fragment>
                        <line
                          x1="0"
                          y1={H - (avgA / max) * H}
                          x2={(split + 1) * (bw + gap) - gap}
                          y2={H - (avgA / max) * H}
                          stroke="var(--chart-rule)"
                          stroke-width="1"
                          stroke-dasharray="4 4"
                          vector-effect="non-scaling-stroke"
                        />
                        <line
                          x1={(split + 1) * (bw + gap)}
                          y1={H - (avgB / max) * H}
                          x2={W}
                          y2={H - (avgB / max) * H}
                          stroke="var(--chart-true)"
                          stroke-width="1"
                          stroke-dasharray="4 4"
                          vector-effect="non-scaling-stroke"
                        />
                      </Fragment>
                    )}

                    {pts.map((p, bi) => {
                      const hv = (p.v / max) * H;
                      return (
                        <rect
                          x={bi * (bw + gap)}
                          y={H - hv}
                          width={bw}
                          height={hv}
                          rx="3"
                          fill={bi === c.focus ? 'var(--color-accent)' : 'var(--chart-bar-dim)'}
                        />
                      );
                    })}
                  </svg>

                  {/* HTML, not SVG <text>: inside the viewBox a label scales
                      with the container and lands near 7px on a phone. */}
                  <ul class="ticks">
                    {pts.map((p, bi) => (
                      <li class:list={['tick', { 'tick--focus': bi === c.focus }]}>
                        <span class="tick__v">{money(p.v)}</span>
                        <span class="tick__l">{p.label}</span>
                      </li>
                    ))}
                  </ul>

                  {split >= 0 && (
                    <p class="rep__legend">
                      <span class="rep__key" aria-hidden="true" />
                      Period averages, {money(Math.round(avgA))} then {money(Math.round(avgB))}
                    </p>
                  )}
                </>
              )}
            </figure>

            <p class="rep__finding">{e.finding}</p>

            <div class="rep__foot">
              <span class="rep__src">
                {e.source} · {e.period}
              </span>
              <details class="rep__method">
                <summary>View method</summary>
                <div>
                  {e.method.map((m) => (
                    <p>{m}</p>
                  ))}
                </div>
              </details>
            </div>
          </div>

          <div class="side">
            <div class="dcard dcard--raised side__card side__card--change">
              <span class="dcard__label">The change</span>
              <span class="side__v tabular">{e.change.value}</span>
              <span class="side__note">{e.change.note}</span>
            </div>

            <div class="dcard side__card">
              <span class="dcard__label side__amber">Next check</span>
              <p class="side__next">{e.next}</p>
            </div>

            <div class="dcard side__card">
              <span class="dcard__label">Method</span>
              <p class="side__limit">{e.limit}</p>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  import { initInvestigation } from '../scripts/investigation';
  initInvestigation();
</script>

<style>
  .inv {
    min-width: 0;
  }

  /* --- selectors: four chips, the selected one filled ---------------------- */

  .tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  @media (min-width: 900px) {
    .tabs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
  }

  .tab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 12px;
    min-width: 0;
    min-height: 56px;
    padding: 10px 20px;
    border: 0;
    border-radius: 28px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    color: var(--color-text);
    font-family: var(--font-body);
    text-align: left;
    cursor: pointer;
    transition:
      background 160ms var(--ease-out-soft),
      box-shadow 160ms var(--ease-out-soft);
  }

  .tab__n {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-meta);
    color: var(--color-accent-text);
  }

  .tab__label {
    min-width: 0;
    font-size: var(--t-body);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-snug);
    line-height: var(--lh-tight);
  }

  .tab__src {
    min-width: 0;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    color: var(--color-text-4);
  }

  .tab:hover {
    box-shadow: inset 0 0 0 1px var(--color-line-hover);
  }

  /* Amber as a fill, so everything on it is ink. */
  .tab[aria-selected='true'] {
    background: var(--color-accent);
    box-shadow: none;
    color: var(--color-ink);
  }

  .tab[aria-selected='true'] .tab__n,
  .tab[aria-selected='true'] .tab__src {
    color: var(--color-ink);
  }

  .tab:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 3px;
  }

  @media (max-width: 520px) {
    .tab {
      padding: 10px 16px;
      border-radius: 18px;
    }

    .tab__label {
      font-size: var(--t-body-sm);
    }

    /* Under the label rather than squeezed beside it. */
    .tab__src {
      flex-basis: 100%;
      margin-left: 0;
    }
  }

  /* --- the report panel ---------------------------------------------------- */

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
    margin-top: 12px;
    padding: clamp(12px, 3.2vw, 44px);
    min-height: 0;
  }

  /* An author `display` beats `[hidden] { display: none }` in the UA sheet. */
  .panel[hidden] {
    display: none;
  }

  @media (min-width: 960px) {
    .panel {
      grid-template-columns: minmax(0, 1.68fr) minmax(0, 1fr);
    }
  }

  .panel:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 3px;
    border-radius: 24px;
  }

  .rep {
    display: flex;
    flex-direction: column;
    gap: var(--s8);
    min-width: 0;
    padding: clamp(18px, 2.6vw, 32px);
  }

  /* The shared card shadow is a fixed black, which smears on the light ground;
     here it follows the theme. */
  .rep,
  .side__card {
    box-shadow:
      0 0 0 1px var(--color-line-strong),
      var(--shadow-card-hover);
  }

  .rep__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3) var(--s6);
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .rep__kicker {
    color: var(--color-accent-text);
  }

  .rep__sample {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    letter-spacing: var(--ls-chip);
    color: var(--color-text-2);
  }

  .rep__q {
    margin-top: calc(var(--s4) * -1);
    padding-bottom: var(--s8);
    border-bottom: 1px solid var(--color-line-strong);
    font-family: var(--font-heading);
    font-size: clamp(22px, 2.3vw, 30px);
    font-weight: var(--fw-bold);
    line-height: 1.16;
    letter-spacing: var(--ls-h3);
    color: var(--color-text);
    text-wrap: balance;
  }

  .rep__chart {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    min-width: 0;
  }

  .rep__cap {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-4);
  }

  .rep__finding {
    padding-top: var(--s8);
    border-top: 1px solid var(--color-line-strong);
    font-size: clamp(16px, 1.45vw, 19px);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-snug);
    color: var(--color-text);
  }

  .rep__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--s6);
    margin-top: auto;
  }

  .rep__src {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-meta);
    color: var(--color-text-4);
  }

  .rep__method {
    min-width: 0;
  }

  /* Open, the method takes the full width under the source line. */
  .rep__method[open] {
    flex-basis: 100%;
  }

  .rep__method summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-disclosure);
    color: var(--color-text-2);
    list-style: none;
  }

  .rep__method summary::-webkit-details-marker {
    display: none;
  }

  .rep__method summary::after {
    content: '+';
    margin-left: 0.5em;
    color: var(--color-accent-text);
  }

  .rep__method[open] summary::after {
    content: '\2212';
  }

  .rep__method summary:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 3px;
  }

  .rep__method p {
    margin: 0 0 var(--s4);
    max-width: 68ch;
    font-size: var(--t-card-sm);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  /* --- the three cards beside the report ----------------------------------- */

  .side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    gap: 12px;
    min-width: 0;
  }

  .side__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(16px, 1.8vw, 22px);
  }

  /* The one figure that carries the story. */
  .side__card--change {
    box-shadow:
      var(--ring-accent),
      var(--shadow-card-hover);
  }

  .side__v {
    margin-top: var(--s3);
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.6vw, 50px);
    font-weight: var(--fw-bold);
    line-height: 1.1;
    letter-spacing: var(--ls-h1);
    color: var(--color-accent-text);
    overflow-wrap: anywhere;
  }

  .side__note {
    margin-top: var(--s2);
    font-size: var(--t-body-sm);
    color: var(--color-text-2);
  }

  .side__amber {
    color: var(--color-accent-text);
  }

  .side__next {
    margin-top: var(--s3);
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--color-text);
  }

  .side__limit {
    margin-top: var(--s3);
    font-size: var(--t-card-sm);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  /* --- paired bars --------------------------------------------------------- */

  .pair {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .pair__who {
    font-size: var(--t-body-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .pair__row {
    display: grid;
    grid-template-columns: minmax(0, 5em) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4);
  }

  .pair__label {
    font-size: var(--t-card-sm);
    color: var(--color-text-2);
  }

  .pair__track,
  .fstep__track {
    display: block;
    min-width: 0;
  }

  .pair__bar {
    display: block;
    height: 26px;
    border-radius: 5px;
  }

  .pair__bar--prev {
    background: var(--chart-bar-dim);
  }

  .pair__bar--now {
    background: var(--color-accent);
  }

  .pair__v {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-2);
    white-space: nowrap;
  }

  .pair__row--now .pair__label,
  .pair__row--now .pair__v {
    color: var(--color-accent-text);
  }

  /* --- funnel -------------------------------------------------------------- */

  .funnel {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .fstep {
    display: grid;
    grid-template-columns: minmax(0, 10.5em) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4);
  }

  .fstep__label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    line-height: var(--lh-snug);
    color: var(--color-text-3);
    overflow-wrap: anywhere;
  }

  .fstep__bar {
    display: block;
    height: 16px;
    border-radius: 4px;
    background: var(--chart-bar-dim);
  }

  .fstep--focus .fstep__bar {
    background: var(--color-accent);
  }

  .fstep--focus .fstep__label,
  .fstep--focus .fstep__v {
    color: var(--color-accent-text);
  }

  .fstep__v {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-3);
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .fstep {
      grid-template-columns: minmax(0, 7.6em) minmax(0, 1fr) auto;
      gap: var(--s3);
    }

    .fstep__label,
    .fstep__v {
      font-size: var(--t-mono-3xs);
    }
  }

  /* --- vertical bars ------------------------------------------------------- */

  .rep__chart svg {
    display: block;
    width: 100%;
    height: 132px;
  }

  .ticks {
    list-style: none;
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    align-items: start;
  }

  .tick {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-align: center;
  }

  .tick__v,
  .tick__l {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    line-height: var(--lh-snug);
    overflow-wrap: anywhere;
  }

  .tick__v {
    font-variant-numeric: tabular-nums;
    color: var(--color-text-3);
  }

  .tick__l {
    color: var(--color-text-4);
  }

  .tick--focus .tick__v,
  .tick--focus .tick__l {
    color: var(--color-accent-text);
  }

  @media (max-width: 520px) {
    .ticks {
      gap: 4px;
    }

    .tick__v,
    .tick__l {
      font-size: 9.5px;
    }
  }

  .rep__legend {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    color: var(--color-text-3);
  }

  .rep__key {
    width: 14px;
    flex: none;
    border-top: 1px dashed var(--chart-true);
  }
</style>
