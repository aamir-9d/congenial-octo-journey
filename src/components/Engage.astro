---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
import { SERVICES } from '../data/services';

/**
 * "Pick your situation" and the ways to work together, on /services.
 *
 * Board: design/v3/Services.dc.html. Situations are full-width rows on a band,
 * each pointing to the page that answers it. The three engagement shapes are
 * glow cards, the free first look being the lead; no price is published, as on
 * the rest of the site ("figures on a call").
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const name = (slug: string) => SERVICES.find((s) => s.slug === slug)!.name;

const SITUATIONS = [
  { when: 'Your MMP and ad platforms disagree, or paid installs show up as organic', path: '/services/mobile-attribution-audit', label: name('mobile-attribution-audit') },
  { when: 'iOS campaigns report almost nothing, or you are setting up SKAN and AdAttributionKit', path: '/services/skan-adattributionkit-setup', label: name('skan-adattributionkit-setup') },
  { when: 'ATT consent looks wrong (near 0% or 100%), or installs arrive without an advertising ID', path: '/services/att-consent-timing', label: name('att-consent-timing') },
  { when: 'You are starting with an MMP, or adding events and ad partners', path: '/services/event-tracking-plan', label: name('event-tracking-plan') },
  { when: 'Renewals are missing and subscription ROAS looks too low', path: '/services/subscription-revenue-tracking', label: name('subscription-revenue-tracking') },
  { when: 'You want to know when your spend pays back', path: '/payback-calculator', label: 'Payback calculator' },
  { when: 'Your team builds the weekly growth report by hand', path: '/automation', label: 'AI reporting & automation' },
];

interface Way {
  icon: IconName;
  title: string;
  text: string;
  href: string;
  go: string;
  lead?: boolean;
  glow: [string, string];
}

const WAYS: Way[] = [
  {
    icon: 'magnifying-glass',
    title: 'Fixed-price audit',
    text: "A full review of the measurement stack, the gaps ranked by what each is costing, and a written remediation plan. The usual starting point, because it tells both of us whether more work is worth anyone's money.",
    href: '/services/mobile-attribution-audit',
    go: 'See the audit',
    glow: ['100%', '0%'],
  },
  {
    icon: 'arrows-clockwise',
    title: 'Monthly retainer',
    text: 'The fixes get implemented and the campaigns get run, by the people who found the problems.',
    href: '/#contact',
    go: 'Book a call',
    glow: ['0%', '100%'],
  },
  {
    icon: 'paper-plane-tilt',
    title: 'Free first look',
    text: "Send your app's store link and we reply in writing with three measurement checks for it. No call needed.",
    href: '/#contact',
    go: 'Send your app link',
    lead: true,
    glow: ['100%', '100%'],
  },
];
---

<section id="situations" class="section section--band" data-section="situations">
  <div class="wrap">
    <div class="shead" data-reveal="1">
      <p class="shead__label">Where to start</p>
      <h2 class="shead__title">Pick your situation.</h2>
      <p class="shead__aside">Each one points to the page that deals with it.</p>
    </div>
    <ul class="sbody eng__sit" role="list">
      {
        SITUATIONS.map((s) => (
          <li>
            <a class="eng__row" href={`${base}${s.path}`}>
              <span class="eng__when">{s.when}</span>
              <span class="eng__go">
                {s.label}
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="engage" class="section" data-section="engage">
  <div class="wrap">
    <div class="shead" data-reveal="1">
      <p class="shead__label">Ways to work together</p>
      <h2 class="shead__title">Start with an audit. Keep going if it is worth it.</h2>
      <p class="shead__aside">Prices are given on a call, once the size of the stack is clear.</p>
    </div>
    <div class="sbody">
    <div class="ggrid ggrid--3 swipe" data-swipe>
      {
        WAYS.map((w) => (
          <div
            class:list={['gcard', 'eng__way', { 'gcard--lead': w.lead }]}
            style={`--gx:${w.glow[0]};--gy:${w.glow[1]}`}
          >
            <span class="gcard__icon">
              <Icon name={w.icon} size={24} />
            </span>
            <h3 class="gcard__title">{w.title}</h3>
            <p class="gcard__text">{w.text}</p>
            <a class="gcard__go" href={`${base}${w.href}`}>
              {w.go}
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        ))
      }
    </div>
    <div class="swipe__meta" data-swipe-meta aria-hidden="true">
      <span class="swipe__dots" data-swipe-dots>{WAYS.map(() => <i />)}</span>
      <span data-swipe-count>1 of {WAYS.length}</span>
    </div>
    </div>
  </div>
</section>

<style>
  .eng__sit {
    margin-bottom: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line-strong);
  }

  .eng__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s2);
    align-items: center;
    padding: var(--s6) 0;
    border-bottom: 1px solid var(--color-line-strong);
    color: inherit;
  }

  .eng__when {
    min-width: 0;
    font-size: clamp(16.5px, 1.5vw, 19px);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--color-text);
  }

  .eng__go {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    min-width: 0;
    min-height: 28px;
    font-weight: var(--fw-semibold);
    font-size: var(--t-body);
    color: var(--color-accent-text);
  }

  .eng__go :global(svg) {
    transition: transform 180ms var(--ease-out-soft);
  }

  .eng__row:hover .eng__go :global(svg),
  .eng__row:focus-visible .eng__go :global(svg) {
    transform: translateX(4px);
  }

  /* Three cards in two columns: the lead card closes the row. */
  @media (min-width: 700px) and (max-width: 1023px) {
    .eng__way:last-child {
      grid-column: 1 / -1;
      min-height: 0;
    }
  }

  @media (min-width: 900px) {
    .eng__row {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--s8);
      padding: 26px 0;
    }

  }

  @media (min-width: 1024px) {
    .eng__way {
      min-height: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eng__go :global(svg) {
      transition: none;
    }
  }
</style>
