---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Schema from '../components/Schema.astro';

/**
 * FAQ.
 *
 * Board: design/v3/Faq.dc.html.
 *
 * This was 29% of the homepage -- 1,211 words and nineteen disclosures, more
 * than any other section, sitting in front of visitors who had not yet asked
 * a question. It is reference material and belongs on a page people arrive at
 * deliberately.
 *
 * Every question and answer is unchanged; src/data/faq.ts is still the single
 * source, and it still feeds the FAQPage structured data.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'Mobile Attribution & App Growth FAQ — E2E Apps';
const description =
  'Nineteen questions about working together and technical scope: pricing, timelines, access, MMPs, SKAdNetwork, web-to-app and subscription revenue.';
---

<Base title={title} description={description} path="/faq">
  <Schema slot="head" faq />
  <div class="page">
    <Nav />
    <main id="main">
      <Breadcrumbs trail={[{ name: 'FAQ', path: '/faq' }]} />
      <PageHero
        label="Before you book"
        title="Mobile attribution audit FAQ"
        line="Questions people ask before booking."
        lead="Answered by E2E Apps, including the ones that are awkward to answer."
        cta={{ href: `${base}/#contact`, text: 'Get a free first look' }}
        section="faq-hero"
      />
      <Faq />
      <Cta />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }
</style>
