---
/**
 * The Full Loop, as an orbit.
 *
 * Built to docs/design-explorations/loop-orbit-{desktop,mobile,detail}.png,
 * which supersede the north/east/south/west diamond and the four-column
 * arrangement before it.
 *
 * ── Why the ring and the connectors are one SVG ─────────────────────────
 *
 * The connectors have to meet the nodes at every width. Drawing them in a
 * separate coordinate space from the ring means two systems that agree only at
 * the width they were tuned at, and the first resize separates them. So the
 * ring, its nodes, its arrowheads and all four connectors live in one viewBox
 * that fills the centre grid column: a connector running to the SVG's own edge
 * necessarily meets the card beside it, whatever that column is currently
 * measuring.
 *
 * Every coordinate below is computed from the circle rather than typed. The
 * previous diamond had its arrowheads placed by eye and all four sat off the
 * ring.
 *
 * ── Copy ────────────────────────────────────────────────────────────────
 *
 * Cards carry the short description and outcome the sketch shows. The full
 * signed-off service prose is preserved verbatim as the detail lead — it is
 * what a buyer scopes against, and it is not something to summarise away.
 */

const stations = [
  {
    n: '01',
    title: 'Instrument',
    desc: 'Get events, consent and server delivery working together.',
    out: 'A reliable source signal.',
    headline: 'Get the raw signal right.',
    body: 'Get the raw signal right at the source. Event taxonomy and naming, a written tracking plan the developers can actually implement, SDK integration and QA, consent and ATT prompt sequencing, debug and sandbox validation before anything ships.',
    outcome:
      'Events fire when they should, named what they should be, carrying what they should carry.',
    included: [
      'Event taxonomy and naming',
      'A written tracking plan',
      'SDK integration and QA',
      'Consent and ATT sequencing',
      'Debug and sandbox validation',
    ],
  },
  {
    n: '02',
    title: 'Attribute',
    desc: 'Connect installs and revenue to sources. Check the gaps in reporting.',
    out: 'Attribution you can inspect.',
    headline: 'Trace the money to its source.',
    body: 'Connect the signal to a source. MMP configuration and audit, SKAdNetwork and AdAttributionKit conversion schemas, attribution window alignment, server-to-server events, deferred deep linking, conversion APIs to every ad platform, web-to-app click capture.',
    outcome: 'Every install and every dollar traceable to the click that caused it.',
    included: [
      'MMP configuration and audit',
      'SKAN and AdAttributionKit schemas',
      'Attribution window alignment',
      'Server-to-server events and deep linking',
      'Conversion APIs and web-to-app capture',
    ],
  },
  {
    n: '03',
    title: 'Decide',
    desc: 'Use retention, LTV and payback to set spending limits by market.',
    out: 'A defensible acquisition ceiling.',
    headline: 'Turn clean data into a limit.',
    body: 'Turn clean data into a spending decision. Cohort LTV and retention decay, CAC payback curves by channel and by country, trial-to-paid economics, breakeven ceilings per market, paywall funnel diagnosis.',
    outcome:
      'A defensible number for what you can afford to pay for a user — market by market.',
    included: [
      'Cohort LTV and retention decay',
      'Payback curves by channel and country',
      'Trial-to-paid economics',
      'Breakeven ceilings per market',
      'Paywall funnel diagnosis',
    ],
  },
  {
    n: '04',
    title: 'Deploy',
    desc: 'Run campaigns and monetisation tests. Feed the results back into measurement.',
    out: 'Spend informed by evidence.',
    headline: 'Spend against those numbers.',
    body: 'Spend against those numbers. Google Ads app and web-to-app campaigns, Apple Ads, Meta, TikTok, ASO and store listing strategy, paywall and pricing tests, ad monetisation and mediation.',
    outcome:
      'Budget deployed where the arithmetic says it works — and fresh signal flowing back into Station 01.',
    included: [
      'Google Ads app and web-to-app campaigns',
      'Apple Ads, Meta and TikTok',
      'ASO and store listing strategy',
      'Paywall and pricing tests',
      'Ad monetisation and mediation',
    ],
  },
];

/* --- ring geometry, derived ---------------------------------------------- */

const CX = 160;
const CY = 220;
const R = 122; // 244px diameter at the reference size
const NR = 17; // node radius
const VW = 320;

const polar = (deg: number, radius = R) => {
  const rad = (deg * Math.PI) / 180;
  return { x: CX + radius * Math.cos(rad), y: CY + radius * Math.sin(rad) };
};

/** Diagonals, so each node points at the card in its corner. */
const NODE_ANGLE: Record<string, number> = { '01': 225, '02': 315, '03': 45, '04': 135 };

const round = (n: number) => Math.round(n * 10) / 10;

const ring = stations.map((s) => {
  const p = polar(NODE_ANGLE[s.n]!);
  const left = s.n === '01' || s.n === '04';
  const top = s.n === '01' || s.n === '02';

  /* The connector runs past the SVG's own edge at the height of that card's
     row, so it meets the card whatever width the centre column resolves to.

     The overshoot covers the grid's column gap: the SVG's own edge sits one
     gutter short of the card, so a connector ending exactly at the viewBox
     boundary stops visibly short of the thing it is meant to be connecting.
     The SVG renders with `overflow: visible` so the tail is drawn. */
  const OVER = 20;
  const edge = { x: left ? -OVER : VW + OVER, y: top ? 110 : 330 };
  const dx = edge.x - p.x;
  const dy = edge.y - p.y;
  const len = Math.hypot(dx, dy);

  return {
    n: s.n,
    x: round(p.x),
    y: round(p.y),
    // Start at the node's edge, not its centre, so the line never crosses it.
    sx: round(p.x + (dx / len) * NR),
    sy: round(p.y + (dy / len) * NR),
    ex: edge.x,
    ey: edge.y,
  };
});

/** Stationary arrowheads at the cardinal points, pointing clockwise. */
const arrows = [270, 0, 90, 180].map((deg) => {
  const p = polar(deg);
  return { x: round(p.x), y: round(p.y), rot: (deg + 90) % 360 };
});
---

<section id="loop" class="section" data-section="loop">
  <div class="wrap">
    <div class="orbit__head">
      <div>
        <p class="orbit__eyebrow">05 / How we work</p>
        <h2 class="orbit__h2">The Full Loop</h2>
      </div>
      <p class="orbit__lead">
        Measurement informs the spend.<br />The results improve the next decision.
      </p>
    </div>

    <div class="orbit" data-orbit>
      {
        stations.map((s, i) => (
          <article class={`card card--${s.n}`} data-card={s.n} style={`--card-order:${(i + 1) * 2}`}>
            <div class="card__top">
              <span class="card__badge">{s.n}</span>
              <h3 class="card__title">{s.title}</h3>
            </div>

            <p class="card__desc">{s.desc}</p>

            <p class="card__out">{s.out}</p>

            <button
              type="button"
              class="card__more"
              data-loop-trigger={s.n}
              aria-expanded="true"
              aria-controls={`loop-scope-${s.n}`}
            >
              Explore scope
              <span class="card__sign" aria-hidden="true"></span>
            </button>
          </article>
        ))
      }

      {/* Decorative. Every number, name and relationship is real text in the
          cards and the sequence line, so nothing here is the only source of
          anything. */}
      <div class="orbit__ring" aria-hidden="true">
        <svg viewBox={`0 0 ${VW} 440`} preserveAspectRatio="xMidYMid meet" focusable="false">
          {
            ring.map((r) => (
              <line
                x1={r.sx}
                y1={r.sy}
                x2={r.ex}
                y2={r.ey}
                stroke="var(--color-line-strong)"
                stroke-width="1"
              />
            ))
          }

          <circle cx={CX} cy={CY} r={R} fill="none" stroke="var(--color-line-strong)" stroke-width="1" />
          <circle cx={CX} cy={CY} r={R - 32} fill="none" stroke="var(--color-line)" stroke-width="1" />

          <g fill="var(--color-accent)">
            {
              arrows.map((a) => (
                <path d="M-4.5 -3.5 L 4.5 0 L -4.5 3.5 Z" transform={`translate(${a.x} ${a.y}) rotate(${a.rot})`} />
              ))
            }
          </g>

          <circle class="orbit__dot" r="3.5" fill="var(--color-accent)">
            <animateMotion
              dur="20s"
              repeatCount="indefinite"
              path={`M ${CX} ${CY - R} A ${R} ${R} 0 1 1 ${CX - 0.1} ${CY - R}`}
            />
          </circle>

          {
            ring.map((r) => (
              <g class="orbit__node" data-node={r.n}>
                <circle cx={r.x} cy={r.y} r={NR} fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="1" />
                <text x={r.x} y={r.y + 4} text-anchor="middle" class="orbit__node-n">
                  {r.n}
                </text>
              </g>
            ))
          }

          <text x={CX} y={CY - 18} text-anchor="middle" class="orbit__centre">Learn.</text>
          <text x={CX} y={CY + 8} text-anchor="middle" class="orbit__centre">Improve.</text>
          <text x={CX} y={CY + 34} text-anchor="middle" class="orbit__centre">Repeat.</text>
        </svg>
      </div>

      {/* One shared panel. Open in the markup so the scope survives with
          scripting off; the script collapses them and wires the triggers. */}
      <div class="scopes">
        {
          stations.map((s) => (
            <div
              class="scope"
              id={`loop-scope-${s.n}`}
              data-loop-panel={s.n}
              role="region"
              aria-label={`Station ${s.n}, ${s.title} — full scope`}
            >
              <div class="scope__main">
                <p class="scope__eyebrow">
                  Station {s.n} / {s.title}
                </p>
                <h4 class="scope__h4">{s.headline}</h4>
                <p class="scope__body">{s.body}</p>
                <p class="scope__outcome">Outcome: {s.outcome}</p>
              </div>

              <div class="scope__side">
                <p class="scope__side-label">Included in this stage</p>
                <ul class="scope__list">
                  {s.included.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>

              <button type="button" class="scope__close" data-loop-close={s.n}>
                <span class="visually-hidden">Close the {s.title} scope</span>
                <span aria-hidden="true">&#215;</span>
              </button>
            </div>
          ))
        }
      </div>
    </div>

    <div class="orbit__foot">
      <p class="orbit__seq">01 &#8594; 02 &#8594; 03 &#8594; 04 &#8594; 01</p>
      <p class="orbit__close">Fresh results flow back into measurement. That closes the loop.</p>
      {/* Signed-off copy. The line above describes the mechanism; this is the
          claim the section is making, and dropping it would cost the argument. */}
      <p class="orbit__claim">
        Most consultants stop after Station 02. The loop only closes when the same person walks all
        four.
      </p>
    </div>
  </div>
</section>

<script>
  import { initLoop } from '../scripts/loop';
  initLoop();
</script>

<style>
  /* --- header --------------------------------------------------------------- */

  .orbit__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s8) var(--s16);
  }

  .orbit__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .orbit__h2 {
    margin-top: var(--s4);
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--color-text);
  }

  .orbit__lead {
    margin-left: auto;
    max-width: 38ch;
    font-size: var(--t-section-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  /* --- the arrangement ------------------------------------------------------ */

  /* Mobile first: ring, then the four cards in order, then the scope. The
     desktop composition is not shrunk — below 1024px it becomes a stack, which
     is what loop-orbit-mobile.png shows. */
  .orbit {
    /* Declared here so it always resolves. The script overwrites it with the
       selected card's order; 99 keeps the panel last until one is chosen. */
    --scope-order: 99;

    margin-top: clamp(32px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    gap: var(--s6);
  }

  .orbit__ring {
    order: 0;
    max-width: 300px;
    margin: 0 auto var(--s4);
  }

  .orbit__ring svg {
    display: block;
    width: 100%;
    height: auto;
    /* The connector tails are drawn outside the viewBox on purpose. */
    overflow: visible;
  }

  .card {
    order: var(--card-order);
  }

  /* On a phone the scope opens directly beneath the card it belongs to. The
     script sets --scope-order from the selected card. */
  .scopes {
    order: var(--scope-order);
  }

  @media (min-width: 1024px) {
    .orbit {
      display: grid;
      grid-template-columns: minmax(0, 34fr) minmax(min(260px, 100%), 32fr) minmax(0, 34fr);
      grid-template-rows: auto auto auto;
      column-gap: var(--s6);
      row-gap: 52px;
      align-items: stretch;
    }

    .card {
      order: 0;
    }

    .card--01 { grid-column: 1; grid-row: 1; }
    .card--02 { grid-column: 3; grid-row: 1; }
    .card--03 { grid-column: 3; grid-row: 2; }
    .card--04 { grid-column: 1; grid-row: 2; }

    .orbit__ring {
      grid-column: 2;
      grid-row: 1 / 3;
      order: 0;
      max-width: none;
      margin: 0;
      align-self: stretch;
      display: flex;
      align-items: center;
    }

    .scopes {
      grid-column: 1 / -1;
      grid-row: 3;
      order: 0;
    }
  }

  /* --- station cards -------------------------------------------------------- */

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--ring);
    min-width: 0;
  }

  .card__top {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .card__badge {
    flex: none;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-sunk);
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    color: var(--color-accent);
  }

  .card__title {
    font-size: var(--t-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    color: var(--color-text);
  }

  .card__desc {
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  /* Pushed to the foot so the four cards line up their outcome and action even
     when the descriptions run to different lengths. */
  .card__out {
    margin-top: auto;
    padding-top: var(--s4);
    border-top: 1px solid var(--color-line);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text);
  }

  .card__more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    width: 100%;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--t-card-sm);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-align: left;
    cursor: pointer;
  }

  .card__more:hover {
    color: var(--color-accent-hover);
  }

  .card__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .card__sign::before {
    content: '+';
    font-size: 1.1em;
  }

  .card__more[aria-expanded='true'] .card__sign::before {
    content: '\2212';
  }

  .card--open {
    box-shadow: var(--ring-accent);
  }

  /* --- the ring ------------------------------------------------------------- */

  /* A hook for the script and the selected-state modifier below. */
  .orbit__node circle {
    transition: fill 160ms var(--ease-out-soft);
  }

  .orbit__node-n {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--color-accent);
  }

  /* The selected station's node fills, so the diagram says which scope is open. */
  .orbit__node--on circle {
    fill: var(--color-accent);
  }

  .orbit__node--on .orbit__node-n {
    fill: var(--color-bg);
  }

  .orbit__centre {
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: var(--fw-semibold);
    fill: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit__dot {
      display: none;
    }
  }

  /* --- the shared scope panel ----------------------------------------------- */

  .scopes {
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    min-width: 0;
  }

  .scope {
    position: relative;
    display: grid;
    gap: var(--s8);
    grid-template-columns: minmax(0, 1fr);
    padding: var(--s12);
    border-radius: var(--radius-card);
    background: var(--color-surface-sunk);
    box-shadow: var(--ring);
    min-width: 0;
  }

  @media (min-width: 860px) {
    .scope {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--s16);
    }
  }

  .scope[hidden] {
    display: none;
  }

  /* Both grid children need a zero floor or a long unbroken token in either
     one widens the panel instead of wrapping. */
  .scope__main,
  .scope__side {
    min-width: 0;
  }

  .scope__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .scope__h4 {
    margin-top: var(--s4);
    font-size: var(--t-h2-card);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2-card);
    color: var(--color-text);
    text-wrap: balance;
  }

  .scope__body {
    margin-top: var(--s6);
    max-width: 64ch;
    font-size: var(--t-card);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .scope__outcome {
    margin-top: var(--s6);
    max-width: 64ch;
    font-size: var(--t-card-sm);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  .scope__side-label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-4);
  }

  .scope__list {
    list-style: none;
    margin: var(--s6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .scope__close {
    position: absolute;
    top: var(--s6);
    right: var(--s6);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: 20px;
    line-height: 1;
    color: var(--color-text-3);
    cursor: pointer;
  }

  .scope__close:hover {
    color: var(--color-text);
  }

  .scope__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* --- foot ----------------------------------------------------------------- */

  .orbit__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s4) var(--s16);
    margin-top: clamp(32px, 4vw, 56px);
    padding-top: var(--s8);
    border-top: 1px solid var(--color-line);
  }

  .orbit__seq {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-meta);
    color: var(--color-accent);
  }

  .orbit__close {
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .orbit__claim {
    flex-basis: 100%;
    max-width: 92ch;
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }
</style>
