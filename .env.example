# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The site itself is static and needs none of these at build time. The PUBLIC_
# ones are inlined into the page and are safe to expose (they are visible in any
# browser's network tab regardless). Everything without the prefix is a secret
# that belongs in the Cloudflare Worker, set via `npx wrangler secret put NAME`,
# never in this file on a deployed machine.

# --- Deployment target -------------------------------------------------------
# Defaults target the GitHub Pages project URL. For the custom domain:
#   SITE_URL=https://e2eapps.com
#   SITE_BASE=/
SITE_URL=https://aamir-9d.github.io
SITE_BASE=/congenial-octo-journey

# --- Client-side, inlined into the page --------------------------------------
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_FORM_LABEL=xxxxxxxxxxxxxxxxx
PUBLIC_GOOGLE_ADS_BOOKING_LABEL=xxxxxxxxxxxxxxxxx
PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min
# Where the static form posts. The Cloudflare Worker, not GitHub Pages —
# Pages cannot run server code.
PUBLIC_FORM_ENDPOINT=https://e2e-apps-forms.<subdomain>.workers.dev/submit

# --- Worker secrets (set with `wrangler secret put`, not here) ---------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_TO=hello@e2eapps.com
RESEND_FROM=forms@e2eapps.com

META_PIXEL_ID=xxxxxxxxxxxxxxx
META_CAPI_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx

LINKEDIN_CAPI_TOKEN=AQVxxxxxxxxxxxxxxxxxxxx
LINKEDIN_CONVERSION_ID=00000000

# Server-side GA4 fallback, so a conversion still lands if the browser beacon
# is blocked.
GA4_API_SECRET=xxxxxxxxxxxxxxxxxxxxxx
