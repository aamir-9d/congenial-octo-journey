---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Investigation from '../components/Investigation.astro';
import { STEPS, OUTCOMES, DISCLOSURES } from '../data/automation.ts';

/**
 * /automation
 *
 * Rebuilt against docs/automation-visual-revision.md. The previous version was
 * 621 words of prose with no imagery and nearly 5,000px of phone scrolling; the
 * service was described and never demonstrated.
 *
 * Four sections now, in the order the brief sets:
 *
 *   1  Hero and the investigation canvas — the promise, the sources, a visible
 *      output, and a contextual CTA rather than only the nav's general one
 *   2  Three outcomes, one sentence each
 *   3  Connect → Investigate → Review, with the technical detail in three
 *      labelled disclosures
 *   4  Closing CTA
 *
 * The 40/60 split is deliberate: the demonstration is the larger half, because
 * the audit's first finding was that nobody could see what the service produces.
 *
 * Disclosure is not concealment. Every limit that would change a buying
 * decision stays beside its example in the canvas; the disclosures carry the
 * long-form explanation of the same facts.
 */

const title = 'Automation — E2E Apps';
const description =
  'Ask Claude what changed across your ad spend, ad earnings and subscriptions, and get one explanation with the source data attached. Reporting and investigation; account changes are written up for your decision.';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={title} description={description} path="/automation">
  <div class="page">
    <Nav />

    <main id="main">
      {/* ---------------------------------------------------- 1 · hero ---- */}
      <section class="section section--lead" data-section="automation-hero">
        <div class="wrap">
          <div class="hero">
            <div class="hero__copy">
              <p class="eyebrow eyebrow--amber">Google Ads · AdMob · RevenueCat</p>
              <h1 class="hero__h1">Your growth stack.<br />One conversation.</h1>
              <p class="hero__lead">
                Ask Claude what changed across your ad spend, ad earnings and subscriptions. Get a
                clear explanation with the source data attached.
              </p>

              <a href={`${base}/#contact`} class="btn-primary hero__cta">
                Discuss your setup
                <Icon name="arrow-right" size={15} />
              </a>

              <p class="hero__note">
                Reporting and investigation. Anything that would change an account is written up for
                your decision.
              </p>
            </div>

            <div class="hero__demo">
              <Investigation headingId="demo" />
            </div>
          </div>
        </div>
      </section>

      {/* ------------------------------------------------ 2 · outcomes ---- */}
      <section class="section" data-section="automation-outcomes">
        <div class="wrap">
          <ul class="outcomes">
            {
              OUTCOMES.map((o) => (
                <li class="outcome">
                  <h2 class="outcome__title">{o.title}</h2>
                  <p class="outcome__body">{o.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {/* ----------------------------------------------- 3 · how we work -- */}
      <section class="section" data-section="automation-process">
        <div class="wrap">
          <h2 class="sec__h2">How we work</h2>

          <ol class="steps">
            {
              STEPS.map((s) => (
                <li class="step">
                  <span class="step__n">{s.n}</span>
                  <span class="step__title">{s.title}</span>
                  <p class="step__body">{s.body}</p>
                </li>
              ))
            }
          </ol>

          <div class="detail">
            {
              DISCLOSURES.map((d) => (
                <details class="detail__item">
                  <summary class="detail__summary">{d.label}</summary>
                  <div class="detail__body">
                    {d.body.map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      {/* -------------------------------------------------- 4 · closing --- */}
      <section class="section" data-section="automation-cta">
        <div class="wrap">
          <div class="close">
            <h2 class="close__h2">Bring your stack. We&#8217;ll map the first workflow.</h2>
            <p class="close__body">
              Tell us which accounts you run and what you keep having to check by hand. We will show
              you what the first investigation would look like on your own numbers.
            </p>
            <a href={`${base}/#contact`} class="btn-primary">
              Book a call
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  /* --- 1 · hero ----------------------------------------------------------- */

  .hero {
    display: grid;
    gap: var(--s12);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  /* 40/60 in favour of the demonstration. The copy column is capped in ch so
     it does not stretch to the grid track. */
  @media (min-width: 980px) {
    .hero {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
      gap: var(--s16);
    }
  }

  .hero__copy {
    max-width: 44ch;
  }

  .hero__h1 {
    margin-top: var(--s4);
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--color-text);
  }

  .hero__lead {
    margin-top: var(--s8);
    font-size: var(--t-section-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .hero__cta {
    margin-top: var(--s12);
  }

  .hero__note {
    margin-top: var(--s8);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-4);
  }

  .hero__demo {
    min-width: 0;
  }

  /* --- 2 · outcomes ------------------------------------------------------- */

  /* Open columns with a rule, not three more rounded cards. */
  .outcomes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s8);
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }

  .outcome {
    padding-top: var(--s6);
    border-top: 1px solid var(--color-line-strong);
    min-width: 0;
  }

  .outcome__title {
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-snug);
    color: var(--color-text);
  }

  .outcome__body {
    margin-top: var(--s4);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-3);
  }

  /* --- 3 · process -------------------------------------------------------- */

  .sec__h2 {
    font-size: var(--t-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    color: var(--color-text);
  }

  .steps {
    list-style: none;
    margin: var(--s12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s8);
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }

  .step {
    min-width: 0;
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-accent);
  }

  .step__title {
    display: block;
    margin-top: var(--s3);
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .step__body {
    margin-top: var(--s4);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-3);
  }

  .detail {
    margin-top: var(--s16);
    border-top: 1px solid var(--color-line);
  }

  .detail__item {
    border-bottom: 1px solid var(--color-line);
  }

  .detail__summary {
    display: flex;
    align-items: center;
    min-height: 56px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--ls-disclosure);
    color: var(--color-text-2);
    list-style: none;
  }

  .detail__summary::-webkit-details-marker {
    display: none;
  }

  /* The +/− is CSS on [open], so the disclosures need no JavaScript at all. */
  .detail__summary::before {
    content: '+';
    flex: none;
    width: 1.4em;
    font-size: 1.1em;
    color: var(--color-accent);
  }

  .detail__item[open] .detail__summary::before {
    content: '\2212';
  }

  .detail__item[open] .detail__summary {
    color: var(--color-text);
  }

  .detail__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .detail__body {
    padding: 0 0 var(--s8) 1.4em;
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    max-width: 74ch;
  }

  .detail__body p {
    margin: 0;
    font-size: var(--t-card-sm);
    line-height: var(--lh-body);
    color: var(--color-text-3);
  }

  /* --- 4 · closing -------------------------------------------------------- */

  .close {
    max-width: 58ch;
  }

  .close__h2 {
    font-size: var(--t-h2-card);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2-card);
    color: var(--color-text);
    text-wrap: balance;
  }

  .close__body {
    margin: var(--s8) 0 var(--s12);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }
</style>
