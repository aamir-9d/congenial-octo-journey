---
import Icon from './Icon.astro';

/**
 * "03 / A case you can inspect" — one case, shown all the way down.
 *
 * Rebuilt to the approved composition
 * (docs/design-explorations/homepage-redesign-evidence.png): a left-aligned
 * head, one card whose left half makes the claim and whose right half is the
 * evidence, and a single line of further field notes beneath it.
 *
 * Three figures, not five. MRR is left off here on purpose — it is the one
 * figure whose honest reading needs a second sentence, and the card has no room
 * to give it one. Cost per trial is dropped for space. Both are in the article,
 * with the rest of the country tables.
 *
 * The figures are the article's, not restated by hand: if the post changes,
 * these change with it, because both read from `src/data/case-study.ts`.
 * `tests/case-study.test.ts` recomputes every one of them from the raw period
 * totals and fails if a displayed figure and its arithmetic disagree.
 *
 * The card is no longer one big anchor. It was, and that put the three notes
 * that qualify the figures inside the link — so a screen reader announced the
 * caveats as part of the link name, and a reader could not select the numbers
 * without following it. The action is now a real link at the end of the claim,
 * which is also what the composition draws.
 *
 * Entirely new to the page, so the whole section is `data-added`.
 */
import { CASE_STUDY, MORE_CASES } from '../data/case-study.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/blog/${CASE_STUDY.slug}`;

/** The three the card shows, in the order the composition sets. */
const shown = CASE_STUDY.cardFigures.map(
  (label) => CASE_STUDY.figures.find((f) => f.label === label)!,
);
---

<section id="case-study" class="case section" data-section="case-study" data-added="bento">
  <div class="wrap">
    <div data-reveal="1">
      <p class="eyebrow eyebrow--amber case__eyebrow">03 / A case you can inspect</p>
      <h2 class="case__h2">{CASE_STUDY.homeHeadline}</h2>
    </div>

    <div class="case__card" data-reveal="1">
      <div class="case__claim">
        <p class="case__kicker">{CASE_STUDY.kicker}</p>

        <h3 class="case__title">
          {CASE_STUDY.cardHeadline.map((line) => <span class="case__title-line">{line}</span>)}
        </h3>

        <p class="case__summary">{CASE_STUDY.cardSummary}</p>

        <a class="case__cta" href={href}>
          Read the full case study
          <Icon name="arrow-up-right" size={13} />
        </a>
      </div>

      <div class="case__evidence">
        <p class="case__evidence-label">Before &#8594; after</p>

        <div class="case__rows">
          {
            shown.map((f) => (
              <p class="case__row">
                <span class="case__row-label">
                  <span class="wide-only">{f.label}</span>
                  <span class="narrow-only">{f.labelShort ?? f.label}</span>
                </span>
                <span class="case__before tabular">{f.before}</span>
                <span class="case__arrow" aria-hidden="true">
                  &#8594;
                </span>
                <span class="case__after tabular">{f.after}</span>
              </p>
            ))
          }
        </div>

        <ul class="case__notes">
          {CASE_STUDY.cardNotes.map((n) => <li class="case__note">{n}</li>)}
        </ul>
      </div>
    </div>

    <div class="case__more" data-reveal="1">
      <p class="case__more-label">More field notes</p>
      <ul class="case__more-list">
        {
          MORE_CASES.map((c) => (
            <li>
              <a class="case__more-link" href={`${base}/blog/${c.slug}`}>
                {c.title}
                <Icon name="arrow-up-right" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .case {
    background: linear-gradient(180deg, var(--color-bg), var(--color-band) 55%, var(--color-bg));
  }

  .case__eyebrow {
    margin-bottom: var(--s6);
  }

  .case__h2 {
    /* The measure belongs on the element that owns the font size. On the
       container it would resolve against 16px and cut a 44px heading to about
       nineteen characters a line. */
    max-width: 28ch;
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--color-text);
  }

  .case__card {
    display: grid;
    gap: var(--s8) var(--s16);
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(32px, 4vw, 56px);
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    box-shadow: var(--ring);
  }

  @media (min-width: 900px) {
    .case__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* --- the claim ------------------------------------------------------------ */

  .case__claim {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s6);
    min-width: 0;
  }

  .case__kicker {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .case__title {
    font-size: var(--t-h2-card);
    line-height: var(--lh-h2-closing);
    letter-spacing: var(--ls-h2-card);
    color: var(--color-text);
  }

  /* Each sentence on its own line, as drawn — without a <br> that a narrow
     column cannot undo. */
  .case__title-line {
    display: block;
  }

  .case__summary {
    max-width: 46ch;
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .case__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: auto;
    padding: 0 20px;
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 1px var(--color-line-strong);
    font-size: var(--t-card-sm);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    color: var(--color-text);
  }

  .case__cta:hover {
    box-shadow: 0 0 0 1px var(--color-line-hover);
    background: var(--color-surface-sunk);
  }

  .case__cta:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* --- the evidence --------------------------------------------------------- */

  .case__evidence {
    min-width: 0;
  }

  .case__evidence-label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-4);
  }

  .case__rows {
    margin: var(--s6) 0 0;
  }

  /* A grid, not a flex row, so the three arrows land in one column and the
     before and after figures each align to their own edge. Flex would put every
     pair flush right and leave the arrows scattered across three x-positions. */
  .case__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    align-items: baseline;
    column-gap: var(--s4);
    padding: var(--s6) 0;
  }

  .case__row + .case__row {
    border-top: 1px solid var(--color-line);
  }

  .case__row-label {
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  /* Each row is one sentence — "Install → trial 0.62% → 4.00%" — so it is a
     paragraph of four grid items rather than a definition list. A <dl> would
     have needed `display: contents` on the <dd> to get the four into one grid,
     and that has a long history of dropping list semantics from the
     accessibility tree. */
  .case__before {
    justify-self: end;
  }

  /* The before figure is deliberately the quieter of the two: the card is about
     where the number ended up. */
  .case__before {
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    color: var(--color-text-4);
  }

  .case__arrow {
    font-size: var(--t-card);
    color: var(--color-text-4);
  }

  .case__after {
    font-size: var(--t-h3);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
  }

  .case__notes {
    list-style: none;
    margin: var(--s6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .case__note {
    font-size: var(--t-body-sm);
    line-height: var(--lh-card);
    color: var(--color-text-4);
  }

  /* --- further notes -------------------------------------------------------- */

  .case__more {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s4) var(--s16);
    margin-top: var(--s8);
  }

  .case__more-label {
    font-size: var(--t-card-sm);
    color: var(--color-text-4);
  }

  .case__more-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s8);
    min-width: 0;
  }

  .case__more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: var(--t-card);
    font-weight: var(--fw-medium);
    line-height: var(--lh-card);
    text-decoration: none;
    color: var(--color-text);
  }

  .case__more-link:hover {
    color: var(--color-accent);
  }

  .case__more-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
</style>
