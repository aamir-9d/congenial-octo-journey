---
import Icon from './Icon.astro';

/**
 * "03 / A case you can inspect" — one case, shown all the way down.
 *
 * Rebuilt to docs/design-explorations/case-study-hierarchy-{desktop,mobile}.png,
 * which give this section the same shape as Automation and Diagnostics: copy
 * and one action on the left, one framed panel with a single focal point on
 * the right.
 *
 * The previous version ran two headlines against each other — a section
 * heading and a card heading, both large, one immediately under the other.
 * There is one headline now, and the panel leads with one number.
 *
 * ── Every figure is derived, none is typed ───────────────────────────────
 *
 * The 77.5% is computed here from RAW, the raw period totals, not written
 * down. A percentage transcribed beside figures it was derived from is a
 * number waiting to disagree with them: change a total and the prose would
 * keep asserting the old reduction. The comparison bars are scaled from the
 * same ratio, so the picture cannot drift from the arithmetic either.
 * `tests/case-study.test.ts` recomputes the lot.
 *
 * It is described as lower cost in the after window. Three changes shipped
 * together, so it is not evidence that any one of them caused it, and the
 * qualifications say so in the panel rather than behind a disclosure — a
 * reader who takes the numbers away should take the caveats with them.
 *
 * Entirely new to the page, so the whole section is `data-added`.
 */
import { CASE_STUDY, MORE_CASES, RAW } from '../data/case-study.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/blog/${CASE_STUDY.slug}`;

/* --- the observed change, from the period totals ------------------------- */

const cppBefore = RAW.before.cost / RAW.before.paid;
const cppAfter = RAW.after.cost / RAW.after.paid;

/** How much lower the after window ran, as a share of the before window. */
const reduction = (1 - cppAfter / cppBefore) * 100;

/** The after bar as a share of the before bar, which is the same ratio. */
const afterBar = (cppAfter / cppBefore) * 100;

const money = (v: number) => '$' + v.toFixed(2);

/** The two supporting figures, in the order the composition sets. */
const support = ['Install → trial', 'Payers per day'].map(
  (label) => CASE_STUDY.figures.find((f) => f.label === label)!,
);

const [tradeOff, ...limits] = CASE_STUDY.cardNotes;
---

<section id="case-study" class="case section" data-section="case-study" data-added="bento">
  <div class="wrap">
    <div class="cs">
      <div class="cs__copy" data-reveal="1">
        <p class="eyebrow eyebrow--amber">03 / A case you can inspect</p>

        <h2 class="cs__h2">
          {CASE_STUDY.cardHeadline.map((line) => <span class="cs__h2-line">{line}</span>)}
        </h2>

        <p class="cs__kicker">{CASE_STUDY.kicker}</p>

        <p class="cs__body">{CASE_STUDY.cardSummary}</p>

        <p class="cs__stability">{CASE_STUDY.cardStability}</p>
      </div>

      <div class="cs__panel" data-reveal="1">
        <p class="cs__meta">
          <span class="cs__meta-kicker">The observed change</span>
          <span class="cs__meta-range">Before &#8594; after</span>
        </p>

        <div>
          <p class="cs__lede-label">Cost per payer</p>

          <div class="cs__figures">
            <p class="cs__after tabular">
              {money(cppAfter)}
              <span class="cs__after-tag">After</span>
            </p>
            <p class="cs__before tabular">
              {money(cppBefore)}
              <span class="cs__before-tag">Before</span>
            </p>
          </div>
        </div>

        {/* Two bars, each labelled where it sits. The after bar is scaled from
            the same ratio the percentage below is, so they cannot disagree. */}
        <div class="cs__bars">
          <span class="cs__bar-label">Before</span>
          <span class="cs__track"><span class="cs__bar cs__bar--before"></span></span>
          <span class="cs__bar-label">After</span>
          <span class="cs__track">
            <span class="cs__bar cs__bar--after" style={`--w:${afterBar.toFixed(2)}%`}></span>
          </span>
        </div>

        <p class="cs__delta">
          {reduction.toFixed(1)}% lower cost per payer in the after window
        </p>

        <div class="cs__rule" role="presentation"></div>

        <dl class="cs__support">
          {
            support.map((f) => (
              <div class="cs__support-cell">
                <dt class="cs__support-label">{f.label}</dt>
                <dd class="cs__support-val tabular">{f.after}</dd>
                <dd class="cs__support-before">Before: {f.before}</dd>
              </div>
            ))
          }
        </dl>

        <div class="cs__rule" role="presentation"></div>

        <div>
          <p class="cs__trade-label">The trade-off</p>
          <p class="cs__trade-text">{tradeOff}</p>
          <ul class="cs__limits">
            {limits.map((n) => <li class="cs__limit">{n}</li>)}
          </ul>
        </div>
      </div>

      {/* Third grid child, after the panel in the DOM. On a phone that puts the
          action after the evidence it refers to, which is the order the mobile
          composition sets; on desktop it is placed back under the copy. */}
      <a class="btn-primary cs__cta" href={href} data-reveal="1">
        Read the full case study
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>

    <div class="cs__notes" data-reveal="1">
      <p class="cs__notes-label">More field notes</p>
      {
        MORE_CASES.map((c) => (
          <>
            <p class="cs__notes-title">{c.title}</p>
            <a class="cs__notes-link" href={`${base}/blog/${c.slug}`}>
              Read the story
              <Icon name="arrow-up-right" size={13} />
            </a>
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .case {
    background: linear-gradient(180deg, var(--color-bg), var(--color-band) 55%, var(--color-bg));
  }

  /* Copy left, one framed panel right, tops aligned — the Automation shape. */
  .cs {
    display: grid;
    gap: var(--s12);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @media (min-width: 900px) {
    .cs {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      grid-template-rows: auto 1fr;
      gap: var(--s8) var(--s16);
    }

    .cs__copy {
      grid-column: 1;
      grid-row: 1;
    }

    .cs__cta {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }

    /* The panel spans both rows so its top aligns with the copy and its height
       is its own content rather than a row it was forced into. */
    .cs__panel {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }

  .cs__copy {
    min-width: 0;
  }

  .cs__h2 {
    margin-top: var(--s4);
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--color-text);
  }

  /* Each sentence on its own line without a <br> a narrow column cannot undo. */
  .cs__h2-line {
    display: block;
  }

  .cs__kicker {
    margin-top: var(--s8);
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .cs__body {
    margin-top: var(--s6);
    max-width: 42ch;
    font-size: var(--t-section-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .cs__stability {
    margin-top: var(--s6);
    max-width: 42ch;
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-4);
  }

  .cs__cta {
    justify-self: start;
    margin-top: var(--s4);
  }

  @media (min-width: 900px) {
    .cs__cta {
      margin-top: var(--s8);
    }
  }

  /* --- the evidence panel -------------------------------------------------- */

  .cs__panel {
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    padding: var(--s8);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--ring);
    min-width: 0;
  }

  .cs__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3) var(--s6);
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .cs__meta-kicker {
    color: var(--color-accent);
  }

  .cs__meta-range {
    color: var(--color-text-4);
  }

  .cs__lede-label {
    font-size: var(--t-h3);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    color: var(--color-text);
  }

  .cs__figures {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4) var(--s6);
    margin-top: var(--s4);
  }

  /* The after figure is the focal point of the whole section. */
  .cs__after {
    font-size: clamp(44px, 6vw, 72px);
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
  }

  .cs__after-tag {
    display: block;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .cs__before {
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--ls-tight);
    text-align: right;
    color: var(--color-text-4);
  }

  .cs__before-tag {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-4);
  }

  /* --- the comparison bars ------------------------------------------------- */

  .cs__bars {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 10px var(--s4);
  }

  .cs__bar-label {
    font-size: var(--t-body-sm);
    color: var(--color-text-3);
  }

  .cs__track {
    display: block;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-sunk);
    overflow: hidden;
  }

  .cs__bar {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
  }

  .cs__bar--before {
    width: 100%;
    background: var(--color-text-4);
  }

  .cs__bar--after {
    width: var(--w);
    background: var(--color-accent);
  }

  .cs__delta {
    font-size: var(--t-card-sm);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-card);
    color: var(--color-accent);
  }

  .cs__rule {
    height: 1px;
    background: var(--color-line);
  }

  /* --- supporting figures -------------------------------------------------- */

  .cs__support {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s6);
    margin: 0;
  }

  @media (min-width: 480px) {
    .cs__support {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s8);
    }

    .cs__support-cell + .cs__support-cell {
      padding-left: var(--s8);
      border-left: 1px solid var(--color-line);
    }
  }

  .cs__support-cell {
    min-width: 0;
  }

  .cs__support-label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-4);
  }

  .cs__support-val {
    margin: 6px 0 0;
    font-size: var(--t-h2-card);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--color-text);
  }

  .cs__support-before {
    margin: 4px 0 0;
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-3);
  }

  /* --- qualifications, visible ---------------------------------------------- */

  .cs__trade-label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .cs__trade-text {
    margin-top: 8px;
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-card);
    color: var(--color-text);
  }

  .cs__limits {
    list-style: none;
    margin: var(--s4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cs__limit {
    font-size: var(--t-body-sm);
    line-height: var(--lh-card);
    color: var(--color-text-4);
  }

  /* --- further notes -------------------------------------------------------- */

  .cs__notes {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s4) var(--s8);
    margin-top: var(--s12);
    padding-top: var(--s8);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 720px) {
    .cs__notes {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
    }
  }

  .cs__notes-label {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* `flex: 1` against two siblings on a 390px row left this squeezed to about
     six characters and breaking one word per line. It only takes the spare
     room once there is spare room to take. */
  .cs__notes-title {
    min-width: 0;
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-card);
    color: var(--color-text);
  }

  @media (min-width: 720px) {
    .cs__notes-title {
      flex: 1;
    }
  }

  .cs__notes-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: var(--t-card-sm);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    color: var(--color-accent);
  }

  .cs__notes-link:hover {
    color: var(--color-accent-hover);
  }

  .cs__notes-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
</style>
