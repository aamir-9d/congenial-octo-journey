---
/**
 * The Full Loop, as a circle.
 *
 * Built to docs/design-explorations/loop-circular-revision.png, which restores
 * the circular identity and supersedes the four-column arrangement.
 *
 * ── Desktop ─────────────────────────────────────────────────────────────
 *
 * A 3x3 grid: the ring in the centre cell, the four stations at N / E / S / W,
 * so the clockwise reading order is the cycle itself. Each card is the same
 * size and carries the same hierarchy — eyebrow, title, two-line scope, one
 * outcome, and a control that opens the full service detail.
 *
 * The detail opens in a shared panel on a fourth row spanning the whole grid,
 * rather than inside the card. A long scope description growing inside a card
 * would move the ring and break the arrangement the sketch is built around.
 *
 * ── Without JavaScript ──────────────────────────────────────────────────
 *
 * All four panels render open, below the diagram, as ordinary headed prose.
 * The script collapses them on load and wires the card triggers, so scripting
 * improves the presentation rather than being a condition of reading it. That
 * is why the panels are not `hidden` in the markup.
 *
 * ── Copy ────────────────────────────────────────────────────────────────
 *
 * `lead` and `out` are the short forms the sketch shows on the card. `body`
 * and `outcome` are the full service descriptions the site already carried;
 * they move into the disclosure rather than being cut, because the detail is
 * what a buyer actually scopes against.
 */

const stations = [
  {
    n: '01',
    title: 'Instrument',
    lead: 'Define the events. Validate the SDKs. Check consent and server delivery.',
    out: 'A reliable source signal.',
    body: 'Get the raw signal right at the source. Event taxonomy and naming, a written tracking plan the developers can actually implement, SDK integration and QA, consent and ATT prompt sequencing, debug and sandbox validation before anything ships.',
    outcome:
      'Events fire when they should, named what they should be, carrying what they should carry.',
  },
  {
    n: '02',
    title: 'Attribute',
    lead: 'Connect installs and revenue to sources. Check MMP, SKAN and web-to-app paths.',
    out: 'Attribution you can inspect.',
    body: 'Connect the signal to a source. MMP configuration and audit, SKAdNetwork and AdAttributionKit conversion schemas, attribution window alignment, server-to-server events, deferred deep linking, conversion APIs to every ad platform, web-to-app click capture.',
    outcome: 'Every install and every dollar traceable to the click that caused it.',
  },
  {
    n: '03',
    title: 'Decide',
    lead: 'Model retention, LTV and payback. Set acquisition limits by market.',
    out: 'Defensible spending limits.',
    body: 'Turn clean data into a spending decision. Cohort LTV and retention decay, CAC payback curves by channel and by country, trial-to-paid economics, breakeven ceilings per market, paywall funnel diagnosis.',
    outcome:
      'A defensible number for what you can afford to pay for a user — market by market.',
  },
  {
    n: '04',
    title: 'Deploy',
    lead: 'Run campaigns and monetisation tests. Feed the results back into measurement.',
    out: 'Spend informed by evidence.',
    body: 'Spend against those numbers. Google Ads app and web-to-app campaigns, Apple Ads, Meta, TikTok, ASO and store listing strategy, paywall and pricing tests, ad monetisation and mediation.',
    outcome:
      'Budget deployed where the arithmetic says it works — and fresh signal flowing back into Station 01.',
  },
];

/**
 * Arrowheads at each arc midpoint, pointing along the clockwise tangent.
 *
 * Derived rather than placed by eye: an arrowhead a few units off the ring
 * reads as a stray mark, and the first pass had all four of them there.
 */
const R = 102;
const C = 120;
const arrows = [315, 45, 135, 225].map((deg) => {
  const rad = (deg * Math.PI) / 180;
  return {
    x: +(C + R * Math.cos(rad)).toFixed(2),
    y: +(C + R * Math.sin(rad)).toFixed(2),
    /** Clockwise tangent at that point. */
    rot: (deg + 90) % 360,
  };
});

/** Node positions on the ring, in the order the cycle runs. */
const nodes = [
  { n: '01', cx: 120, cy: 18 },
  { n: '02', cx: 222, cy: 120 },
  { n: '03', cx: 120, cy: 222 },
  { n: '04', cx: 18, cy: 120 },
];
---

<section id="loop" class="section" data-section="loop">
  <div class="wrap">
    <div class="loop__head">
      <div>
        <div class="eyebrow eyebrow--amber">How we work</div>
        <h2 class="loop__h2">The Full Loop</h2>
      </div>
      <p class="loop__lead">Four stations. Each decision feeds the next cycle.</p>
    </div>

    <div class="ring-grid">
      {
        stations.map((s) => (
          <article class={`st st--${s.n}`}>
            <p class="st__eyebrow">Station {s.n}</p>
            <h3 class="st__title">{s.title}</h3>
            <p class="st__lead">{s.lead}</p>
            <p class="st__out">
              <span class="st__out-label">Outcome:</span> {s.out}
            </p>
            <button
              type="button"
              class="st__more"
              data-loop-trigger={s.n}
              aria-expanded="true"
              aria-controls={`loop-detail-${s.n}`}
            >
              What&#8217;s included
              <span class="st__sign" aria-hidden="true"></span>
            </button>
          </article>
        ))
      }

      {/* The ring. Decorative: every station name and number is real text in
          the cards, so the diagram repeats nothing to a screen reader. */}
      <div class="ring" aria-hidden="true">
        <svg viewBox="0 0 240 240" focusable="false">
          <circle cx="120" cy="120" r="102" fill="none" stroke="var(--color-line-strong)" stroke-width="1" />

          {/* Arrowheads sit still on the ring; only the dot travels. */}
          <g fill="var(--color-accent)">
            {
              arrows.map((a) => (
                <path d="M-5 -4 L 5 0 L -5 4 Z" transform={`translate(${a.x} ${a.y}) rotate(${a.rot})`} />
              ))
            }
          </g>

          <circle class="ring__dot" r="4" fill="var(--color-accent)">
            <animateMotion
              dur="16s"
              repeatCount="indefinite"
              path="M120 18 A102 102 0 1 1 119.9 18"
            />
          </circle>

          {
            nodes.map((p) => (
              <g>
                <circle cx={p.cx} cy={p.cy} r="17" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="1" />
                <text x={p.cx} y={p.cy + 4} text-anchor="middle" class="ring__n">
                  {p.n}
                </text>
              </g>
            ))
          }

          <text x="120" y="114" text-anchor="middle" class="ring__label">SIGNAL IN</text>
          <text x="120" y="132" text-anchor="middle" class="ring__label">SPEND OUT</text>
        </svg>
      </div>

      {/* One shared row for the detail, so opening a station never moves the
          ring. Open in the markup; the script collapses them on load. */}
      <div class="details">
        {
          stations.map((s) => (
            <div
              class="detail"
              id={`loop-detail-${s.n}`}
              data-loop-panel={s.n}
              role="region"
              aria-label={`What's included in station ${s.n}, ${s.title}`}
            >
              <p class="detail__head">
                <span class="detail__n">{s.n}</span>
                {s.title}
              </p>
              <p class="detail__body">{s.body}</p>
              <p class="detail__outcome">Outcome: {s.outcome}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="loop__close">
      <p class="loop__close-line">Fresh campaign results return to Instrument. The loop continues.</p>
      {/* Signed-off copy, kept. The approved sketch specifies the line above,
          which describes the mechanism; this one is the claim the section is
          actually making, and losing it would cost the argument. */}
      <p class="loop__claim">
        Most consultants stop after Station 02. The loop only closes when the same person walks all
        four.
      </p>
    </div>
  </div>
</section>

<script>
  import { initLoop } from '../scripts/loop';
  initLoop();
</script>

<style>
  .loop__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s6) var(--s16);
  }

  /* The lead sits beside the heading, not pinned to the far edge of a 1280px
     wrap — at that distance the two stop reading as one statement. */
  .loop__lead {
    margin-left: auto;
  }

  .loop__h2 {
    margin-top: var(--s4);
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--color-text);
  }

  .loop__lead {
    max-width: 40ch;
    font-size: var(--t-section-lead);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  /* --- the arrangement ----------------------------------------------------- */

  /* Mobile first: a compact ring, then the stations in reading order. The
     diamond is not shrunk to fit — below 900px it stops being a layout and
     becomes an illustration above the list, which is what the mobile sketch
     shows. */
  .ring-grid {
    margin-top: clamp(32px, 4vw, 56px);
    display: grid;
    gap: var(--s6);
    grid-template-columns: minmax(0, 1fr);
  }

  .ring {
    order: -1;
    max-width: 260px;
    margin: 0 auto var(--s6);
  }

  .ring svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 900px) {
    .ring-grid {
      grid-template-columns: minmax(0, 1fr) minmax(min(280px, 100%), 0.86fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto auto;
      align-items: center;
      gap: var(--s8);
      column-gap: var(--s6);
    }

    .ring {
      order: 0;
      grid-column: 2;
      grid-row: 2;
      max-width: none;
      margin: 0;
    }

    /* North, east, south, west. */
    .st--01 { grid-column: 2; grid-row: 1; }
    .st--02 { grid-column: 3; grid-row: 2; }
    .st--03 { grid-column: 2; grid-row: 3; }
    .st--04 { grid-column: 1; grid-row: 2; }

    .details { grid-column: 1 / -1; grid-row: 4; }
  }

  /* --- station cards ------------------------------------------------------- */

  /* Equal dimensions, equal padding, equal hierarchy. The four cards differ
     only in their words. */
  .st {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding: var(--s8);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--ring);
    min-width: 0;
  }

  .st__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .st__title {
    font-size: var(--t-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    color: var(--color-text);
  }

  .st__lead {
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .st__out {
    padding-top: var(--s4);
    border-top: 1px solid var(--color-line);
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }

  .st__out-label {
    color: var(--color-text-4);
  }

  .st__more {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    align-self: flex-start;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-disclosure);
    color: var(--color-accent);
    cursor: pointer;
  }

  .st__more:hover {
    color: var(--color-accent-hover);
  }

  .st__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .st__sign::before {
    content: '+';
  }

  .st__more[aria-expanded='true'] .st__sign::before {
    content: '\2212';
  }

  /* The selected station is identified on the card, not only in the panel. */
  .st--open {
    box-shadow: var(--ring-accent);
  }

  /* --- the ring ------------------------------------------------------------ */

  .ring__n {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--color-accent);
  }

  .ring__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.4px;
    fill: var(--color-text-4);
  }

  @media (prefers-reduced-motion: reduce) {
    .ring__dot {
      display: none;
    }
  }

  /* --- the shared detail panel --------------------------------------------- */

  .details {
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    min-width: 0;
  }

  .detail {
    padding: var(--s8);
    border-radius: var(--radius-card);
    background: var(--color-surface-sunk);
    box-shadow: var(--ring);
    min-width: 0;
  }

  .detail[hidden] {
    display: none;
  }

  .detail__head {
    display: flex;
    align-items: baseline;
    gap: var(--s4);
    font-size: var(--t-h3-sm);
    letter-spacing: var(--ls-h3);
    color: var(--color-text);
  }

  .detail__n {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-accent);
  }

  .detail__body {
    margin-top: var(--s6);
    max-width: 78ch;
    font-size: var(--t-card);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .detail__outcome {
    margin-top: var(--s6);
    padding-top: var(--s6);
    border-top: 1px solid var(--color-line);
    max-width: 78ch;
    font-size: var(--t-card);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .loop__close {
    margin-top: clamp(32px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s4);
    text-align: center;
  }

  .loop__close-line {
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-3);
  }

  .loop__claim {
    max-width: 62ch;
    font-size: var(--t-card);
    line-height: var(--lh-card);
    color: var(--color-text-2);
  }
</style>
