---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import Automation from '../components/Automation.astro';
import Proof from '../components/Proof.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Loop from '../components/Loop.astro';
import Founders from '../components/Founders.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

/**
 * The homepage.
 *
 * It used to run twelve sections, 4,269 words and nineteen minutes of reading,
 * which is roughly four times what a page like this converts at. The stack,
 * products and the FAQ now have their own pages and the blog index already had
 * one; between them that was 40% of the words and 29 of the 35 disclosures.
 * Nothing was deleted in the move.
 *
 * The September audit measured the calculator starting 2,172px down on desktop
 * and 2,637px at narrow width, behind a Problems section that was on its own
 * 1,441-2,019px tall. The most persuasive object on the site, and the only one
 * a competitor cannot copy, arrived after two full screens of preamble.
 *
 * So the order is now evidence-led rather than argument-led:
 *
 *   Hero        the claim, one action, and one real result beside it
 *   Calculator  prove it with your own numbers, at position two
 *   CaseStudy   one engagement shown all the way down
 *   Proof       three more findings, as the tail of that movement
 *   Automation  how the monitoring continues after the fix
 *   Loop        how the work is sequenced
 *   Founders    who you would actually be talking to
 *   Contact     the one action, again
 *
 * Problems has left the homepage. It is not deleted -- /services opens with it
 * in full, where someone looking for the diagnosis will find it. The hero lead
 * now carries the compressed version, which is what the audit asked for: fold
 * problem recognition into an introduction rather than a section.
 *
 * CaseStudy before Proof, inverting the old order: the engagement that can be
 * evidenced in full earns the three one-line findings that follow it, where the
 * reverse made the reader wait through assertions for the proof.
 */

const title = 'E2E Apps — Mobile attribution and growth for subscription apps';
const description =
  'Your dashboard says the campaign is losing money. It broke even in month nine. We fix the attribution, close the gaps it was hiding, and spend against numbers you can defend.';
---

<Base title={title} description={description} path="/">
  <Schema slot="head" />
  <div class="page">
    <Nav />
    <main id="main">
      <Hero />
      <Calculator />
      <CaseStudy />
      <Proof />
      <Automation />
      <Loop />
      <Founders />
      <Contact />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
    /* `clip`, not `hidden` — see global.css. `hidden` makes this a scroll
       container and the sticky nav sticks to it instead of the viewport. */
    overflow-x: clip;
  }
</style>
