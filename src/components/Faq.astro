---
import { GROUP_A, GROUP_B, toHtml } from '../data/faq';

/**
 * NEW DESIGN. The signed-off export had no FAQ.
 *
 * Placed between the founders and the closing ask on purpose: an FAQ is
 * last-mile objection handling, so it belongs immediately before the booking.
 *
 * Two groups rather than one flat list. Group A carries the questions that
 * actually block a booking - price, timeline, access, effort, risk. Group B
 * carries the capability questions, which reassure a technical reader and earn
 * long-tail search traffic. A single list would bury the first behind the
 * second.
 *
 * Native details/summary throughout: keyboard-operable and screen-reader
 * labelled with no JS, open to Ctrl+F when expanded, and it still works with
 * scripting off. The copy lives in src/data/faq.ts so the visible text and the
 * FAQPage JSON-LD in Schema.astro cannot drift apart.
 */
---

<section id="faq" class="faq section" data-section="faq" data-added="faq">
  <div class="faq__inner">
    <div data-reveal="1">
      <h2 class="faq__head">Questions people ask before booking.</h2>
      <p class="faq__sub">Including the ones that are awkward to answer.</p>
    </div>

    <div class="faq__list">
      {
        GROUP_A.map((item, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__q">
              <span>{item.q}</span>
              <svg
                class="faq__chevron"
                width="14"
                height="14"
                viewBox="0 0 14 14"
                aria-hidden="true"
              >
                <path
                  d="M3 5.5 L7 9.5 L11 5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <div class="faq__a" set:html={toHtml(item.a)} />
          </details>
        ))
      }
    </div>

    <h3 class="faq__group">Technical questions</h3>

    <div class="faq__list">
      {
        GROUP_B.map((item, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__q">
              <span>{item.q}</span>
              <svg
                class="faq__chevron"
                width="14"
                height="14"
                viewBox="0 0 14 14"
                aria-hidden="true"
              >
                <path
                  d="M3 5.5 L7 9.5 L11 5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <div class="faq__a" set:html={toHtml(item.a)} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Deliberately quieter than the sections above: no cards, no shadows, just
     hairlines. The argument has already been made by this point. */
  .faq {
    background: var(--c-paper);
    border-top: 1px solid var(--c-line);
  }

  .faq__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .faq__head {
    font-size: var(--fs-h2);
    color: var(--c-ink);
  }

  .faq__sub {
    margin-top: var(--space-sm);
    font-size: var(--fs-body-xl);
    color: var(--c-ink-soft);
    font-style: italic;
  }

  .faq__list {
    margin-top: var(--space-lg);
  }

  /* The 2px left border is always present and transparent until the row opens,
     so opening one does not nudge its text sideways. */
  .faq__item {
    border-top: 1px solid var(--c-line);
    border-left: 2px solid transparent;
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  .faq__item[open] {
    border-left-color: var(--c-amber);
  }

  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md);
    min-height: 44px;
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 500;
    /* New values: the export has no 500-weight text and no size between its
       body and heading scales. Kept local rather than added to tokens.css,
       which is the export inventory. */
    font-size: clamp(16px, 1.5vw, 18.5px);
    line-height: 1.45;
    color: var(--c-ink);
    list-style: none;
  }

  /* Suppress the native disclosure triangle in every engine. */
  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q::marker {
    content: '';
  }

  .faq__chevron {
    flex: none;
    margin-top: 0.3em;
    color: var(--c-ink-soft);
    transition: transform 180ms ease;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__a {
    padding: 0 var(--space-md) var(--space-md);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.65;
    color: var(--c-ink-muted);
    max-width: var(--measure-summary);
  }

  .faq__a :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  .faq__group {
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--ls-eyebrow-lg);
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }

  /* The chevron is the only thing that moves in this section. */
  @media (prefers-reduced-motion: reduce) {
    .faq__chevron {
      transition: none;
    }
  }
</style>
