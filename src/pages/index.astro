---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeServices from '../components/HomeServices.astro';
import HomeLoop from '../components/HomeLoop.astro';
import HomePayback from '../components/HomePayback.astro';
import HomeInsights from '../components/HomeInsights.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

/**
 * The homepage.
 *
 * Rebuilt in November 2026 from the boards the owner approved
 * (design/v3/Main.dc.html for desktop, Phone.dc.html for the phone). The page
 * makes one argument from top to bottom:
 *
 *   HomeHero      the service and the buyer, one action, the tools it works in
 *   HomeServices  what I fix: five services and AI reporting, audit first
 *   HomeLoop      how the work runs: four stations, a photograph for each
 *   HomePayback   a preview of the calculator; the tool is on its own page
 *   HomeInsights  the library, the findings report, the newest posts
 *   Contact       the form and the booking link
 *
 * Things that are deliberate and will otherwise look like omissions:
 *
 *  - No audit count and no "track record" strip. The owner's call: a small
 *    number on show reads as inexperience. Findings are described in words.
 *  - The full calculator is on /payback-calculator only.
 *  - The case study has its own page (/case-studies); station 04 of the loop
 *    carries its headline figures and links there.
 *  - Founders are on /about.
 *
 * Below 700px the services, the loop stations and the posts each become one
 * swipe row that moves on by itself (src/scripts/swipe.ts).
 */

/* 58 characters. Google cuts a title at about 60, and the brand is at the end. */
const title = 'Mobile Attribution Audits for Subscription Apps — E2E Apps';
/* One constant feeds the meta description, og:description and
   twitter:description. Kept in step with the hero: a search snippet or a
   shared link that advertises a claim the page no longer makes is a
   promise broken before the visitor arrives. */
const description =
  'Mobile attribution audits and fixes for subscription apps. I find what your MMP setup gets wrong, fix it at the source, and show which campaigns pay back.';
---

<Base title={title} description={description} path="/">
  <Schema slot="head" />
  <div class="page">
    <Nav />
    <main id="main">
      <HomeHero />
      <HomeServices />
      <HomeLoop />
      <HomePayback />
      <HomeInsights />
      <Contact />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
    /* `clip`, not `hidden` — see global.css. `hidden` makes this a scroll
       container and the sticky nav sticks to it instead of the viewport. */
    overflow-x: clip;
  }
</style>
