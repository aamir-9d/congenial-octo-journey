---
/**
 * "Three findings, from real audits." Three cards, not three bare columns.
 *
 * Each figure gains a label above it. On its own "~5%" says nothing — the
 * reader has to fall into the paragraph to learn what it counts. The label
 * carries the claim and the figure lands it.
 *
 * The labels are NEW COPY awaiting sign-off, marked `data-added`. The bodies
 * are the export's, verbatim.
 *
 * min-heights of 2.7em on the label and 1.9em on the figure are what keep the
 * amber rules on one line across the three cards.
 */

const findings = [
  {
    label: 'Trial-to-paid, misreported',
    stat: '11% → 17%',
    body: 'A dashboard reported an 11% trial-to-paid rate. The verified figure was closer to 17%. Every budget decision made from that dashboard had been built on the wrong number.',
    short: 'Every budget decision had been built on the wrong number.',
  },
  {
    label: 'The paywall nobody reached',
    stat: '~5%',
    body: 'Share of new users in one app who ever reached a payment screen. Nobody had measured it. That single number was the reason the app lost money.',
    short: 'Share of new users who ever saw a payment screen. Nobody had measured it.',
  },
  {
    label: 'Spend in markets that cannot pay back',
    labelShort: 'Markets that cannot pay back',
    stat: 'Most of the budget',
    body: 'At one portfolio audit, the majority of spend was going to countries that mathematically could not break even. It had run that way for months.',
    short: 'Months of spend in countries that mathematically could not break even.',
  },
];
---

<section class="section" data-section="proof">
  <div class="wrap">
    <div class="section-head" data-reveal="1">
      <div class="eyebrow eyebrow--amber">WHAT THE AUDITS TURN UP</div>
      <h2 class="proof__h2">Three findings, from real audits.</h2>
    </div>

    <div class="proof__grid">
      {
        findings.map((f) => (
          <div class="proof__card" data-reveal="1">
            <div class="proof__label" data-added="bento">
              {'labelShort' in f ? (
                <>
                  <span class="wide-only">{f.label}</span>
                  <span class="narrow-only">{(f as { labelShort: string }).labelShort}</span>
                </>
              ) : (
                f.label
              )}
            </div>
            <div class="proof__stat tabular">{f.stat}</div>
            <p class="proof__body wide-only">{f.body}</p>
            <p class="proof__body narrow-only">{f.short}</p>
          </div>
        ))
      }
    </div>

    <p class="proof__note">Client names withheld. Details available on a call.</p>
  </div>
</section>

<style>

  .proof__h2 {
    margin-top: 16px;
    font-size: var(--t-h2);
    letter-spacing: var(--ls-h2);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
    margin-top: clamp(40px, 4vw, 64px);
  }

  .proof__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 26px;
    box-shadow: var(--ring);
  }

  /* Reserved so the amber rules line up across the three cards however
     differently the labels wrap. */
  .proof__label {
    min-height: 2.7em;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
    color: var(--color-text-4);
  }

  /* 2.1em, not the design's 1.9em. "Most of the budget" wraps to two lines at
     every column width the grid produces, and 1.9em reserves less than two
     lines at line-height 1.05 — so that card's body started lower than the
     other two and the row lost its baseline. Two lines is the real maximum
     here; reserving for it is what keeps the three bodies level. */
  .proof__stat {
    margin-top: 14px;
    padding-top: 18px;
    border-top: 2px solid var(--color-accent);
    min-height: 2.1em;
    font-size: var(--t-stat);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-h1);
    line-height: var(--lh-h1);
  }

  .proof__body {
    margin-top: 14px;
    font-size: var(--t-card);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  .proof__note {
    margin-top: 32px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--color-text-4);
  }

  /* On a phone the paragraph is replaced by one sentence — the card has to be
     readable in a glance while scrolling, and the full account belongs on a
     call anyway. */
  @media (max-width: 767px) {
    .proof__label,
    .proof__stat {
      min-height: 0;
    }

    .proof__card {
      padding: var(--s6);
    }

    .proof__label {
      font-size: 10px;
      line-height: var(--lh-tight);
    }

    .proof__stat {
      margin-top: var(--s3);
      padding-top: var(--s4);
      font-size: 28px;
      letter-spacing: -0.032em;
      line-height: 1.06;
    }

    .proof__body {
      margin-top: var(--s3);
      font-size: 13.5px;
    }

    .proof__note {
      margin-top: var(--s6);
      font-size: 11px;
    }
  }
</style>
