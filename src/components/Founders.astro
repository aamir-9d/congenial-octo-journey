---
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';

/**
 * The two founders.
 *
 * Board: design/v3/About.dc.html. Two glow cards: an initials avatar beside
 * the name and role, the bio, and the LinkedIn link.
 *
 * The bios are the condensed one-paragraph versions (marked `data-added`), word
 * for word as they were before the redesign.
 *
 * No credential chips. The previous cards carried a row of them, several of
 * which stated counts (accounts, apps, years); the owner does not want counts
 * on show and the board draws none, so the row is gone. Each fact is still in
 * the bio's own sentence.
 *
 * No portraits exist yet, so the avatar is the founder's initials. The
 * build-time `fs.existsSync` check stays: drop `aamir.jpg` / `faisal.jpg` into
 * public/img/ and the photographs render in the same slot.
 */

interface Props {
  /** The small label above the heading. */
  eyebrow?: string;
  /** Optional paragraph beside the heading. */
  aside?: string;
  /** The closing line. /about leaves it out: it repeats the heading and the aside. */
  pull?: boolean;
}
const { eyebrow = 'Who you talk to', aside, pull = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicDir = path.resolve(process.cwd(), 'public');
const hasPhoto = (file: string) => fs.existsSync(path.join(publicDir, 'img', file));

const founders = [
  {
    file: 'aamir.jpg',
    initials: 'AJ',
    name: 'Aamir Jan Khan',
    role: 'MEASUREMENT & GROWTH',
    alt: 'Aamir Jan Khan',
    linkedin: 'https://www.linkedin.com/in/aamir-jan-khan/',
    glow: '--gx:100%;--gy:0%',
    bio: "I run growth for a portfolio of 50+ iOS and Android apps — which means I'm not describing this work from the outside. Five years across measurement platforms, ad platforms, app stores and subscription analytics. Most people in this field pick a side, the plumbing or the media buying. In a portfolio you don't get that luxury, because you own the outcome, not the task.",
  },
  {
    file: 'faisal.jpg',
    initials: 'MF',
    name: 'Muhammad Faisal Khan',
    role: 'INFRASTRUCTURE & OPERATIONS',
    alt: 'Muhammad Faisal Khan',
    linkedin: 'https://www.linkedin.com/in/muhammad-faisal-khan-3606365/',
    glow: '--gx:0%;--gy:100%',
    bio: "Twenty years as a solution architect on carrier-grade mobile networks — packet core delivery across Cisco, Nokia and Ericsson. A lot of what breaks in app measurement isn't a setting in a dashboard. It's a server that has to receive a webhook, validate it, and forward it on without dropping anything. That's the half I own.",
  },
];
---

<section class="section" data-section="founders">
  <div class="wrap">
    <div class="shead" data-reveal="1">
      <p class="shead__label">{eyebrow}</p>
      <h2 class="shead__title">Nothing gets handed off.</h2>
      {aside && <p class="shead__aside">{aside}</p>}
    </div>

    <div class="sbody founders__grid">
      {
        founders.map((f, i) => (
          <div class="gcard founders__card" style={f.glow} data-reveal="1">
            <div class="founders__id">
              <div class:list={['founders__slot', { 'founders__slot--fill': i === 0 }]}>
                {hasPhoto(f.file) ? (
                  <img
                    src={`${base}/img/${f.file}`}
                    alt={f.alt}
                    width="128"
                    height="128"
                    loading="lazy"
                    decoding="async"
                    class="founders__photo"
                  />
                ) : (
                  <span aria-hidden="true">{f.initials}</span>
                )}
              </div>
              <div class="founders__who">
                <h3 class="founders__name">{f.name}</h3>
                <div class="founders__role">{f.role}</div>
              </div>
            </div>

            <p class="founders__bio" data-added="bento">{f.bio}</p>

            <a href={f.linkedin} target="_blank" rel="noopener" class="pill-link founders__linkedin">
              Meet on LinkedIn
              <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
        ))
      }
    </div>

    {
      pull && (
        <p data-reveal="1" class="pull founders__pull">
          Nothing gets handed off. You talk to the two people doing the work.
        </p>
      )
    }
  </div>
</section>

<style>
  .founders__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  @media (min-width: 860px) {
    .founders__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .founders__card {
    padding: clamp(22px, 3vw, 44px);
  }

  .founders__id {
    display: flex;
    align-items: center;
    gap: var(--s6);
    min-width: 0;
  }

  /* The initials avatar. The first card's is filled; amber as a fill carries
     ink, amber as text is the text token. */
  .founders__slot {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-accent-dim);
    box-shadow: inset 0 0 0 1.5px rgba(var(--rgb-accent), 0.65);
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.01em;
    color: var(--color-accent-text);
  }

  .founders__slot--fill {
    background: var(--color-accent);
    box-shadow: none;
    color: var(--color-ink);
  }

  .founders__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founders__who {
    min-width: 0;
  }

  .founders__name {
    font-size: clamp(21px, 2.1vw, 28px);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-h3);
    line-height: 1.16;
  }

  .founders__role {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-label);
    line-height: var(--lh-snug);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .founders__bio {
    flex: 1;
    margin-top: var(--s8);
    font-size: var(--t-body);
    line-height: var(--lh-answer);
    color: var(--color-text-2);
  }

  .founders__linkedin {
    align-self: flex-start;
    margin-top: var(--s8);
  }

  .founders__linkedin :global(svg) {
    flex: none;
    color: var(--color-accent-text);
  }

  .founders__pull {
    max-width: 34ch;
    text-align: left;
  }

  @media (max-width: 520px) {
    .founders__slot {
      width: 56px;
      height: 56px;
      font-size: 19px;
    }

    .founders__id {
      gap: 14px;
    }
  }
</style>
