---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import Problems from '../components/Problems.astro';
import Loop from '../components/Loop.astro';
import Stack from '../components/Stack.astro';
import Proof from '../components/Proof.astro';
import Products from '../components/Products.astro';
import Founders from '../components/Founders.astro';
import Faq from '../components/Faq.astro';
import CTA from '../components/CTA.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

const title = 'E2E Apps — Mobile growth and measurement for subscription apps';
const description =
  'Most apps judge a campaign on day-7 revenue and kill the ones that would have paid back on day 60. We fix the measurement, then run the spend on top of it.';
---

<Base title={title} description={description} path="/">
  <Schema slot="head" />
  <div class="page">
    <Nav />
    <Hero />
    <Calculator />
    <Problems />
    <Loop />
    <Stack />
    <Proof />
    <Products />
    <Founders />
    <Faq />
    <CTA />
    <Contact />
    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--c-paper);
    overflow-x: hidden;
  }
</style>
