---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

/**
 * Blog index.
 *
 * Styled with the current tokens so the articles are readable and reviewable
 * on the preview now. The Bento restyle lands with the rest of the sections —
 * the markup here is the shape the design calls for (date, title, kicker, tag,
 * arrow), so that pass is a stylesheet change rather than a rewrite.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const title = 'Blog — E2E Apps';
const description =
  'Findings from live mobile measurement stacks: SKAdNetwork, Mixpanel JQL, and the Python that turns onboarding data into conversion rates.';
---

<Base title={title} description={description} path="/blog">
  <div class="page">
    <Nav />

    <section class="section">
      <div class="wrap">
        <div class="eyebrow">FROM THE BLOG</div>
        <h1 class="blog__head">What we're finding in live stacks</h1>
        <p class="section-lead">
          Written while the work was happening, not afterwards. Every one of these started as a
          problem in somebody's stack.
        </p>

        <div class="blog__list">
          {
            posts.map((post) => (
              <a class="blog__row" href={`${base}/blog/${post.id}`}>
                <span class="blog__date">
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>
                    {fmt(post.data.date)}
                  </time>
                </span>
                <span class="blog__body">
                  <span class="blog__title">{post.data.title}</span>
                  <span class="blog__kicker">{post.data.kicker}</span>
                </span>
                <span class="blog__tag">{post.data.tag}</span>
                <span class="blog__arrow" aria-hidden="true">&#8594;</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--c-paper);
  }

  .section {
    padding-top: calc(var(--space-2xl) + 48px);
  }

  .blog__head {
    font-size: var(--fs-h2);
    color: var(--c-ink);
  }

  .blog__list {
    margin-top: var(--space-xl);
  }

  .blog__row {
    display: grid;
    grid-template-columns: minmax(0, 110px) minmax(0, 1fr) minmax(0, 190px) auto;
    gap: var(--space-md);
    align-items: baseline;
    padding: var(--space-md) 0;
    border-top: 1px solid var(--c-line);
    color: inherit;
    text-decoration: none;
    transition: background 0.16s ease;
  }

  .blog__row:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  .blog__row:hover {
    background: rgba(var(--rgb-ink), 0.03);
  }

  .blog__date {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    color: var(--c-ink-soft);
    white-space: nowrap;
  }

  .blog__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h-xs);
    line-height: var(--lh-pull);
    letter-spacing: var(--ls-slight);
    color: var(--c-ink);
  }

  .blog__kicker {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--fs-body-xs);
    line-height: var(--lh-snug);
    color: var(--c-ink-muted);
  }

  .blog__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-2xs);
    letter-spacing: var(--ls-eyebrow-sm);
    text-transform: uppercase;
    color: var(--c-amber);
  }

  .blog__arrow {
    font-family: var(--font-mono);
    color: var(--c-ink-soft);
  }

  @media (max-width: 767px) {
    .blog__row {
      grid-template-columns: 1fr auto;
      gap: var(--space-2xs) var(--space-sm);
    }

    .blog__body {
      grid-column: 1 / -1;
      order: 2;
    }

    .blog__tag {
      order: 1;
      text-align: right;
    }

    .blog__arrow {
      display: none;
    }
  }
</style>
