---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Proof from '../components/Proof.astro';
import Calculator from '../components/Calculator.astro';
import Automation from '../components/Automation.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Loop from '../components/Loop.astro';
import Founders from '../components/Founders.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

/**
 * The homepage.
 *
 * It used to run twelve sections, 4,269 words and nineteen minutes of reading,
 * which is roughly four times what a page like this converts at. The stack,
 * products and the FAQ now have their own pages and the blog index already had
 * one; between them that was 40% of the words and 29 of the 35 disclosures.
 * Nothing was deleted in the move.
 *
 * Revision 2 of the automation brief sets this order against the root site's
 * existing sequence, rather than the /next preview's:
 *
 *   Hero        the claim, and one action
 *   Problems    where the money goes missing, compressed
 *   Calculator  prove it with your own numbers
 *   Proof       three findings from real audits
 *   CaseStudy   one of them shown all the way down
 *   Automation  ongoing reporting, once the problem and the evidence have landed
 *   Loop        the wider engagement
 *   Founders    who you would actually be talking to
 *   Contact     the one action, again
 *
 * Automation sits after the case study on purpose: a visitor meets the business
 * problem and the evidence first, and only then the service that keeps watching.
 * Leading with it would imply a platform in front of a consulting engagement.
 *
 * Proof stands on its own again rather than nesting inside the case study. It
 * was folded in during the previous pass, which cannot work -- CaseStudy is
 * marked data-added and the copy-parity check strips such blocks whole, taking
 * Proof's signed-off copy with it.
 */

const title = 'E2E Apps — Mobile attribution and growth for subscription apps';
const description =
  'Your dashboard says the campaign is losing money. It broke even in month nine. We fix the attribution, close the gaps it was hiding, and spend against numbers you can defend.';
---

<Base title={title} description={description} path="/">
  <Schema slot="head" />
  <div class="page">
    <Nav />
    <main id="main">
      <Hero />
      <Problems compact />
      <Calculator />
      <Proof />
      <CaseStudy />
      <Automation />
      <Loop />
      <Founders />
      <Contact />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-bg);
    /* `clip`, not `hidden` — see global.css. `hidden` makes this a scroll
       container and the sticky nav sticks to it instead of the viewport. */
    overflow-x: clip;
  }
</style>
