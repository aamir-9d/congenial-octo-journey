---
import '../styles/global.css';
import '../styles/redesign.css';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Path relative to the site root, e.g. "/privacy". Used for the canonical URL. */
  path?: string;
  /** Suppress indexing — used by 404 and by the internal review pages. */
  noindex?: boolean;
  /** Open Graph type. Posts are "article". */
  ogType?: string;
}

const { title, description, path = '/', noindex = false, ogType = 'website' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}${p}`;

const canonical = new URL(`${base}${path === '/' ? '/' : path}`, Astro.site).href;
const ogImage = new URL(asset('/og-image.png'), Astro.site).href;

/* One list, two consumers: the preload links and the @font-face src below.
   Keeping them in step is what stops a preload from fetching a URL the CSS
   never asks for (which Chrome warns about and which wastes the round trip). */
const FONTS = {
  body400: asset('/fonts/be-vietnam-pro-400-latin.woff2'),
  body500: asset('/fonts/be-vietnam-pro-500-latin.woff2'),
  body600: asset('/fonts/be-vietnam-pro-600-latin.woff2'),
  body700: asset('/fonts/be-vietnam-pro-700-latin.woff2'),
  mono: asset('/fonts/ibm-plex-mono-400-latin.woff2'),
};

/* Google's `latin` subset range, verbatim — and identical to the range the
   cream build used, so the `→ ↗ ≠` system-font fallback is unchanged.

   Be Vietnam Pro has no variable version on Google Fonts, despite the brief
   asking for one. Four static weights instead, 85KB for the set — still less
   than the 135KB Archivo-variable plus Plex-Sans-variable pair it replaces. */
const LATIN =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The site has a dark and a light theme and follows the device. Declaring
        both lets the browser paint form controls and scrollbars to match. */}
    <meta name="color-scheme" content="dark light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="E2E Apps" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* SVG first for browsers that take it; the PNGs are the fallback, and
        Safari still wants apple-touch-icon by name. All generated from the one
        mark by scripts/build-icons.mjs. */}
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('/favicon-48.png')} sizes="48x48" type="image/png" />
    <link rel="icon" href={asset('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={asset('/favicon-16.png')} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={asset('/site.webmanifest')} />
    <meta name="theme-color" content="#0E1014" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#E9EDF4" media="(prefers-color-scheme: light)" />

    {/* 500 carries the h1 since the November 2026 redesign, which is the LCP element; 400 carries the lead
        paragraph beneath it. The other two weights and the mono face load with
        the stylesheet rather than spending preload slots against the LCP. */}
    <link rel="preload" href={FONTS.body500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={FONTS.body400} as="font" type="font/woff2" crossorigin />

    <style is:inline set:html={`
@font-face {
  font-family: 'Be Vietnam Pro';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${FONTS.body400}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Be Vietnam Pro';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url('${FONTS.body500}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Be Vietnam Pro';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url('${FONTS.body600}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Be Vietnam Pro';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('${FONTS.body700}') format('woff2');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'IBM Plex Mono';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${FONTS.mono}') format('woff2');
  unicode-range: ${LATIN};
}
`} />

    {/* Set before first paint so the reveal transition never flashes content
        visible and then hides it. With JS off the class is absent and every
        [data-reveal] block stays visible. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/* Consent defaults, then the container. Must come before any tag. */}
    <Analytics />

    {/* Cloudflare Web Analytics: a cookieless page-view count for every visitor,
        including those who never press Got it, which GA4 cannot see. No cookie,
        no personal data, no consent needed; the token is public by design.
        Described on /privacy.

        Loaded the way Tag Manager is: after the load event, at idle, so its
        script time never lands inside the page's own loading (it failed the
        Lighthouse check on the pull request as a plain deferred tag). And only
        on the live host: anywhere else the beacon's request is refused, which
        logs a console error and would count visits that are not real. */}
    <script is:inline>
      (function () {
        if (!/(^|\.)e2eapp\.com$/.test(location.hostname)) return;
        function loadBeacon() {
          var s = document.createElement('script');
          s.defer = true;
          s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          s.setAttribute('data-cf-beacon', '{"token": "866b6ecdda9145e5aeb86e6df7825267"}');
          document.head.appendChild(s);
        }
        function schedule() {
          'requestIdleCallback' in window
            ? requestIdleCallback(loadBeacon, { timeout: 4000 })
            : setTimeout(loadBeacon, 1500);
        }
        document.readyState === 'complete' ? schedule() : window.addEventListener('load', schedule);
      })();
    </script>

    <slot name="head" />
  </head>

  <body>
    {/* First thing in the tab order on every route. A landmark is only half the
        fix: it lets assistive technology jump to the content, but a sighted
        keyboard user still has to tab through the whole nav on every page. The
        link is invisible until it is focused, and then it has to be visible —
        a skip link that stays hidden while focused is the classic broken one. */}
    <a href="#main" class="skip-link">Skip to content</a>

    <slot />
    <ConsentBanner />

    <script>
      import { captureAttribution } from '../scripts/attribution';
      import { initConsent } from '../scripts/consent';
      import { initEngagement } from '../scripts/engagement';
      import { initDisclose } from '../scripts/disclose';
      import { initProducts } from '../scripts/products';
      import { initSwipe } from '../scripts/swipe';

      // Capture click IDs first: everything downstream reads the cookie it writes.
      captureAttribution();
      initConsent();
      initDisclose();
      initProducts();
      initEngagement();
      initSwipe();
    </script>
  </body>
</html>
