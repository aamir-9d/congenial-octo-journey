---
import Icon from './Icon.astro';
import { TEASER, SOURCES, ASSISTANTS } from '../data/automation.ts';

/**
 * The homepage automation section.
 *
 * Deliberately not the investigation interface. The brief's instruction was one
 * heading, one short paragraph, a small visual and two actions, in 80-110
 * visible words — the demonstration belongs on /automation, and duplicating it
 * here would put the same 900px panel on two pages.
 *
 * The small visual is the offer itself: four equal source tiles feeding one
 * reporting line, with three equal assistant labels under it. That is legible
 * before the paragraph is read, which is the job this section has.
 *
 * Copy lives in src/data/automation.ts beside the page's, so the summary and
 * the thing it summarises cannot drift into disagreeing about the service.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="automation" class="section" data-section="automation" data-added="audit">
  <div class="wrap">
    <div class="section-head" data-reveal="1">
      <div class="eyebrow eyebrow--amber">{TEASER.eyebrow}</div>
      <h2 class="auto__h2">{TEASER.heading}</h2>
      <p class="section-lead">{TEASER.body}</p>
    </div>

    <div class="auto__figure" data-reveal="1">
      <ul class="auto__tiles" aria-label="Connected reporting sources">
        {
          SOURCES.map((s) => (
            <li class="auto__tile">
              <span class="auto__tile-name">{s.name}</span>
              <span class="auto__tile-note">{s.note}</span>
            </li>
          ))
        }
      </ul>

      <div class="auto__bridge">
        <span class="auto__rule" aria-hidden="true"></span>
        <span class="auto__bridge-label">Connected reporting</span>
        <span class="auto__rule" aria-hidden="true"></span>
      </div>

      <ul class="auto__asst" aria-label="Assistant options">
        {
          ASSISTANTS.map((a) => (
            <li class="auto__asst-name">{a.name}</li>
          ))
        }
      </ul>
    </div>

    <div class="auto__actions">
      <a href={`${base}/automation`} class="btn-primary">
        {TEASER.primary}
        <Icon name="arrow-right" size={15} />
      </a>
      <a href={`${base}/#contact`} class="btn-secondary">{TEASER.secondary}</a>
    </div>

    <p class="auto__note">{TEASER.note}</p>
  </div>
</section>

<style>
  .auto__h2 {
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--color-text);
  }

  .auto__figure {
    max-width: var(--wrap-loop);
    margin: clamp(40px, 4vw, 64px) auto 0;
  }

  /* Four equal tiles, 2x2 on a phone. Equal is the message. */
  .auto__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 720px) {
    .auto__tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .auto__tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
    justify-content: center;
    min-height: 62px;
    padding: var(--s4) var(--s3);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--ring);
    text-align: center;
    min-width: 0;
  }

  .auto__tile-name {
    font-size: var(--t-card);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .auto__tile-note {
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-meta);
    color: var(--color-text-4);
  }

  .auto__bridge {
    display: flex;
    align-items: center;
    gap: var(--s4);
    margin: var(--s6) 0;
  }

  .auto__rule {
    flex: 1;
    height: 1px;
    background: var(--color-line-strong);
  }

  .auto__bridge-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .auto__asst {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .auto__asst-name {
    text-align: center;
    font-size: var(--t-card);
    font-weight: var(--fw-medium);
    color: var(--color-text-2);
    min-width: 0;
  }

  .auto__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s4);
    margin-top: clamp(32px, 3.5vw, 52px);
  }

  .auto__note {
    margin-top: var(--s8);
    text-align: center;
    font-size: var(--t-card-sm);
    line-height: var(--lh-card);
    color: var(--color-text-4);
  }
</style>
